// Project `workorders`: non-sensitive project variables (platform-design §7.2).
// Syntax: https://github.com/OctopusDeploy/github-agent-plugin/blob/main/skills/writing-ocl/references/variables.md
//
// Not in Git (config-as-code keeps sensitive variables in the Octopus database, E26):
// - GitHub.StatusAppPrivateKey (Sensitive): private key of the statuses-only GitHub App (ADR-IR27, R16).
// Supplied by library variable set `WorkOrders Environment` (octopus/terraform, from terraform.tfvars):
//   App.BaseUrl, App.InternalUrl, Azure.ResourceGroup, KeyVault.Name, Sql.ServerName, Sql.ServerFqdn,
//   Sql.Database, Sql.MigratorUser, Sql.AcceptanceUser (tdd), AI.OpenAIUrl, AI.OpenAIModel.
// Account and pool values are slugs that octopus/terraform creates (accounts.tf, worker-pools.tf).

// Per-environment Kubernetes worker pool (ADR-C2, TB11): one pool per environment, one cluster namespace each.
variable "WorkerPool" {
    type = "WorkerPool"

    value "k8s-tdd" {
        environment = ["tdd"]
    }
    value "k8s-uat" {
        environment = ["uat"]
    }
    value "k8s-prod" {
        environment = ["prod"]
    }
}

// Per-environment Azure OIDC account (§5.2, TB12). The stored `Azure Runtime Provisioner` is never used here (ADR-C10).
variable "Azure.DeployAccount" {
    type = "AzureAccount"

    value "azure-oidc-deploy-tdd" {
        environment = ["tdd"]
    }
    value "azure-oidc-deploy-uat" {
        environment = ["uat"]
    }
    value "azure-oidc-deploy-prod" {
        environment = ["prod"]
    }
}

// Signed CI toolchain image (§7.5): SDK 10, pwsh, Playwright 1.54 browsers, go-sqlcmd, az CLI.
// Pinned by digest (ADR-IR19); the same string as in workorders-infrastructure and the Codefresh pipelines (ADR-IR11).
variable "StepImage.CiDotnet" {
    value "<acr-name>.azurecr.io/platform/ci-dotnet:<ci-image-version>@sha256:<ci-image-digest>" {}
}

// Degraded fails only in TDD until #9016 closes (the LlmGateway check degrades uat and prod).
variable "Smoke.FailOnDegraded" {
    value "True" {
        environment = ["tdd"]
    }
    value "False" {
        environment = ["uat", "prod"]
    }
}

// Seconds. The step default for Argo CD verification is 180 s (E4); cold rollouts need longer.
variable "Argo.VerificationTimeoutSeconds" {
    value "900" {}
}

// Seconds. Enforced inside migrate-database with coreutils timeout.
variable "Migration.TimeoutSeconds" {
    value "900" {}
}

// ADR-C11 interlock 2: defined for tdd only, so every other scope resolves to nothing.
variable "Acceptance.AllowDestructiveReset" {
    value "True" {
        environment = ["tdd"]
    }
}

// ADR-IR32: the existing Space Manager user whose API key Codefresh (context workorders-octopus) and the Argo CD
// gateway share. sod-guard refuses prod deployments created or approved with it.
variable "Platform.AutomationUsername" {
    value "AISF-Service-Account" {}
}

// report-commit-status (step 12). Stays False until the statuses-only GitHub App exists (R16, ADR-IR27).
variable "GitHub.StatusEnabled" {
    value "False" {}
}

variable "GitHub.StatusContext" {
    value "platform/tdd" {}
}

// The application repository (directive F). The legacy origin ClearMeasureLabs/bootcamp-palermo-workorders never
// receives statuses from this space.
variable "GitHub.AppRepository" {
    value "clearmeasure-aisf-sample-apps/20260923-001" {}
}

// Statuses-only GitHub App (ADR-IR27): permission `Commit statuses: write`, installed on the application repository
// only. Its private key is the sensitive variable GitHub.StatusAppPrivateKey.
variable "GitHub.StatusAppId" {
    value "<github-status-app-id>" {}
}

variable "GitHub.StatusAppInstallationId" {
    value "<github-status-app-installation-id>" {}
}

// Prompted input of runbook db-restore-pitr (§7.2): UTC ISO 8601, for example 2026-09-24T13:45:00Z.
// The runbook validates the format and rejects an empty or future value.
variable "RestorePointInTime" {
    value "" {
        process = ["db-restore-pitr"]

        prompt {
            label = "Restore point in time (UTC)"
            description = "UTC ISO 8601 timestamp inside the point-in-time retention window, for example 2026-09-24T13:45:00Z."
            required = true
        }
    }
}
