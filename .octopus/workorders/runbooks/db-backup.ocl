// Runbook `db-backup` of project `workorders` (platform-design §7.2). Environments: uat, prod.
//
// File layout: one combined file per runbook (metadata plus process) under runbooks/, basename = slug.
// Confirmed by https://octopus.com/docs/runbooks/config-as-code-runbooks and
// https://github.com/OctopusDeploy/github-agent-plugin/blob/main/skills/writing-ocl/references/runbooks.md
// Runbook-level environment scope (the API's EnvironmentScope) has no documented OCL attribute [VERIFY in an
// export]; scope is enforced by the action-level environments list below.
//
// Identity: azure-oidc-deploy-<env> through Azure.DeployAccount. id-octopus-deploy-uat and id-octopus-deploy-prod
// hold SQL DB Contributor on rg-workorders-<env> (§5.2, ADR-IR13; terraform/foundation
// deploy_identity_sql_db_contributor_envs).
// Prod runs must come from refs/heads/main: runbook producers can run any branch, and the script is inline.

name = "db-backup"
description = "Copies the environment database to <database>-bak-<UTC timestamp>, tagged expires-on = now + 14 days."
default_guided_failure_mode = "EnvironmentDefault"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    // Sleep/wake (ADR-IR33): this app-owned project holds no platform secret (multi-app directive §10), and runbooks
    // cannot run the Deploy a Release step that wakes the cluster for deployments [VERIFY]. So the first step waits,
    // keylessly, until the cluster answers and says how to wake it: deploy platform-wake to this environment, or run
    // env-wake (SRE On-call). If Deploy a Release works in runbooks, it replaces this step.
    step "wake-environment" {
        name = "Wait for the cluster to wake"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["uat", "prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu
                    # Sleep/wake (ADR-IR33): this app-owned project holds no key and no Azure right, so this step cannot wake the
                    # cluster. It waits until the environment's ingress answers (any HTTP status means the cluster runs).
                    environment="#{Octopus.Environment.Name}"
                    base_url="#{App.BaseUrl}"
                    case "$environment" in
                        tdd|uat) infra="infra-nonprod" ;;
                        prod) infra="infra-prod" ;;
                        *) fail_step "No cluster mapping for environment $environment." ;;
                    esac
                    deadline=$(( $(date +%s) + 1800 ))
                    warned="false"
                    until curl --silent --output /dev/null --max-time 10 "$base_url/_healthcheck"; do
                        if [ "$warned" = "false" ]; then
                            write_warning "The cluster of $environment does not answer at $base_url (asleep?). Wake it: deploy the latest platform-wake release to $environment, or run runbook env-wake of workorders-infrastructure in $infra (SRE On-call). Waiting up to 30 minutes."
                            warned="true"
                        fi
                        [ "$(date +%s)" -lt "$deadline" ] || fail_step "The cluster of $environment did not answer at $base_url within 30 minutes; wake it and run this runbook again."
                        sleep 30
                    done
                    echo "The cluster of $environment answers at $base_url."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "copy-database" {
        name = "Copy database"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool_variable = "WorkerPool"
            environments = ["uat", "prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.DeployAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu
                    if [ "#{Octopus.Environment.Name}" = "prod" ] && [ "#{Octopus.RunbookRun.Git.Ref}" != "refs/heads/main" ]; then
                        fail_step "Prod runs only from refs/heads/main (this run: '#{Octopus.RunbookRun.Git.Ref}')."
                    fi
                    rg="#{Azure.ResourceGroup}"
                    server="#{Sql.ServerName}"
                    source_db="#{Sql.Database}"
                    copy_name="$source_db-bak-$(date -u +%Y%m%d%H%M)"
                    expires_on="$(date -u -d '+14 days' +%Y-%m-%d)"
                    echo "Copying $source_db to $copy_name on $server"
                    az sql db copy --resource-group "$rg" --server "$server" --name "$source_db" --dest-name "$copy_name" --output none
                    # az sql db copy has no tags argument; tag through the generic update [VERIFY hyphenated tag key with --set].
                    az sql db update --resource-group "$rg" --server "$server" --name "$copy_name" --set "tags.expires-on=$expires_on" --output none
                    set_octopusvariable "BackupDatabase" "$copy_name"
                    write_highlight "Backup copy $copy_name created on $server (tag expires-on=$expires_on)."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }
        }
    }
}
