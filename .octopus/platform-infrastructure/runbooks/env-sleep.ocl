name = "env-sleep"
description = "Hourly: stops the cluster of this environment when idle or outside the working window, unless a task is queued or executing."
default_guided_failure_mode = "Off"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Count"
    quantity_to_keep = 72
}

process {
    step "heal-alert-rule" {
        name = "Heal alert rule"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $class = [string] $OctopusParameters['Environment.Class']
                    if ($class -cne 'nonprod' -and $class -cne 'prod') {
                        Fail-Step "Environment.Class '$class' must be nonprod or prod."
                    }
                    $cluster = "aks-platform-$class"
                    $rg = "rg-platform-$class-aks"
                    $rule = "apr-sleep-$class"
                    # Power state and provisioning state of the cluster, for example Running and Succeeded; $null when it cannot be read.
                    function Get-AksState {
                        $PSNativeCommandUseErrorActionPreference = $false
                        $lines = az aks show --resource-group $rg --name $cluster --query '[powerState.code, provisioningState]' --output tsv
                        if ($LASTEXITCODE -ne 0) {
                            return $null
                        }
                        $fields = @((@($lines) -join ' ').Trim() -split '\s+', 2)
                        return [pscustomobject] @{ Power = $fields[0]; Provisioning = $(if ($fields.Count -gt 1) { $fields[1] } else { '' }) }
                    }
                    # Heal (ADR-IR33): env-sleep enables alert processing rule apr-sleep-<tier> just before 'az aks stop --no-wait'. A stop
                    # that Azure accepts and that then fails, or a wake that never finished, leaves the rule enabled on a running cluster,
                    # and its alerts notify nobody. At the start of every env-sleep and env-wake run: enabled, Running and not Stopping means
                    # disable it and say so.
                    function Repair-AlertRule {
                        $PSNativeCommandUseErrorActionPreference = $false
                        $read = @(az monitor alert-processing-rule show --resource-group $rg --name $rule --query properties.enabled --output tsv --only-show-errors 2>&1)
                        $shown = $LASTEXITCODE -eq 0
                        $readError = (@($read | Where-Object { $_ -is [System.Management.Automation.ErrorRecord] }) | ForEach-Object { "$_" }) -join "`n"
                        if (-not $shown) {
                            if ($readError -cmatch 'ResourceNotFound|ResourceGroupNotFound|was not found|could not be found') {
                                Write-Host "Alert processing rule $rule was not found in $rg; nothing to heal."
                            }
                            else {
                                Write-Warning "Cannot read alert processing rule $rule in $($rg): $readError. Not healed; the next run checks again."
                            }
                            return
                        }
                        $enabled = (@($read | Where-Object { $_ -isnot [System.Management.Automation.ErrorRecord] }) -join '').Trim()
                        if ($enabled -ieq 'false') {
                            Write-Host "Alert processing rule $rule is disabled; nothing to heal."
                            return
                        }
                        if ($enabled -ine 'true') {
                            Write-Warning "Alert processing rule $rule reports enabled '$enabled', neither true nor false. Not healed; the next run checks again."
                            return
                        }
                        $state = Get-AksState
                        if ($null -eq $state) {
                            Write-Warning "Alert processing rule $rule is enabled, and cluster $cluster was not found in $rg (or cannot be read). Not healed."
                            return
                        }
                        if ($state.Power -cne 'Running' -or $state.Provisioning -ceq 'Stopping') {
                            Write-Host "Alert processing rule $rule is enabled while $cluster is $($state.Power)/$($state.Provisioning): consistent."
                            return
                        }
                        az monitor alert-processing-rule update --resource-group $rg --name $rule --enabled false --output none --only-show-errors
                        if ($LASTEXITCODE -ne 0) {
                            Fail-Step "Alert processing rule $rule is enabled while $cluster is $($state.Power)/$($state.Provisioning), and disabling it failed (see above): its alerts stay muted. Disable it by hand (docs/runbooks/sleep-and-wake.md)."
                        }
                        Write-Warning "Healed: alert processing rule $rule was enabled while $cluster is $($state.Power)/$($state.Provisioning) (a stop that Azure accepted and that then failed, or a wake that did not finish); disabled it, alerts notify again."
                    }
                    Repair-AlertRule
                    exit 0
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "decide-sleep" {
        name = "Decide sleep"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $infraEnvironment = [string] $OctopusParameters['Octopus.Environment.Name']
                    $dryRun = ([string] $OctopusParameters['Sleep.DryRun']).ToLowerInvariant()
                    if ($dryRun -cne 'true') {
                        $dryRun = 'false'
                    }
                    Set-OctopusVariable -name 'Sleep.DryRun' -value $dryRun
                    # Every decision is logged in one parsable line (conformance tests read it from the task log, CAP-OCT-009).
                    function Complete-Decision([string] $Decision, [string] $Reason) {
                        Set-OctopusVariable -name 'Sleep.Decision' -value $Decision
                        Set-OctopusVariable -name 'Sleep.Reason' -value $Reason
                        Write-Highlight "Sleep.Decision=$Decision Sleep.DryRun=$dryRun Environment=$infraEnvironment Reason=$Reason"
                        exit 0
                    }
                    # Seconds since 1970 of a date and time; a string without an offset is UTC. $null when it is not a date and time.
                    function ConvertTo-UnixTime($Value) {
                        if ($Value -is [DateTime]) {
                            if ($Value.Kind -eq [DateTimeKind]::Unspecified) {
                                $Value = [DateTime]::SpecifyKind($Value, [DateTimeKind]::Utc)
                            }
                            return ([DateTimeOffset] $Value).ToUnixTimeSeconds()
                        }
                        $parsed = [DateTimeOffset]::MinValue
                        $styles = [System.Globalization.DateTimeStyles]::AssumeUniversal -bor [System.Globalization.DateTimeStyles]::AllowWhiteSpaces
                        if ([DateTimeOffset]::TryParse([string] $Value, [System.Globalization.CultureInfo]::InvariantCulture, $styles, [ref] $parsed)) {
                            return $parsed.ToUnixTimeSeconds()
                        }
                        return $null
                    }
                    $enabled = ([string] $OctopusParameters['Sleep.Enabled']).ToLowerInvariant()
                    $force = ([string] $OctopusParameters['Sleep.Force']).ToLowerInvariant()
                    # Sleep.NowOverride simulates the clock of the working-window and idle rules; honoured only in a dry run.
                    $now = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
                    $nowOverride = [string] $OctopusParameters['Sleep.NowOverride']
                    if ($nowOverride) {
                        if ($dryRun -ceq 'true') {
                            $simulated = ConvertTo-UnixTime $nowOverride
                            if ($null -eq $simulated) {
                                Fail-Step "Sleep.NowOverride '$nowOverride' is not a date and time (use ISO 8601, for example 2026-09-24T23:30:00-05:00)."
                            }
                            $now = $simulated
                            Write-Warning "Dry run with the simulated time $nowOverride."
                        }
                        else {
                            Write-Warning 'Sleep.NowOverride is ignored: it applies only when Sleep.DryRun is true.'
                        }
                    }
                    if ($enabled -cne 'true') {
                        if ($force -ceq 'true') {
                            Write-Warning "Sleep.Force is ignored: Sleep.Enabled is '$enabled' in $infraEnvironment."
                        }
                        Complete-Decision 'stay' "Sleep.Enabled is '$enabled'"
                    }
                    $octopusUrl = ([string] $OctopusParameters['Octopus.Web.ServerUri']).TrimEnd('/')
                    $spaceId = [string] $OctopusParameters['Octopus.Space.Id']
                    $apiKey = [string] $OctopusParameters['Platform.OctopusApiKey']
                    if (-not $apiKey) {
                        Fail-Step 'Platform.OctopusApiKey is empty in this step: octopus/terraform scopes it to the REST-calling steps of platform-infrastructure (S5).'
                    }
                    if (-not (Get-Command -Name curl -CommandType Application -ErrorAction SilentlyContinue)) {
                        Fail-Step 'curl is missing from the step container.'
                    }
                    # Octopus REST call; returns the response body, or $null when the call fails. The key reaches curl through its
                    # configuration on standard input, never through the process arguments.
                    function Invoke-OctopusApi {
                        param(
                            [Parameter(Mandatory)] [string] $Method,
                            [Parameter(Mandatory)] [string] $Path,
                            [string] $Body
                        )
                        $arguments = @('--config', '-', '--fail', '--silent', '--show-error', '--max-time', '60', '--request', $Method, '--header', 'Accept: application/json')
                        if ($PSBoundParameters.ContainsKey('Body')) {
                            $arguments += @('--header', 'Content-Type: application/json', '--data', $Body)
                        }
                        $arguments += "$octopusUrl$Path"
                        $PSNativeCommandUseErrorActionPreference = $false
                        $response = "header = `"X-Octopus-ApiKey: $apiKey`"" | curl @arguments
                        if ($LASTEXITCODE -ne 0) {
                            return $null
                        }
                        return (@($response) -join "`n")
                    }
                    # The id of the only item of that name in a collection of this space; fails the step otherwise.
                    function Get-OctopusItemId([string] $Collection, [string] $Name) {
                        $listing = Invoke-OctopusApi -Method GET -Path "/api/$spaceId/$($Collection)?partialName=$Name&take=100"
                        if ($null -eq $listing) {
                            Fail-Step "Octopus REST call for $Collection '$Name' failed; check Platform.OctopusApiKey."
                        }
                        $id = ''
                        try {
                            $named = @(@((ConvertFrom-Json -InputObject $listing -AsHashtable)['Items']) | Where-Object { $_ -is [System.Collections.IDictionary] -and $_['Name'] -is [string] -and $_['Name'] -ceq $Name })
                            if ($named.Count -eq 1 -and $null -ne $named[0]['Id']) {
                                $id = [string] $named[0]['Id']
                            }
                        }
                        catch {
                            $id = ''
                        }
                        if (-not $id) {
                            Fail-Step "No single item named '$Name' in $Collection of space $spaceId."
                        }
                        return $id
                    }
                    $class = [string] $OctopusParameters['Environment.Class']
                    if ($class -ceq 'nonprod') {
                        $appEnvironments = @('tdd', 'uat')
                    }
                    elseif ($class -ceq 'prod') {
                        $appEnvironments = @('prod')
                    }
                    else {
                        Fail-Step "Environment.Class '$class' must be nonprod or prod."
                    }
                    $selfTask = [string] $OctopusParameters['Octopus.Task.Id']
                    $environmentIds = @(foreach ($environment in @($appEnvironments) + $infraEnvironment) {
                            Get-OctopusItemId -Collection 'environments' -Name $environment
                        })
                    # A task field as the task list shows it: '-' when empty.
                    function Format-TaskField($Value) {
                        if ($null -eq $Value -or ($Value -is [string] -and $Value.Length -eq 0)) {
                            return '-'
                        }
                        if ($Value -is [bool]) {
                            return $Value.ToString().ToLowerInvariant()
                        }
                        return [string] $Value
                    }
                    # A task time as the task list reads it: $null when empty or '-', else the value.
                    function Get-TaskTime($Value) {
                        if ($null -eq $Value -or ($Value -is [string] -and ($Value.Length -eq 0 -or $Value -ceq '-'))) {
                            return $null
                        }
                        return $Value
                    }
                    # The tasks of one environment in the given states, newest first: id, state, queue time, completed time and description
                    # [VERIFY task list filters environment and states]. $null when the list cannot be read.
                    function Get-TaskList([string] $EnvironmentId, [string] $States, [int] $Take) {
                        $json = Invoke-OctopusApi -Method GET -Path "/api/$spaceId/tasks?environment=$EnvironmentId&states=$States&take=$Take"
                        if ($null -eq $json) {
                            return $null
                        }
                        try {
                            $items = (ConvertFrom-Json -InputObject $json -AsHashtable)['Items']
                        }
                        catch {
                            return $null
                        }
                        if ($items -isnot [System.Collections.IList]) {
                            return $null
                        }
                        $tasks = [System.Collections.Generic.List[object]]::new()
                        foreach ($item in $items) {
                            if ($item -isnot [System.Collections.IDictionary]) {
                                return $null
                            }
                            $tasks.Add([pscustomobject] @{
                                    Id            = Format-TaskField $item['Id']
                                    State         = Format-TaskField $item['State']
                                    QueueTime     = Get-TaskTime $item['QueueTime']
                                    CompletedTime = Get-TaskTime $item['CompletedTime']
                                    Description   = Format-TaskField $item['Description']
                                })
                        }
                        return , $tasks.ToArray()
                    }
                    # The first queued or executing deployment or runbook run other than this run, or ''. A task queued to start more than
                    # 15 minutes from now (a scheduled deployment) does not count. Tasks of every project count, so idle is measured across
                    # all apps of the cluster.
                    function Get-BusyTask {
                        $nowBusy = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
                        foreach ($environmentId in $environmentIds) {
                            $tasks = Get-TaskList -EnvironmentId $environmentId -States 'Queued,Executing,Cancelling' -Take 100
                            if ($null -eq $tasks) {
                                Fail-Step 'Cannot read the Octopus task list; nothing is stopped.'
                            }
                            foreach ($task in $tasks) {
                                if ($task.Id -ceq $selfTask) {
                                    continue
                                }
                                if ($task.State -ceq 'Queued' -and $null -ne $task.QueueTime) {
                                    $queuedAt = ConvertTo-UnixTime $task.QueueTime
                                    if ($null -eq $queuedAt) {
                                        $queuedAt = $nowBusy
                                    }
                                    if ($queuedAt -gt $nowBusy + 900) {
                                        continue
                                    }
                                }
                                return "$($task.Id) ($($task.State): $($task.Description))"
                            }
                        }
                        return ''
                    }
                    # The sleep hold on a resource group: the values of its tags platform-sleep-hold-until and platform-sleep-hold-by ('' when
                    # unset). A group that does not exist holds nothing; any other read error fails the step, and nothing is stopped.
                    function Get-SleepHold([string] $Group) {
                        $PSNativeCommandUseErrorActionPreference = $false
                        $read = @(az group show --name $Group --query tags --output json --only-show-errors 2>&1)
                        $shown = $LASTEXITCODE -eq 0
                        $readError = (@($read | Where-Object { $_ -is [System.Management.Automation.ErrorRecord] }) | ForEach-Object { "$_" }) -join "`n"
                        $hold = [pscustomobject] @{ Until = ''; By = 'an unnamed holder' }
                        if (-not $shown) {
                            if ($readError -cmatch 'ResourceGroupNotFound|could not be found|was not found') {
                                Write-Host "Resource group $Group was not found; no sleep hold applies."
                                return $hold
                            }
                            Fail-Step "Cannot read the sleep hold on resource group $($Group): $readError; nothing is stopped."
                        }
                        $text = (@($read | Where-Object { $_ -isnot [System.Management.Automation.ErrorRecord] }) -join "`n").Trim()
                        # System.Text.Json, not ConvertFrom-Json, which turns ISO 8601 strings into local DateTime values. Tag names
                        # are case-insensitive in Azure, and so is this hashtable.
                        $tags = @{}
                        $parsed = $true
                        try {
                            $document = [System.Text.Json.JsonDocument]::Parse($(if ($text) { $text } else { 'null' }))
                            if ($document.RootElement.ValueKind -eq [System.Text.Json.JsonValueKind]::Object) {
                                foreach ($property in $document.RootElement.EnumerateObject()) {
                                    if ($property.Value.ValueKind -eq [System.Text.Json.JsonValueKind]::String) {
                                        $tags[$property.Name] = $property.Value.GetString()
                                    }
                                }
                            }
                        }
                        catch {
                            $parsed = $false
                        }
                        if (-not $parsed) {
                            Fail-Step "The tags of resource group $Group are not JSON; nothing is stopped."
                        }
                        if ($tags.ContainsKey('platform-sleep-hold-until')) {
                            $hold.Until = $tags['platform-sleep-hold-until'].Trim()
                        }
                        if ($tags.ContainsKey('platform-sleep-hold-by') -and $tags['platform-sleep-hold-by'].Trim()) {
                            $hold.By = $tags['platform-sleep-hold-by'].Trim()
                        }
                        return $hold
                    }
                    # 1. Never while a deployment or runbook run is queued or executing (this run excluded). Sleep.Force never overrides it.
                    $busy = Get-BusyTask
                    if ($busy) {
                        Complete-Decision 'stay' "busy: $busy"
                    }
                    # 2. Sleep.Force, prompted when run by hand (default false), skips the sleep hold, working-window and idle checks.
                    if ($force -ceq 'true') {
                        # [VERIFY that runbook runs populate Octopus.Deployment.CreatedBy.*]
                        $forcedBy = [string] $OctopusParameters['Octopus.Deployment.CreatedBy.Username']
                        if (-not $forcedBy) {
                            $forcedBy = [string] $OctopusParameters['Octopus.Deployment.CreatedBy.DisplayName']
                        }
                        if (-not $forcedBy) {
                            $forcedBy = 'an unidentified user'
                        }
                        Write-Warning "Sleep.Force set by $($forcedBy): working-window and idle checks skipped."
                        Complete-Decision 'sleep' "forced by $forcedBy"
                    }
                    # 3. A sleep hold (runbook sleep-hold; conformance-arm sets one for a run): tags platform-sleep-hold-until (an ISO 8601
                    #    instant) and platform-sleep-hold-by on resource group rg-platform-<tier>-aks keep the cluster up until that instant.
                    #    Sleep.Force (rule 2) ignores it. A value that is not an ISO 8601 date and time, or that lies more than 12 hours
                    #    (and 5 minutes of clock skew) ahead, is ignored with a warning, so a bad value never holds a cluster for days.
                    $holdGroup = "rg-platform-$class-aks"
                    $hold = Get-SleepHold -Group $holdGroup
                    if ($hold.Until) {
                        $holdAt = $null
                        if ($hold.Until -cmatch '\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})\z') {
                            $holdAt = ConvertTo-UnixTime $hold.Until
                        }
                        if ($null -eq $holdAt) {
                            Write-Warning "Sleep hold '$($hold.Until)' by $($hold.By) on $holdGroup is not an ISO 8601 date and time; ignored."
                        }
                        elseif ($holdAt -gt $now + 43500) {
                            Write-Warning "Sleep hold until $($hold.Until) by $($hold.By) on $holdGroup is more than 12 hours ahead (the longest hold); ignored."
                        }
                        elseif ($holdAt -gt $now) {
                            Complete-Decision 'stay' "held by $($hold.By) until $($hold.Until)"
                        }
                        else {
                            Write-Host "Sleep hold by $($hold.By) ended at $($hold.Until)."
                        }
                    }
                    # 4. Outside the working window: Sleep.WorkDays, Sleep.WorkdayStart to Sleep.WorkdayEnd, in Sleep.TimeZone.
                    $timeZoneName = [string] $OctopusParameters['Sleep.TimeZone']
                    $workDays = ',' + ([string] $OctopusParameters['Sleep.WorkDays']).Replace(' ', '') + ','
                    $start = ([string] $OctopusParameters['Sleep.WorkdayStart']).Replace(':', '')
                    $end = ([string] $OctopusParameters['Sleep.WorkdayEnd']).Replace(':', '')
                    if ("$start$end" -cnotmatch '\A[0-2][0-9][0-5][0-9][0-2][0-9][0-5][0-9]\z') {
                        Fail-Step 'Sleep.WorkdayStart and Sleep.WorkdayEnd must look like 07:00 and 19:00.'
                    }
                    $zone = $null
                    if ($timeZoneName) {
                        try {
                            $zone = [System.TimeZoneInfo]::FindSystemTimeZoneById($timeZoneName)
                        }
                        catch {
                            $zone = $null
                        }
                    }
                    if ($null -ne $zone) {
                        $local = [System.TimeZoneInfo]::ConvertTime([DateTimeOffset]::FromUnixTimeSeconds($now), $zone)
                        $day = $local.ToString('ddd', [System.Globalization.CultureInfo]::InvariantCulture)
                        $clock = $local.ToString('HHmm', [System.Globalization.CultureInfo]::InvariantCulture)
                        $inWindow = $workDays.Contains(",$day,") -and [int] $clock -ge [int] $start -and [int] $clock -lt [int] $end
                        if (-not $inWindow) {
                            Complete-Decision 'sleep' "outside the working window: $day $clock $timeZoneName"
                        }
                    }
                    else {
                        # [VERIFY tzdata in the worker-tools image]
                        Write-Warning "Time zone $timeZoneName is not installed in the step container; only the idle rule applies."
                    }
                    # 5. Idle: the newest completed deployment or runbook run of any project in these environments, env-wake included.
                    #    env-sleep runs, dry runs included, do not count [VERIFY that task descriptions name the runbook].
                    $idleMinutes = [string] $OctopusParameters['Sleep.IdleMinutes']
                    if ($idleMinutes -cnotmatch '\A[0-9]+\z') {
                        Fail-Step "Sleep.IdleMinutes must be a whole number of minutes; got '$idleMinutes'."
                    }
                    $last = [long] 0
                    $lastWhat = 'none'
                    foreach ($environmentId in $environmentIds) {
                        $tasks = Get-TaskList -EnvironmentId $environmentId -States 'Success,Failed,Canceled,TimedOut' -Take 50
                        if ($null -eq $tasks) {
                            Fail-Step 'Cannot read the Octopus task list; nothing is stopped.'
                        }
                        foreach ($task in $tasks) {
                            if ($task.Description.ToLowerInvariant().Contains('env-sleep')) {
                                continue
                            }
                            if ($null -eq $task.CompletedTime) {
                                continue
                            }
                            $completedAt = ConvertTo-UnixTime $task.CompletedTime
                            if ($null -eq $completedAt) {
                                continue
                            }
                            if ($completedAt -gt $last -and $completedAt -le $now) {
                                $last = $completedAt
                                $lastWhat = "$($task.Id) ($($task.State): $($task.Description))"
                            }
                        }
                    }
                    if ($last -le 0) {
                        Complete-Decision 'sleep' 'idle: no completed task among the last 50 of each environment'
                    }
                    $idle = [long] [Math]::Floor(($now - $last) / 60)
                    if ($idle -ge [long] $idleMinutes) {
                        Complete-Decision 'sleep' "idle for $idle minutes, limit $idleMinutes; last: $lastWhat"
                    }
                    Complete-Decision 'stay' "active $idle minutes ago, limit $idleMinutes; last: $lastWhat"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "stop-cluster" {
        name = "Stop cluster"
        condition = "Variable"
        properties = {
            Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Octopus.Action[Decide sleep].Output.Sleep.Decision == \"sleep\"}true#{/if}#{/unless}"
        }

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $decision = [string] $OctopusParameters['Octopus.Action[Decide sleep].Output.Sleep.Decision']
                    $reason = [string] $OctopusParameters['Octopus.Action[Decide sleep].Output.Sleep.Reason']
                    $dryRun = [string] $OctopusParameters['Octopus.Action[Decide sleep].Output.Sleep.DryRun']
                    if ($decision -cne 'sleep') {
                        Write-Host "Staying awake: $reason"
                        exit 0
                    }
                    if ($dryRun -ceq 'true') {
                        Write-Highlight "Dry run: the cluster would stop now ($reason); nothing is changed."
                        exit 0
                    }
                    $class = [string] $OctopusParameters['Environment.Class']
                    if ($class -cne 'nonprod' -and $class -cne 'prod') {
                        Fail-Step "Environment.Class '$class' must be nonprod or prod."
                    }
                    $cluster = "aks-platform-$class"
                    $rg = "rg-platform-$class-aks"
                    $rule = "apr-sleep-$class"
                    # Power state and provisioning state of the cluster, for example Running and Succeeded; $null when it cannot be read.
                    function Get-AksState {
                        $PSNativeCommandUseErrorActionPreference = $false
                        $lines = az aks show --resource-group $rg --name $cluster --query '[powerState.code, provisioningState]' --output tsv
                        if ($LASTEXITCODE -ne 0) {
                            return $null
                        }
                        $fields = @((@($lines) -join ' ').Trim() -split '\s+', 2)
                        return [pscustomobject] @{ Power = $fields[0]; Provisioning = $(if ($fields.Count -gt 1) { $fields[1] } else { '' }) }
                    }
                    # Alert processing rule apr-sleep-<tier>: terraform/tier creates it disabled in rg-platform-<tier>-aks, and only
                    # env-sleep and env-wake toggle it.
                    function Test-AlertRule {
                        $PSNativeCommandUseErrorActionPreference = $false
                        az monitor alert-processing-rule show --resource-group $rg --name $rule --output none 2>$null
                        return $LASTEXITCODE -eq 0
                    }
                    $state = Get-AksState
                    if ($null -eq $state) {
                        Write-Warning "Cluster $cluster was not found in $rg; nothing to stop."
                        exit 0
                    }
                    if ($state.Power -ceq 'Stopped') {
                        Write-Host "$cluster is already stopped."
                        exit 0
                    }
                    if ($state.Power -cne 'Running' -or ($state.Provisioning -cne 'Succeeded' -and $state.Provisioning -cne 'Failed')) {
                        Write-Warning "$cluster is $($state.Power)/$($state.Provisioning); the next hourly run decides again."
                        exit 0
                    }
                    $octopusUrl = ([string] $OctopusParameters['Octopus.Web.ServerUri']).TrimEnd('/')
                    $spaceId = [string] $OctopusParameters['Octopus.Space.Id']
                    $apiKey = [string] $OctopusParameters['Platform.OctopusApiKey']
                    if (-not $apiKey) {
                        Fail-Step 'Platform.OctopusApiKey is empty in this step: octopus/terraform scopes it to the REST-calling steps of platform-infrastructure (S5).'
                    }
                    if (-not (Get-Command -Name curl -CommandType Application -ErrorAction SilentlyContinue)) {
                        Fail-Step 'curl is missing from the step container.'
                    }
                    # Octopus REST call; returns the response body, or $null when the call fails. The key reaches curl through its
                    # configuration on standard input, never through the process arguments.
                    function Invoke-OctopusApi {
                        param(
                            [Parameter(Mandatory)] [string] $Method,
                            [Parameter(Mandatory)] [string] $Path,
                            [string] $Body
                        )
                        $arguments = @('--config', '-', '--fail', '--silent', '--show-error', '--max-time', '60', '--request', $Method, '--header', 'Accept: application/json')
                        if ($PSBoundParameters.ContainsKey('Body')) {
                            $arguments += @('--header', 'Content-Type: application/json', '--data', $Body)
                        }
                        $arguments += "$octopusUrl$Path"
                        $PSNativeCommandUseErrorActionPreference = $false
                        $response = "header = `"X-Octopus-ApiKey: $apiKey`"" | curl @arguments
                        if ($LASTEXITCODE -ne 0) {
                            return $null
                        }
                        return (@($response) -join "`n")
                    }
                    # The id of the only item of that name in a collection of this space; fails the step otherwise.
                    function Get-OctopusItemId([string] $Collection, [string] $Name) {
                        $listing = Invoke-OctopusApi -Method GET -Path "/api/$spaceId/$($Collection)?partialName=$Name&take=100"
                        if ($null -eq $listing) {
                            Fail-Step "Octopus REST call for $Collection '$Name' failed; check Platform.OctopusApiKey."
                        }
                        $id = ''
                        try {
                            $named = @(@((ConvertFrom-Json -InputObject $listing -AsHashtable)['Items']) | Where-Object { $_ -is [System.Collections.IDictionary] -and $_['Name'] -is [string] -and $_['Name'] -ceq $Name })
                            if ($named.Count -eq 1 -and $null -ne $named[0]['Id']) {
                                $id = [string] $named[0]['Id']
                            }
                        }
                        catch {
                            $id = ''
                        }
                        if (-not $id) {
                            Fail-Step "No single item named '$Name' in $Collection of space $spaceId."
                        }
                        return $id
                    }
                    $appEnvironments = if ($class -ceq 'nonprod') { @('tdd', 'uat') } else { @('prod') }
                    $selfTask = [string] $OctopusParameters['Octopus.Task.Id']
                    $environmentIds = @(foreach ($environment in @($appEnvironments) + [string] $OctopusParameters['Octopus.Environment.Name']) {
                            Get-OctopusItemId -Collection 'environments' -Name $environment
                        })
                    # Seconds since 1970 of a date and time; a string without an offset is UTC. $null when it is not a date and time.
                    function ConvertTo-UnixTime($Value) {
                        if ($Value -is [DateTime]) {
                            if ($Value.Kind -eq [DateTimeKind]::Unspecified) {
                                $Value = [DateTime]::SpecifyKind($Value, [DateTimeKind]::Utc)
                            }
                            return ([DateTimeOffset] $Value).ToUnixTimeSeconds()
                        }
                        $parsed = [DateTimeOffset]::MinValue
                        $styles = [System.Globalization.DateTimeStyles]::AssumeUniversal -bor [System.Globalization.DateTimeStyles]::AllowWhiteSpaces
                        if ([DateTimeOffset]::TryParse([string] $Value, [System.Globalization.CultureInfo]::InvariantCulture, $styles, [ref] $parsed)) {
                            return $parsed.ToUnixTimeSeconds()
                        }
                        return $null
                    }
                    # A task field as the task list shows it: '-' when empty.
                    function Format-TaskField($Value) {
                        if ($null -eq $Value -or ($Value -is [string] -and $Value.Length -eq 0)) {
                            return '-'
                        }
                        if ($Value -is [bool]) {
                            return $Value.ToString().ToLowerInvariant()
                        }
                        return [string] $Value
                    }
                    # A task time as the task list reads it: $null when empty or '-', else the value.
                    function Get-TaskTime($Value) {
                        if ($null -eq $Value -or ($Value -is [string] -and ($Value.Length -eq 0 -or $Value -ceq '-'))) {
                            return $null
                        }
                        return $Value
                    }
                    # The tasks of one environment in the given states: see step Decide sleep [VERIFY task list filters environment and
                    # states]. $null when the list cannot be read.
                    function Get-TaskList([string] $EnvironmentId, [string] $States, [int] $Take) {
                        $json = Invoke-OctopusApi -Method GET -Path "/api/$spaceId/tasks?environment=$EnvironmentId&states=$States&take=$Take"
                        if ($null -eq $json) {
                            return $null
                        }
                        try {
                            $items = (ConvertFrom-Json -InputObject $json -AsHashtable)['Items']
                        }
                        catch {
                            return $null
                        }
                        if ($items -isnot [System.Collections.IList]) {
                            return $null
                        }
                        $tasks = [System.Collections.Generic.List[object]]::new()
                        foreach ($item in $items) {
                            if ($item -isnot [System.Collections.IDictionary]) {
                                return $null
                            }
                            $tasks.Add([pscustomobject] @{
                                    Id            = Format-TaskField $item['Id']
                                    State         = Format-TaskField $item['State']
                                    QueueTime     = Get-TaskTime $item['QueueTime']
                                    CompletedTime = Get-TaskTime $item['CompletedTime']
                                    Description   = Format-TaskField $item['Description']
                                })
                        }
                        return , $tasks.ToArray()
                    }
                    # The first queued or executing deployment or runbook run other than this run, or '' (see step Decide sleep).
                    function Get-BusyTask {
                        $nowBusy = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
                        foreach ($environmentId in $environmentIds) {
                            $tasks = Get-TaskList -EnvironmentId $environmentId -States 'Queued,Executing,Cancelling' -Take 100
                            if ($null -eq $tasks) {
                                Fail-Step 'Cannot read the Octopus task list; nothing is stopped.'
                            }
                            foreach ($task in $tasks) {
                                if ($task.Id -ceq $selfTask) {
                                    continue
                                }
                                if ($task.State -ceq 'Queued' -and $null -ne $task.QueueTime) {
                                    $queuedAt = ConvertTo-UnixTime $task.QueueTime
                                    if ($null -eq $queuedAt) {
                                        $queuedAt = $nowBusy
                                    }
                                    if ($queuedAt -gt $nowBusy + 900) {
                                        continue
                                    }
                                }
                                return "$($task.Id) ($($task.State): $($task.Description))"
                            }
                        }
                        return ''
                    }
                    # ADR-IR33 rule 5: suppress alerts, read the task list again, then stop. Alerts never stay muted on a running cluster:
                    # on any exit before the stop is accepted (busy, error, rejected stop) the rule is disabled again. A stop that Azure
                    # accepts and that fails later is healed by step Heal alert rule of the next env-sleep or env-wake run.
                    $ruleOn = $false
                    $stopped = $false
                    try {
                        if (Test-AlertRule) {
                            # --only-show-errors: the command group is in preview, and its stderr notice turned every stop into a warning.
                            $PSNativeCommandUseErrorActionPreference = $false
                            az monitor alert-processing-rule update --resource-group $rg --name $rule --enabled true --output none --only-show-errors
                            $muted = $LASTEXITCODE -eq 0
                            $PSNativeCommandUseErrorActionPreference = $true
                            if (-not $muted) {
                                Fail-Step "Enabling alert processing rule $rule failed (see above); $cluster keeps running."
                            }
                            $ruleOn = $true
                            Write-Host "Alert processing rule $rule enabled."
                        }
                        else {
                            Write-Warning "Alert processing rule $rule was not found in $rg; stopping without muting alerts."
                        }
                        # A deployment or an env-wake may have been queued since the decision.
                        $busy = Get-BusyTask
                        if ($busy) {
                            Write-Highlight "Not stopping $($cluster): busy: $busy"
                            exit 0
                        }
                        # ADR-IR34 decision 22: Kyverno's webhooks exclude AKS-managed kinds, so AKS accepts the stop (V9, CAP-AZ-005).
                        $PSNativeCommandUseErrorActionPreference = $false
                        az aks stop --resource-group $rg --name $cluster --no-wait
                        $accepted = $LASTEXITCODE -eq 0
                        $PSNativeCommandUseErrorActionPreference = $true
                        if (-not $accepted) {
                            Fail-Step "Stopping $cluster was rejected (see above)."
                        }
                        $stopped = $true
                        Write-Highlight "Stopping $($cluster): $reason"
                    }
                    finally {
                        if ($ruleOn -and -not $stopped) {
                            $PSNativeCommandUseErrorActionPreference = $false
                            az monitor alert-processing-rule update --resource-group $rg --name $rule --enabled false --output none --only-show-errors
                            if ($LASTEXITCODE -eq 0) {
                                Write-Host "Alert processing rule $rule disabled again: $cluster keeps running."
                            }
                            else {
                                Write-Warning "Could not disable $rule again; disable it by hand (docs/runbooks/sleep-and-wake.md)."
                            }
                        }
                    }
                    exit 0
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }
}
