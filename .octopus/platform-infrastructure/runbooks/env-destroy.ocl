name = "env-destroy"
description = "Destroys the nonprod cluster and what depends on it, after approval. Never runs in infra-prod; keeps the vault, IPs, workspace, groups and database disks."
default_guided_failure_mode = "EnvironmentDefault"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "wake-environment" {
        name = "Wake environment"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    # Sleep/wake (ADR-IR33): wake the cluster of this infrastructure environment before anything needs it, through
                    # runbook env-wake and the step-scoped key (S5). Skipped while the cluster does not exist: the first env-apply creates it.
                    $callerEnvironment = [string] $OctopusParameters['Octopus.Environment.Name']
                    $target = $callerEnvironment
                    $class = [string] $OctopusParameters['Environment.Class']
                    if ($class -cne 'nonprod' -and $class -cne 'prod') {
                        Fail-Step "Environment.Class '$class' must be nonprod or prod (library variable set Platform Infrastructure)."
                    }
                    $cluster = "aks-platform-$class"
                    $rg = "rg-platform-$class-aks"
                    $PSNativeCommandUseErrorActionPreference = $false
                    $clusterRead = az aks show --resource-group $rg --name $cluster --output none 2>&1
                    $clusterFound = $LASTEXITCODE -eq 0
                    $PSNativeCommandUseErrorActionPreference = $true
                    if (-not $clusterFound) {
                        $clusterError = (@($clusterRead) | ForEach-Object { "$_" }) -join "`n"
                        if ($clusterError -cmatch 'ResourceNotFound|ResourceGroupNotFound|was not found') {
                            Write-Highlight "Cluster $cluster does not exist yet: nothing to wake."
                            exit 0
                        }
                        Fail-Step "Cannot read cluster $($cluster): $clusterError"
                    }
                    $octopusUrl = ([string] $OctopusParameters['Octopus.Web.ServerUri']).TrimEnd('/')
                    $spaceId = [string] $OctopusParameters['Octopus.Space.Id']
                    $apiKey = [string] $OctopusParameters['Platform.OctopusApiKey']
                    if (-not $apiKey) {
                        Fail-Step 'Platform.OctopusApiKey is empty in this step: octopus/terraform scopes it to the REST-calling steps of platform-infrastructure (S5).'
                    }
                    if (-not (Get-Command -Name curl -CommandType Application -ErrorAction SilentlyContinue)) {
                        Fail-Step 'curl is missing from the step container.'
                    }
                    # Octopus REST call; returns the response body, or $null when the call fails (the reply to a failed call is kept in
                    # $script:OctopusApiError for the failure message). The key reaches curl through its
                    # configuration on standard input, never through the process arguments.
                    $script:OctopusApiError = ''
                    function Invoke-OctopusApi {
                        param(
                            [Parameter(Mandatory)] [string] $Method,
                            [Parameter(Mandatory)] [string] $Path,
                            [string] $Body
                        )
                        $arguments = @('--config', '-', '--fail-with-body', '--silent', '--show-error', '--max-time', '60', '--request', $Method, '--header', 'Accept: application/json')
                        if ($PSBoundParameters.ContainsKey('Body')) {
                            $arguments += @('--header', 'Content-Type: application/json', '--data', $Body)
                        }
                        $arguments += "$octopusUrl$Path"
                        $PSNativeCommandUseErrorActionPreference = $false
                        $response = "header = `"X-Octopus-ApiKey: $apiKey`"" | curl @arguments
                        if ($LASTEXITCODE -ne 0) {
                            $script:OctopusApiError = ((@($response) -join ' ') -replace '\s+', ' ').Trim()
                            return $null
                        }
                        return (@($response) -join "`n")
                    }
                    # The id of the only item of that name in a collection of this space; fails the step otherwise.
                    function Get-OctopusItemId([string] $Collection, [string] $Name) {
                        $listing = Invoke-OctopusApi -Method GET -Path "/api/$spaceId/$($Collection)?partialName=$Name&take=100"
                        if ($null -eq $listing) {
                            Fail-Step "Octopus REST call for $Collection '$Name' failed ($script:OctopusApiError); check Platform.OctopusApiKey."
                        }
                        $id = ''
                        try {
                            $named = @(@((ConvertFrom-Json -InputObject $listing -AsHashtable)['Items']) | Where-Object { $_ -is [System.Collections.IDictionary] -and $_['Name'] -is [string] -and $_['Name'] -ceq $Name })
                            if ($named.Count -eq 1 -and $null -ne $named[0]['Id']) {
                                $id = [string] $named[0]['Id']
                            }
                        }
                        catch {
                            $id = ''
                        }
                        if (-not $id) {
                            Fail-Step "No single item named '$Name' in $Collection of space $spaceId."
                        }
                        return $id
                    }
                    # The first TaskId (else ServerTaskId) string anywhere in a JSON response, depth first; '' when there is none.
                    function Find-TaskId($Node) {
                        if ($Node -is [System.Collections.IDictionary]) {
                            $candidate = $Node['TaskId']
                            if ($null -eq $candidate -or ($candidate -is [bool] -and -not $candidate)) {
                                $candidate = $Node['ServerTaskId']
                            }
                            if ($candidate -is [string]) {
                                return $candidate
                            }
                            $children = @($Node.Values)
                        }
                        elseif ($Node -is [System.Collections.IList]) {
                            $children = @($Node)
                        }
                        else {
                            return $null
                        }
                        foreach ($child in $children) {
                            $found = Find-TaskId $child
                            if ($null -ne $found) {
                                return $found
                            }
                        }
                        return $null
                    }
                    # JSON text as 'jq -r' prints it: strings as they are, null as 'null', booleans in lower case.
                    function ConvertTo-JqText($Value) {
                        if ($null -eq $Value) {
                            return 'null'
                        }
                        if ($Value -is [bool]) {
                            return $Value.ToString().ToLowerInvariant()
                        }
                        if ($Value -is [string]) {
                            return $Value
                        }
                        return ConvertTo-Json -InputObject $Value -Depth 20 -Compress
                    }
                    $projectId = Get-OctopusItemId -Collection 'projects' -Name 'platform-infrastructure'
                    $environmentId = Get-OctopusItemId -Collection 'environments' -Name $target
                    $payload = ConvertTo-Json -Depth 20 -InputObject ([ordered] @{
                            SelectedPackages     = @()
                            SelectedGitResources = @()
                            Runs                 = @([ordered] @{ EnvironmentId = $environmentId; TenantId = $null; SkipActions = @(); SpecificMachineIds = @(); ExcludedMachineIds = @() })
                        })
                    # Config-as-code runbook run from the default branch (route runGitRunbookV1; OctopusDeploy-Api sample
                    # REST/PowerShell/Runbooks/RunConfigAsCodeRunbook.ps1). The response carries Resources[].TaskId.
                    $response = Invoke-OctopusApi -Method POST -Path "/api/spaces/$spaceId/projects/$projectId/refs%2Fheads%2Fmain/runbooks/env-wake/run/v1" -Body $payload
                    if ($null -eq $response) {
                        Fail-Step "Octopus refused to run env-wake in $($target): $script:OctopusApiError"
                    }
                    $taskId = ''
                    try {
                        $taskId = [string] (Find-TaskId (ConvertFrom-Json -InputObject $response -AsHashtable -NoEnumerate))
                    }
                    catch {
                        $taskId = ''
                    }
                    if (-not $taskId) {
                        Fail-Step "Octopus returned no task for env-wake in $($target): $response"
                    }
                    Write-Host "env-wake is running in $($target): $octopusUrl/app#/$spaceId/tasks/$taskId"
                    # Task cap (5 slots for the whole instance): a waking deployment holds three, its own task, this one and env-wake.
                    # env-wake never starts a fourth task and waits for it. Ceiling: Wake.TimeoutMinutes plus queueing.
                    $deadline = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + 3600
                    while ($true) {
                        $task = Invoke-OctopusApi -Method GET -Path "/api/$spaceId/tasks/$taskId"
                        $state = $null
                        if ($task) {
                            try {
                                $state = ConvertFrom-Json -InputObject $task -AsHashtable -NoEnumerate
                            }
                            catch {
                                $state = $null
                            }
                        }
                        if ($state -is [System.Collections.IDictionary] -and (ConvertTo-JqText $state['IsCompleted']) -ceq 'true') {
                            if ((ConvertTo-JqText $state['FinishedSuccessfully']) -ceq 'true') {
                                Write-Highlight "The cluster of $callerEnvironment is awake (env-wake in $target, $taskId)."
                                exit 0
                            }
                            $errorMessage = $state['ErrorMessage']
                            if ($null -eq $errorMessage -or ($errorMessage -is [bool] -and -not $errorMessage)) {
                                $errorMessage = ''
                            }
                            Fail-Step "env-wake in $target ended $(ConvertTo-JqText $state['State']): $(ConvertTo-JqText $errorMessage)"
                        }
                        if ([DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -ge $deadline) {
                            Fail-Step "env-wake in $target ($taskId) did not finish within 60 minutes."
                        }
                        Start-Sleep -Seconds 15
                    }
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "guard-nonprod-only" {
        name = "Guard nonprod only"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $environment = [string] $OctopusParameters['Octopus.Environment.Name']
                    $ref = [string] $OctopusParameters['Octopus.RunbookRun.Git.Ref']
                    if ($environment -cne 'infra-nonprod' -or [string] $OctopusParameters['Environment.Class'] -cne 'nonprod') {
                        Fail-Step 'env-destroy runs only in infra-nonprod with Environment.Class nonprod.'
                    }
                    if ($ref -cne 'refs/heads/main') {
                        Write-Warning "Destroying with Terraform from '$ref', not refs/heads/main."
                    }
                    Write-Host "Guard passed for $environment."
                    exit 0
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "plan-destroy" {
        name = "Plan environment destroy"

        action {
            action_type = "Octopus.TerraformPlanDestroy"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.AzureAccount.Variable = "Azure.LifecycleAccount"
                Octopus.Action.GitRepository.Source = "Project"
                Octopus.Action.Script.ScriptSource = "GitRepository"
                Octopus.Action.Terraform.AdditionalActionParams = "-lock-timeout=300s -target=azurerm_kubernetes_cluster.this"
                Octopus.Action.Terraform.AdditionalInitParams = "-backend-config=resource_group_name=#{Terraform.StateResourceGroup} -backend-config=storage_account_name=#{Terraform.StateStorageAccount} -backend-config=container_name=#{Terraform.StateContainer} -backend-config=key=#{Terraform.StateKey} -backend-config=use_azuread_auth=true"
                Octopus.Action.Terraform.AllowPluginDownloads = "True"
                Octopus.Action.Terraform.AzureAccount = "True"
                Octopus.Action.Terraform.EnvVariables = "{\"TF_VAR_octopus_worker_registration_token\":\"#{if Octopus.WorkerRegistrationToken}#{Octopus.WorkerRegistrationToken}#{/if}\",\"TF_VAR_argocd_repo_read_credential\":\"#{if ArgoCD.RepoReadCredential}#{ArgoCD.RepoReadCredential | JsonEscape}#{/if}\"}"
                Octopus.Action.Terraform.ManagedAccount = "None"
                Octopus.Action.Terraform.PlanJsonOutput = "False"
                Octopus.Action.Terraform.RunAutomaticFileSubstitution = "False"
                Octopus.Action.Terraform.TemplateDirectory = "terraform/tier"
                Octopus.Action.Terraform.VarFiles = "#{Environment.Class}.tfvars"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "check-destroy-scope" {
        name = "Check destroy scope"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $planFile = "terraform-destroy-plan-$($OctopusParameters['Environment.Class']).txt"
                    $plan = [string] $OctopusParameters['Octopus.Action[Plan environment destroy].Output.TerraformPlanOutput']
                    $planPath = Join-Path (Get-Location).Path $planFile
                    [System.IO.File]::WriteAllText($planPath, $plan)
                    if (-not $plan) {
                        Fail-Step 'Plan environment destroy produced no plan output.'
                    }
                    New-OctopusArtifact -Path $planPath -Name $planFile
                    # Resource change headers look like "  # azurerm_x.name will be created"; data sources are excluded. Role assignments,
                    # locks and resource groups belong to the provisioner (terraform/foundation, terraform/apps/grants; ADR-IR34 decision 3).
                    if (@($plan -split "`n" | Where-Object { $_ -cmatch '^[ \t\r\v\f]*# (module\.[^ \t\r\n\v\f]+\.)?azurerm_(role_assignment|management_lock|resource_group)\.' }).Count -gt 0) {
                        Fail-Step 'The plan touches role assignments, locks or resource groups; the provisioner owns them (ADR-IR34 decision 3).'
                    }
                    Write-Host "Plan saved as artifact $planFile; the layer boundary holds."
                    exit 0
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "approve-destroy" {
        name = "Approve environment destroy"

        action {
            action_type = "Octopus.Manual"
            is_required = true
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.Manual.BlockConcurrentDeployments = "True"
                Octopus.Action.Manual.Instructions = <<-EOT
                    ## Approve destroying the nonprod tier (aks-platform-nonprod)
                    This deletes the nonprod cluster with its apps pool, Argo CD and the Octopus workers k8s-tdd and k8s-uat. tdd and
                    uat stop serving until env-apply, then apps-apply for every app, rebuild them. The platform vault, the static IPs
                    (the apps domain), the Log Analytics workspace, the network and the database disks stay.
                    Confirm that:
                    - the destroy is announced and no UAT cycle is open;
                    - the plan below lists no resource group, lock, role assignment or database disk.
                    
                    ```
                    #{Octopus.Action[Plan environment destroy].Output.TerraformPlanOutput}
                    ```
                    EOT
                Octopus.Action.Manual.ResponsibleTeamIds = "platform-engineers"
                Octopus.Action.RunOnServer = "false"
            }
        }
    }

    step "destroy-environment" {
        name = "Destroy environment"

        action {
            action_type = "Octopus.TerraformDestroy"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.AzureAccount.Variable = "Azure.LifecycleAccount"
                Octopus.Action.GitRepository.Source = "Project"
                Octopus.Action.Script.ScriptSource = "GitRepository"
                Octopus.Action.Terraform.AdditionalActionParams = "-lock-timeout=300s -target=azurerm_kubernetes_cluster.this"
                Octopus.Action.Terraform.AdditionalInitParams = "-backend-config=resource_group_name=#{Terraform.StateResourceGroup} -backend-config=storage_account_name=#{Terraform.StateStorageAccount} -backend-config=container_name=#{Terraform.StateContainer} -backend-config=key=#{Terraform.StateKey} -backend-config=use_azuread_auth=true"
                Octopus.Action.Terraform.AllowPluginDownloads = "True"
                Octopus.Action.Terraform.AzureAccount = "True"
                Octopus.Action.Terraform.EnvVariables = "{\"TF_VAR_octopus_worker_registration_token\":\"#{if Octopus.WorkerRegistrationToken}#{Octopus.WorkerRegistrationToken}#{/if}\",\"TF_VAR_argocd_repo_read_credential\":\"#{if ArgoCD.RepoReadCredential}#{ArgoCD.RepoReadCredential | JsonEscape}#{/if}\"}"
                Octopus.Action.Terraform.ManagedAccount = "None"
                Octopus.Action.Terraform.RunAutomaticFileSubstitution = "False"
                Octopus.Action.Terraform.TemplateDirectory = "terraform/tier"
                Octopus.Action.Terraform.VarFiles = "#{Environment.Class}.tfvars"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }
}
