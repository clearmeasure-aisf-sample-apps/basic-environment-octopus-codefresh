name = "apps-plan"
description = "Plans terraform/apps/tier for the prompted App.Name in the tier of the environment."
default_guided_failure_mode = "EnvironmentDefault"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "guard-app" {
        name = "Guard app"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $app = [string] $OctopusParameters['App.Name']
                    $environment = [string] $OctopusParameters['Octopus.Environment.Name']
                    $class = [string] $OctopusParameters['Environment.Class']
                    $ref = [string] $OctopusParameters['Octopus.RunbookRun.Git.Ref']
                    # ADR-IR34 decision 10: 3 to 12 characters, no dash, no reserved word. The layer reads apps/<App.Name>.yaml itself.
                    if ($app -cnotmatch '\A[a-z][a-z0-9]{2,11}\z') {
                        Fail-Step "App.Name '$app' is not an app slug (^[a-z][a-z0-9]{2,11}$)."
                    }
                    if (@('apps', 'argo', 'argocd', 'cert', 'default', 'external', 'infra', 'kube', 'kyverno', 'octopus', 'platform', 'system') -ccontains $app) {
                        Fail-Step "App.Name '$app' is a reserved word (ADR-IR34 decision 10)."
                    }
                    if (-not (($environment -ceq 'infra-nonprod' -and $class -ceq 'nonprod') -or ($environment -ceq 'infra-prod' -and $class -ceq 'prod'))) {
                        Fail-Step "Environment.Class '$class' does not match environment '$environment' (library variable set Platform Infrastructure)."
                    }
                    if ($ref -cne 'refs/heads/main') {
                        if ($environment -ceq 'infra-prod') {
                            Fail-Step "infra-prod runs only from refs/heads/main (this run: '$ref')."
                        }
                        Write-Warning "Running unmerged configuration from '$ref' in $environment."
                    }
                    Write-Highlight "App $app, tier $class, from $ref (state apps-$app.tfstate)."
                    exit 0
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "plan-app" {
        name = "Plan app"

        action {
            action_type = "Octopus.TerraformPlan"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.AzureAccount.Variable = "Azure.LifecycleAccount"
                Octopus.Action.GitRepository.Source = "Project"
                Octopus.Action.Script.ScriptSource = "GitRepository"
                Octopus.Action.Terraform.AdditionalActionParams = "-lock-timeout=300s"
                Octopus.Action.Terraform.AdditionalInitParams = "-backend-config=resource_group_name=#{Terraform.StateResourceGroup} -backend-config=storage_account_name=#{Terraform.StateStorageAccount} -backend-config=container_name=#{Terraform.StateContainer} -backend-config=key=apps-#{App.Name}.tfstate -backend-config=use_azuread_auth=true"
                Octopus.Action.Terraform.AllowPluginDownloads = "True"
                Octopus.Action.Terraform.AzureAccount = "True"
                Octopus.Action.Terraform.EnvVariables = "{\"TF_VAR_app\":\"#{App.Name}\",\"TF_VAR_tier\":\"#{Environment.Class}\"}"
                Octopus.Action.Terraform.ManagedAccount = "None"
                Octopus.Action.Terraform.PlanJsonOutput = "False"
                Octopus.Action.Terraform.RunAutomaticFileSubstitution = "False"
                Octopus.Action.Terraform.TemplateDirectory = "terraform/apps/tier"
                Octopus.Action.Terraform.VarFiles = "#{Environment.Class}.tfvars"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "save-and-check-plan" {
        name = "Save and check plan"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $planFile = "terraform-apps-plan-$($OctopusParameters['Environment.Class']).txt"
                    $plan = [string] $OctopusParameters['Octopus.Action[Plan app].Output.TerraformPlanOutput']
                    $planPath = Join-Path (Get-Location).Path $planFile
                    [System.IO.File]::WriteAllText($planPath, $plan)
                    if (-not $plan) {
                        Fail-Step 'Plan app produced no plan output.'
                    }
                    New-OctopusArtifact -Path $planPath -Name $planFile
                    # Resource change headers look like "  # azurerm_x.name will be created"; data sources are excluded. Role assignments,
                    # locks and resource groups belong to the provisioner (terraform/foundation, terraform/apps/grants; ADR-IR34 decision 3).
                    if (@($plan -split "`n" | Where-Object { $_ -cmatch '^[ \t\r\v\f]*# (module\.[^ \t\r\n\v\f]+\.)?azurerm_(role_assignment|management_lock|resource_group)\.' }).Count -gt 0) {
                        Fail-Step 'The plan touches role assignments, locks or resource groups; the provisioner owns them (ADR-IR34 decision 3).'
                    }
                    Write-Host "Plan saved as artifact $planFile; the layer boundary holds."
                    exit 0
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }
}
