name = "rotate-db-passwords"
description = "Rotates the SQL logins <app>_migrator, <app>_app and sa of the prompted App.Name in the tier of the environment."
default_guided_failure_mode = "EnvironmentDefault"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "wake-environment" {
        name = "Wake environment"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    # Sleep/wake (ADR-IR33): wake the cluster of this infrastructure environment before anything needs it, through
                    # runbook env-wake and the step-scoped key (S5). Fails while the cluster does not exist: run env-apply first.
                    $callerEnvironment = [string] $OctopusParameters['Octopus.Environment.Name']
                    $target = $callerEnvironment
                    $class = [string] $OctopusParameters['Environment.Class']
                    if ($class -cne 'nonprod' -and $class -cne 'prod') {
                        Fail-Step "Environment.Class '$class' must be nonprod or prod (library variable set Platform Infrastructure)."
                    }
                    $cluster = "aks-platform-$class"
                    $rg = "rg-platform-$class-aks"
                    $PSNativeCommandUseErrorActionPreference = $false
                    $clusterRead = az aks show --resource-group $rg --name $cluster --output none 2>&1
                    $clusterFound = $LASTEXITCODE -eq 0
                    $PSNativeCommandUseErrorActionPreference = $true
                    if (-not $clusterFound) {
                        $clusterError = (@($clusterRead) | ForEach-Object { "$_" }) -join "`n"
                        if ($clusterError -cmatch 'ResourceNotFound|ResourceGroupNotFound|was not found') {
                            Fail-Step "Cluster $cluster does not exist: run env-apply in $callerEnvironment first."
                        }
                        Fail-Step "Cannot read cluster $($cluster): $clusterError"
                    }
                    $octopusUrl = ([string] $OctopusParameters['Octopus.Web.ServerUri']).TrimEnd('/')
                    $spaceId = [string] $OctopusParameters['Octopus.Space.Id']
                    $apiKey = [string] $OctopusParameters['Platform.OctopusApiKey']
                    if (-not $apiKey) {
                        Fail-Step 'Platform.OctopusApiKey is empty in this step: octopus/terraform scopes it to the REST-calling steps of platform-infrastructure (S5).'
                    }
                    if (-not (Get-Command -Name curl -CommandType Application -ErrorAction SilentlyContinue)) {
                        Fail-Step 'curl is missing from the step container.'
                    }
                    # Octopus REST call; returns the response body, or $null when the call fails. The key reaches curl through its
                    # configuration on standard input, never through the process arguments.
                    function Invoke-OctopusApi {
                        param(
                            [Parameter(Mandatory)] [string] $Method,
                            [Parameter(Mandatory)] [string] $Path,
                            [string] $Body
                        )
                        $arguments = @('--config', '-', '--fail', '--silent', '--show-error', '--max-time', '60', '--request', $Method, '--header', 'Accept: application/json')
                        if ($PSBoundParameters.ContainsKey('Body')) {
                            $arguments += @('--header', 'Content-Type: application/json', '--data', $Body)
                        }
                        $arguments += "$octopusUrl$Path"
                        $PSNativeCommandUseErrorActionPreference = $false
                        $response = "header = `"X-Octopus-ApiKey: $apiKey`"" | curl @arguments
                        if ($LASTEXITCODE -ne 0) {
                            return $null
                        }
                        return (@($response) -join "`n")
                    }
                    # The id of the only item of that name in a collection of this space; fails the step otherwise.
                    function Get-OctopusItemId([string] $Collection, [string] $Name) {
                        $listing = Invoke-OctopusApi -Method GET -Path "/api/$spaceId/$($Collection)?partialName=$Name&take=100"
                        if ($null -eq $listing) {
                            Fail-Step "Octopus REST call for $Collection '$Name' failed; check Platform.OctopusApiKey."
                        }
                        $id = ''
                        try {
                            $named = @(@((ConvertFrom-Json -InputObject $listing -AsHashtable)['Items']) | Where-Object { $_ -is [System.Collections.IDictionary] -and $_['Name'] -is [string] -and $_['Name'] -ceq $Name })
                            if ($named.Count -eq 1 -and $null -ne $named[0]['Id']) {
                                $id = [string] $named[0]['Id']
                            }
                        }
                        catch {
                            $id = ''
                        }
                        if (-not $id) {
                            Fail-Step "No single item named '$Name' in $Collection of space $spaceId."
                        }
                        return $id
                    }
                    # The first TaskId (else ServerTaskId) string anywhere in a JSON response, depth first; '' when there is none.
                    function Find-TaskId($Node) {
                        if ($Node -is [System.Collections.IDictionary]) {
                            $candidate = $Node['TaskId']
                            if ($null -eq $candidate -or ($candidate -is [bool] -and -not $candidate)) {
                                $candidate = $Node['ServerTaskId']
                            }
                            if ($candidate -is [string]) {
                                return $candidate
                            }
                            $children = @($Node.Values)
                        }
                        elseif ($Node -is [System.Collections.IList]) {
                            $children = @($Node)
                        }
                        else {
                            return $null
                        }
                        foreach ($child in $children) {
                            $found = Find-TaskId $child
                            if ($null -ne $found) {
                                return $found
                            }
                        }
                        return $null
                    }
                    # JSON text as 'jq -r' prints it: strings as they are, null as 'null', booleans in lower case.
                    function ConvertTo-JqText($Value) {
                        if ($null -eq $Value) {
                            return 'null'
                        }
                        if ($Value -is [bool]) {
                            return $Value.ToString().ToLowerInvariant()
                        }
                        if ($Value -is [string]) {
                            return $Value
                        }
                        return ConvertTo-Json -InputObject $Value -Depth 20 -Compress
                    }
                    $projectId = Get-OctopusItemId -Collection 'projects' -Name 'platform-infrastructure'
                    $environmentId = Get-OctopusItemId -Collection 'environments' -Name $target
                    $payload = ConvertTo-Json -Depth 20 -InputObject ([ordered] @{
                            SelectedPackages     = @()
                            SelectedGitResources = @()
                            Runs                 = @([ordered] @{ EnvironmentId = $environmentId; TenantId = $null; SkipActions = @(); SpecificMachineIds = @(); ExcludedMachineIds = @() })
                        })
                    # Config-as-code runbook run from the default branch (route runGitRunbookV1; OctopusDeploy-Api sample
                    # REST/PowerShell/Runbooks/RunConfigAsCodeRunbook.ps1). The response carries Resources[].TaskId.
                    $response = Invoke-OctopusApi -Method POST -Path "/api/spaces/$spaceId/projects/$projectId/refs%2Fheads%2Fmain/runbooks/env-wake/run/v1" -Body $payload
                    if ($null -eq $response) {
                        Fail-Step "Octopus refused to run env-wake in $target."
                    }
                    $taskId = ''
                    try {
                        $taskId = [string] (Find-TaskId (ConvertFrom-Json -InputObject $response -AsHashtable -NoEnumerate))
                    }
                    catch {
                        $taskId = ''
                    }
                    if (-not $taskId) {
                        Fail-Step "Octopus returned no task for env-wake in $($target): $response"
                    }
                    Write-Host "env-wake is running in $($target): $octopusUrl/app#/$spaceId/tasks/$taskId"
                    # Task cap (5 slots for the whole instance): a waking deployment holds three, its own task, this one and env-wake.
                    # env-wake never starts a fourth task and waits for it. Ceiling: Wake.TimeoutMinutes plus queueing.
                    $deadline = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + 3600
                    while ($true) {
                        $task = Invoke-OctopusApi -Method GET -Path "/api/$spaceId/tasks/$taskId"
                        $state = $null
                        if ($task) {
                            try {
                                $state = ConvertFrom-Json -InputObject $task -AsHashtable -NoEnumerate
                            }
                            catch {
                                $state = $null
                            }
                        }
                        if ($state -is [System.Collections.IDictionary] -and (ConvertTo-JqText $state['IsCompleted']) -ceq 'true') {
                            if ((ConvertTo-JqText $state['FinishedSuccessfully']) -ceq 'true') {
                                Write-Highlight "The cluster of $callerEnvironment is awake (env-wake in $target, $taskId)."
                                exit 0
                            }
                            $errorMessage = $state['ErrorMessage']
                            if ($null -eq $errorMessage -or ($errorMessage -is [bool] -and -not $errorMessage)) {
                                $errorMessage = ''
                            }
                            Fail-Step "env-wake in $target ended $(ConvertTo-JqText $state['State']): $(ConvertTo-JqText $errorMessage)"
                        }
                        if ([DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -ge $deadline) {
                            Fail-Step "env-wake in $target ($taskId) did not finish within 60 minutes."
                        }
                        Start-Sleep -Seconds 15
                    }
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "guard-app" {
        name = "Guard app"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $app = [string] $OctopusParameters['App.Name']
                    $environment = [string] $OctopusParameters['Octopus.Environment.Name']
                    $class = [string] $OctopusParameters['Environment.Class']
                    $ref = [string] $OctopusParameters['Octopus.RunbookRun.Git.Ref']
                    # ADR-IR34 decision 10: 3 to 12 characters, no dash, no reserved word. The layer reads apps/<App.Name>.yaml itself.
                    if ($app -cnotmatch '\A[a-z][a-z0-9]{2,11}\z') {
                        Fail-Step "App.Name '$app' is not an app slug (^[a-z][a-z0-9]{2,11}$)."
                    }
                    if (@('apps', 'argo', 'argocd', 'cert', 'default', 'external', 'infra', 'kube', 'kyverno', 'octopus', 'platform', 'system') -ccontains $app) {
                        Fail-Step "App.Name '$app' is a reserved word (ADR-IR34 decision 10)."
                    }
                    if (-not (($environment -ceq 'infra-nonprod' -and $class -ceq 'nonprod') -or ($environment -ceq 'infra-prod' -and $class -ceq 'prod'))) {
                        Fail-Step "Environment.Class '$class' does not match environment '$environment' (library variable set Platform Infrastructure)."
                    }
                    if ($ref -cne 'refs/heads/main') {
                        if ($environment -ceq 'infra-prod') {
                            Fail-Step "infra-prod runs only from refs/heads/main (this run: '$ref')."
                        }
                        Write-Warning "Running unmerged configuration from '$ref' in $environment."
                    }
                    Write-Highlight "App $app, tier $class, from $ref (state apps-$app.tfstate)."
                    exit 0
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }

    step "rotate" {
        name = "Rotate database passwords"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandUseErrorActionPreference = $true
                    # Rotates the SQL logins <app>_migrator, <app>_app and sa of every app-environment of this tier (ADR-IR34 decision 8;
                    # CAP-AZ-011; docs/runbooks/credential-rotation.md section 4). Each login: a new password into the app vault, then ALTER
                    # LOGIN inside the database pod as sa. <app>_migrator and <app>_app first, then a forced ESO refresh and a restart of
                    # the app's own Deployments, named by the workload Applications of the tenant chart (labels platform/app, environment,
                    # platform/role=workload), so new connections use the new passwords; Argo CD keeps the restart, whose annotation is not
                    # in Git. sa last, because every other change runs as sa: then a forced refresh of the ExternalSecrets that read
                    # db-sa-password. Runs as the tier's lifecycle identity (Key Vault Secrets Officer on rg-platform-<tier>-apps, AKS RBAC
                    # Cluster Admin on the cluster) through kubectl with Entra ID tokens.
                    # Names from the platform database component (gitops/platform/components/db/mssql-2022-express, db-credentials/keyvault)
                    # and the tenant chart (gitops/platform/tenant/templates): pod db-0 of StatefulSet db in <app>-<env>, whose probes and
                    # db-init log in as sa with Secret db-sa mounted at /etc/platform/db-sa/password; sqlcmd at
                    # /opt/mssql-tools18/bin/sqlcmd; ExternalSecrets db-migrator, db-app and db-sa in the app namespaces and
                    # db-sa-<app>-<env> in platform-backup (uat and prod); namespace labels platform/app and environment.
                    $app = [string] $OctopusParameters['App.Name']
                    $class = [string] $OctopusParameters['Environment.Class']
                    if ($app -cnotmatch '\A[a-z][a-z0-9]{2,11}\z') {
                        Fail-Step "App.Name '$app' is not an app slug."
                    }
                    if ($class -ceq 'nonprod') {
                        $environments = @('tdd', 'uat')
                    }
                    elseif ($class -ceq 'prod') {
                        $environments = @('prod')
                    }
                    else {
                        Fail-Step "Environment.Class '$class' must be nonprod or prod."
                    }
                    $cluster = "aks-platform-$class"
                    $rg = "rg-platform-$class-aks"
                    $subscription = (@(az account show --query id --output tsv) -join "`n").Trim()
                    $work = Join-Path ([System.IO.Path]::GetTempPath()) ('rotate-db-passwords-' + [guid]::NewGuid().ToString('N'))
                    [System.IO.Directory]::CreateDirectory($work, [System.IO.UnixFileMode] 'UserRead, UserWrite, UserExecute') | Out-Null
                    try {
                        $env:KUBECONFIG = Join-Path $work 'kubeconfig'
                        az aks get-credentials --resource-group $rg --name $cluster --file $env:KUBECONFIG --overwrite-existing --only-show-errors
                        if (-not (Get-Command -Name kubectl -CommandType Application -ErrorAction SilentlyContinue) -or -not (Get-Command -Name kubelogin -CommandType Application -ErrorAction SilentlyContinue)) {
                            # [VERIFY whether the worker-tools image ships kubelogin]
                            $bin = Join-Path $work 'bin'
                            az aks install-cli --install-location (Join-Path $bin 'kubectl') --kubelogin-install-location (Join-Path $bin 'kubelogin') --only-show-errors | Out-Null
                            $env:PATH = $bin + [System.IO.Path]::PathSeparator + $env:PATH
                        }
                        # Entra ID tokens only: local accounts are off (ADR-IR34), and the Azure CLI login of this step is the identity.
                        kubelogin convert-kubeconfig --login azurecli --kubeconfig $env:KUBECONFIG
                        # 32 random base64 characters without symbols, plus a suffix that guarantees the SQL Server complexity classes.
                        function New-Password {
                            $characters = ''
                            while ($characters.Length -lt 32) {
                                $characters += [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48)) -replace '[/+=]', ''
                            }
                            return $characters.Substring(0, 32) + 'Aa9-'
                        }
                        # Writes a vault secret from a file of the private work folder, so the value never reaches a command line.
                        function Set-VaultSecret([string] $Vault, [string] $Name, [string] $Value) {
                            $file = Join-Path $work 'secret.txt'
                            [System.IO.File]::WriteAllText($file, $Value)
                            $PSNativeCommandUseErrorActionPreference = $false
                            az keyvault secret set --vault-name $Vault --name $Name --file $file --encoding utf-8 --output none
                            $written = $LASTEXITCODE -eq 0
                            Remove-Item -LiteralPath $file -Force
                            return $written
                        }
                        # Runs the T-SQL on standard input in pod db-0 of a namespace as sa, with the password of Secret db-sa mounted in the
                        # pod (what its probes and db-init use). The statements, passwords included, travel on standard input.
                        function Invoke-Sql([string] $Namespace, [string] $Statement) {
                            $PSNativeCommandUseErrorActionPreference = $false
                            $Statement | kubectl --namespace $Namespace exec -i db-0 -- /bin/bash -c 'SQLCMDPASSWORD="$(cat /etc/platform/db-sa/password)" /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -C -b -i /dev/stdin' | Out-Host
                            return $LASTEXITCODE -eq 0
                        }
                        # Logs in to db-0 as a login with its password on standard input and runs SELECT 1.
                        function Test-Login([string] $Namespace, [string] $Login, [string] $Secret) {
                            $PSNativeCommandUseErrorActionPreference = $false
                            $Secret | kubectl --namespace $Namespace exec -i db-0 -- /bin/bash -c ('read -r password; SQLCMDPASSWORD="$password" /opt/mssql-tools18/bin/sqlcmd -S localhost -U ' + $Login + ' -C -b -Q "SELECT 1" > /dev/null') | Out-Host
                            return $LASTEXITCODE -eq 0
                        }
                        # A new password for one login: into the vault first, then ALTER LOGIN as sa. When ALTER LOGIN fails, the vault gets
                        # the previous password back, so it holds the password that works. Returns the new password.
                        function Set-LoginPassword([string] $Namespace, [string] $Vault, [string] $Login, [string] $SecretName) {
                            $PSNativeCommandUseErrorActionPreference = $false
                            $old = @(az keyvault secret show --vault-name $Vault --name $SecretName --query value --output tsv) -join "`n"
                            $read = $LASTEXITCODE -eq 0
                            $PSNativeCommandUseErrorActionPreference = $true
                            if (-not $read) {
                                Fail-Step "Reading $SecretName from $Vault failed (see above); $Login is unchanged."
                            }
                            $new = New-Password
                            if (-not (Set-VaultSecret -Vault $Vault -Name $SecretName -Value $new)) {
                                Fail-Step "Writing $SecretName to $Vault failed; $Login is unchanged."
                            }
                            if (-not (Invoke-Sql -Namespace $Namespace -Statement "ALTER LOGIN [$Login] WITH PASSWORD = N'$new';")) {
                                if (-not (Set-VaultSecret -Vault $Vault -Name $SecretName -Value $old)) {
                                    Write-Warning "Could not put the previous $SecretName back into $Vault."
                                }
                                Fail-Step "ALTER LOGIN $Login failed in $Namespace; $Vault holds the previous password again."
                            }
                            return $new
                        }
                        # Forces ESO to sync an ExternalSecret now and waits up to 3 minutes for its Secret to change. Returns 'absent' when
                        # the ExternalSecret does not exist, 'changed' or 'unchanged'.
                        function Sync-ExternalSecret([string] $Namespace, [string] $Name) {
                            $PSNativeCommandUseErrorActionPreference = $false
                            kubectl --namespace $Namespace get externalsecret $Name --output name *> $null
                            if ($LASTEXITCODE -ne 0) {
                                return 'absent'
                            }
                            $before = @(kubectl --namespace $Namespace get secret $Name --output 'jsonpath={.metadata.resourceVersion}' 2>$null) -join ''
                            $PSNativeCommandUseErrorActionPreference = $true
                            kubectl --namespace $Namespace annotate externalsecret $Name "force-sync=$([DateTimeOffset]::UtcNow.ToUnixTimeSeconds())" --overwrite | Out-Null
                            $PSNativeCommandUseErrorActionPreference = $false
                            foreach ($attempt in 1..18) {
                                $after = @(kubectl --namespace $Namespace get secret $Name --output 'jsonpath={.metadata.resourceVersion}' 2>$null) -join ''
                                if ($after -and $after -cne $before) {
                                    return 'changed'
                                }
                                Start-Sleep -Seconds 10
                            }
                            Write-Warning "Secret $Namespace/$Name did not change within 3 minutes of the forced sync."
                            return 'unchanged'
                        }
                        # The app's own Deployments in one environment: those that the workload Applications of the tenant chart list in
                        # their status, in the app's namespaces. Pairs of namespace and name.
                        function Get-AppDeployment([string] $Environment, [string[]] $Namespaces) {
                            $listing = @(kubectl get applications.argoproj.io --namespace argocd --selector "platform/app=$app,environment=$Environment,platform/role=workload" --output json) -join "`n"
                            $deployments = [System.Collections.Generic.List[object]]::new()
                            foreach ($application in @((ConvertFrom-Json -InputObject $listing -AsHashtable)['items'])) {
                                if ($application -isnot [System.Collections.IDictionary] -or $application['status'] -isnot [System.Collections.IDictionary]) {
                                    continue
                                }
                                foreach ($resource in @($application['status']['resources'])) {
                                    if ($resource -is [System.Collections.IDictionary] -and $resource['group'] -ceq 'apps' -and $resource['kind'] -ceq 'Deployment' -and $Namespaces -ccontains $resource['namespace'] -and @($deployments | Where-Object { $_.Namespace -ceq $resource['namespace'] -and $_.Name -ceq $resource['name'] }).Count -eq 0) {
                                        $deployments.Add([pscustomobject] @{ Namespace = [string] $resource['namespace']; Name = [string] $resource['name'] })
                                    }
                                }
                            }
                            return , $deployments.ToArray()
                        }
                        $rotated = @()
                        foreach ($environment in $environments) {
                            $namespace = "$app-$environment"
                            $PSNativeCommandUseErrorActionPreference = $false
                            kubectl get namespace $namespace --output name *> $null
                            $namespaceFound = $LASTEXITCODE -eq 0
                            $PSNativeCommandUseErrorActionPreference = $true
                            if (-not $namespaceFound) {
                                Write-Warning "Namespace $namespace does not exist: $app has no database in $environment."
                                continue
                            }
                            $PSNativeCommandUseErrorActionPreference = $false
                            kubectl --namespace $namespace get pod db-0 --output name | Out-Null
                            $podFound = $LASTEXITCODE -eq 0
                            $PSNativeCommandUseErrorActionPreference = $true
                            if (-not $podFound) {
                                Fail-Step "Pod $namespace/db-0 was not found: $app declares no database, or it is not running."
                            }
                            $hash4 = [System.Convert]::ToHexString([System.Security.Cryptography.SHA1]::HashData([System.Text.Encoding]::UTF8.GetBytes("$subscription/$app/$environment"))).Substring(0, 4).ToLowerInvariant()
                            $vault = "kv-$app-$($environment.Substring(0, 1))-$hash4"
                            # Every change below runs as sa with the mounted password of Secret db-sa: check it first, while nothing changed.
                            $PSNativeCommandUseErrorActionPreference = $false
                            kubectl --namespace $namespace exec db-0 -- /bin/bash -c 'SQLCMDPASSWORD="$(cat /etc/platform/db-sa/password)" /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -C -b -Q "SELECT 1" > /dev/null'
                            $saWorks = $LASTEXITCODE -eq 0
                            $PSNativeCommandUseErrorActionPreference = $true
                            if (-not $saWorks) {
                                Fail-Step "sa cannot log in to $namespace/db-0 with the password of Secret db-sa mounted in the pod (what its probes use); nothing was rotated in $environment."
                            }
                            foreach ($role in @('migrator', 'app')) {
                                $login = "$($app)_$role"
                                $secretName = "db-$role-password"
                                $new = Set-LoginPassword -Namespace $namespace -Vault $vault -Login $login -SecretName $secretName
                                if ($role -ceq 'app' -and -not (Test-Login -Namespace $namespace -Login $login -Secret $new)) {
                                    Fail-Step "Login check failed for $login in $namespace after rotation; $vault holds the new password."
                                }
                                Write-Host "Rotated $login in $namespace; $secretName updated in $vault."
                            }
                            # Refresh the synced Secrets and restart the app's own Deployments in every namespace of this app-environment.
                            $appNamespaces = @((@(kubectl get namespace --selector "platform/app=$app,environment=$environment" --output 'jsonpath={.items[*].metadata.name}') -join ' ') -split '\s+' | Where-Object { $_ })
                            if ($appNamespaces.Count -eq 0) {
                                $appNamespaces = @($namespace)
                            }
                            $deployments = Get-AppDeployment -Environment $environment -Namespaces $appNamespaces
                            if ($deployments.Count -eq 0) {
                                Write-Warning "No Deployment of $app in $environment to restart: no workload Application (labels platform/app=$app, environment=$environment, platform/role=workload) lists one in $($appNamespaces -join ', ')."
                            }
                            foreach ($appNamespace in $appNamespaces) {
                                foreach ($secret in @('db-migrator', 'db-app')) {
                                    Sync-ExternalSecret -Namespace $appNamespace -Name $secret | Out-Null
                                }
                                $names = @($deployments | Where-Object { $_.Namespace -ceq $appNamespace } | ForEach-Object { "deployment.apps/$($_.Name)" })
                                if ($names.Count -eq 0) {
                                    continue
                                }
                                kubectl --namespace $appNamespace rollout restart @names | Out-Null
                                foreach ($deployment in $names) {
                                    $PSNativeCommandUseErrorActionPreference = $false
                                    kubectl --namespace $appNamespace rollout status $deployment --timeout=600s
                                    $rolledOut = $LASTEXITCODE -eq 0
                                    $PSNativeCommandUseErrorActionPreference = $true
                                    if (-not $rolledOut) {
                                        Fail-Step "$appNamespace/$deployment did not roll out within 10 minutes after the rotation."
                                    }
                                }
                            }
                            # sa last: every change above ran as sa.
                            $newSa = Set-LoginPassword -Namespace $namespace -Vault $vault -Login 'sa' -SecretName 'db-sa-password'
                            $saChecked = Test-Login -Namespace $namespace -Login 'sa' -Secret $newSa
                            # The Secrets of the sa password: db-sa, which the StatefulSet mounts for its probes and db-init, and
                            # db-sa-<app>-<env> of the backup Jobs in platform-backup. Refreshed even when the login check failed: the login
                            # already has the new password.
                            foreach ($appNamespace in @($namespace) + @($appNamespaces | Where-Object { $_ -cne $namespace })) {
                                if ((Sync-ExternalSecret -Namespace $appNamespace -Name 'db-sa') -ceq 'changed' -and $appNamespace -ceq $namespace) {
                                    # An update of the pod makes the kubelet remount its Secret volumes now instead of at its next periodic
                                    # sync, so the probes read the new sa password within seconds.
                                    $PSNativeCommandUseErrorActionPreference = $false
                                    kubectl --namespace $namespace annotate pod db-0 "platform/db-sa-synced-at=$([DateTimeOffset]::UtcNow.ToUnixTimeSeconds())" --overwrite | Out-Null
                                    if ($LASTEXITCODE -ne 0) {
                                        Write-Warning "Could not annotate $namespace/db-0; its probes read the new sa password after the kubelet's next sync."
                                    }
                                    $PSNativeCommandUseErrorActionPreference = $true
                                }
                            }
                            Sync-ExternalSecret -Namespace 'platform-backup' -Name "db-sa-$app-$environment" | Out-Null
                            if (-not $saChecked) {
                                Fail-Step "Login check failed for sa in $namespace after rotation; $vault holds the new password."
                            }
                            Write-Host "Rotated sa in $namespace; db-sa-password updated in $vault."
                            $rotated += $environment
                        }
                        if ($rotated.Count -eq 0) {
                            Fail-Step "$app has no database in tier $class; nothing was rotated."
                        }
                        Write-Highlight "Database passwords of $app rotated in: $($rotated -join ' ')."
                    }
                    finally {
                        Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
                    }
                    exit 0
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
            }
        }
    }
}
