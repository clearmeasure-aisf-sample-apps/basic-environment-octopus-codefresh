// Runbook `rotate-db-passwords` of project `platform-infrastructure` (renamed from rotate-sql-passwords;
// ADR-IR34 §11.8). Environments: infra-nonprod (tdd, uat), infra-prod (prod). Prompted App.Name; run by hand.
// Order per login: new password into the app vault -> ALTER LOGIN in the database pod (on failure the vault gets
// the previous value back) -> login check -> forced ESO refresh -> restart of the app's Deployments.
// Passwords never appear in process arguments: they travel through files and stdin.

name = "rotate-db-passwords"
description = "Rotates the SQL logins <app>_migrator and <app>_app of the prompted App.Name in the tier of the environment."
default_guided_failure_mode = "EnvironmentDefault"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    // Sleep/wake (ADR-IR33): run env-wake in this environment through the Octopus REST API and wait for it first.
    // The key is the step-scoped Platform.OctopusApiKey (octopus/terraform/library-variable-sets.tf, S5).
    // The rotation runs kubectl against the cluster.
    step "wake-environment" {
        name = "Wake environment"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu -o pipefail
                    # Sleep/wake (ADR-IR33): wake the cluster of this infrastructure environment before anything needs it, through
                    # runbook env-wake and the step-scoped key (S5). Fails while the cluster does not exist: run env-apply first.
                    caller_environment="#{Octopus.Environment.Name}"
                    target="$caller_environment"
                    class="#{Environment.Class}"
                    case "$class" in
                        nonprod|prod) ;;
                        *) fail_step "Environment.Class '$class' must be nonprod or prod (library variable set Platform Infrastructure)." ;;
                    esac
                    cluster="aks-platform-$class"
                    rg="rg-platform-$class-aks"
                    if ! err="$(az aks show --resource-group "$rg" --name "$cluster" --output none 2>&1)"; then
                        case "$err" in
                            *ResourceNotFound*|*ResourceGroupNotFound*|*"was not found"*)
                                fail_step "Cluster $cluster does not exist: run env-apply in $caller_environment first." ;;
                            *) fail_step "Cannot read cluster $cluster: $err" ;;
                        esac
                    fi
                    octopus_url="$(printf '%s' "#{Octopus.Web.ServerUri}" | sed 's#/*$##')"
                    space_id="#{Octopus.Space.Id}"
                    api_key="$(get_octopusvariable "Platform.OctopusApiKey")"
                    [ -n "$api_key" ] || fail_step "Platform.OctopusApiKey is empty in this step: octopus/terraform scopes it to the REST-calling steps of platform-infrastructure (S5)."
                    command -v jq >/dev/null 2>&1 || fail_step "jq is missing from the step container."
                    # Octopus REST call; prints the response body. The key reaches curl through its configuration on stdin, never
                    # through the process arguments. Usage: octopus_api METHOD PATH [JSON-BODY]
                    octopus_api() {
                        if [ "$#" -ge 3 ]; then
                            printf 'header = "X-Octopus-ApiKey: %s"\n' "$api_key" |
                                curl --config - --fail --silent --show-error --max-time 60 --request "$1" \
                                    --header "Accept: application/json" --header "Content-Type: application/json" --data "$3" "$octopus_url$2"
                        else
                            printf 'header = "X-Octopus-ApiKey: %s"\n' "$api_key" |
                                curl --config - --fail --silent --show-error --max-time 60 --request "$1" \
                                    --header "Accept: application/json" "$octopus_url$2"
                        fi
                    }
                    # lookup COLLECTION NAME sets found_id to the id of the only item of that name in this space, or fails the step.
                    lookup() {
                        listing="$(octopus_api GET "/api/$space_id/$1?partialName=$2&take=100")" ||
                            fail_step "Octopus REST call for $1 '$2' failed; check Platform.OctopusApiKey."
                        found_id="$(printf '%s' "$listing" | jq -r --arg name "$2" '[.Items[] | select(.Name == $name)] | if length == 1 then .[0].Id else "" end')" || found_id=""
                        [ -n "$found_id" ] || fail_step "No single item named '$2' in $1 of space $space_id."
                    }
                    lookup projects platform-infrastructure
                    project_id="$found_id"
                    lookup environments "$target"
                    environment_id="$found_id"
                    payload="$(jq -n --arg env "$environment_id" '{SelectedPackages: [], SelectedGitResources: [], Runs: [{EnvironmentId: $env, TenantId: null, SkipActions: [], SpecificMachineIds: [], ExcludedMachineIds: []}]}')"
                    # Config-as-code runbook run from the default branch (route runGitRunbookV1; OctopusDeploy-Api sample
                    # REST/PowerShell/Runbooks/RunConfigAsCodeRunbook.ps1). The response carries Resources[].TaskId.
                    response="$(octopus_api POST "/api/spaces/$space_id/projects/$project_id/refs%2Fheads%2Fmain/runbooks/env-wake/run/v1" "$payload")" ||
                        fail_step "Octopus refused to run env-wake in $target."
                    task_id="$(printf '%s' "$response" | jq -r '[.. | objects | (.TaskId? // .ServerTaskId? // empty) | strings] | first // ""')"
                    [ -n "$task_id" ] || fail_step "Octopus returned no task for env-wake in $target: $response"
                    echo "env-wake is running in $target: $octopus_url/app#/$space_id/tasks/$task_id"
                    # Task cap (5 slots for the whole instance): a waking deployment holds three, its own task, this one and env-wake.
                    # env-wake never starts a fourth task and waits for it. Ceiling: Wake.TimeoutMinutes plus queueing.
                    deadline=$(( $(date +%s) + 3600 ))
                    while :; do
                        task="$(octopus_api GET "/api/$space_id/tasks/$task_id")" || task=""
                        if [ -n "$task" ] && [ "$(printf '%s' "$task" | jq -r '.IsCompleted')" = "true" ]; then
                            if [ "$(printf '%s' "$task" | jq -r '.FinishedSuccessfully')" = "true" ]; then
                                write_highlight "The cluster of $caller_environment is awake (env-wake in $target, $task_id)."
                                exit 0
                            fi
                            fail_step "env-wake in $target ended $(printf '%s' "$task" | jq -r '.State'): $(printf '%s' "$task" | jq -r '.ErrorMessage // ""')"
                        fi
                        [ "$(date +%s)" -lt "$deadline" ] || fail_step "env-wake in $target ($task_id) did not finish within 60 minutes."
                        sleep 15
                    done
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:<worker-tools-version>"
            }
        }
    }

    // Validates the prompted App.Name before it reaches any Terraform argument.
    step "guard-app" {
        name = "Guard app"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu
                    app="#{App.Name}"
                    environment="#{Octopus.Environment.Name}"
                    class="#{Environment.Class}"
                    ref="#{Octopus.RunbookRun.Git.Ref}"
                    # ADR-IR34 decision 10: 3 to 12 characters, no dash, no reserved word. The layer reads apps/<App.Name>.yaml itself.
                    printf '%s' "$app" | grep -Eq '^[a-z][a-z0-9]{2,11}$' || fail_step "App.Name '$app' is not an app slug (^[a-z][a-z0-9]{2,11}$)."
                    case "$app" in
                        apps|argo|argocd|cert|default|external|infra|kube|kyverno|octopus|platform|system)
                            fail_step "App.Name '$app' is a reserved word (ADR-IR34 decision 10)." ;;
                    esac
                    case "$environment:$class" in
                        infra-nonprod:nonprod|infra-prod:prod) ;;
                        *) fail_step "Environment.Class '$class' does not match environment '$environment' (library variable set Platform Infrastructure)." ;;
                    esac
                    if [ "$ref" != "refs/heads/main" ]; then
                        if [ "$environment" = "infra-prod" ]; then
                            fail_step "infra-prod runs only from refs/heads/main (this run: '$ref')."
                        fi
                        write_warning "Running unmerged configuration from '$ref' in $environment."
                    fi
                    write_highlight "App $app, tier $class, from $ref (state apps-$app.tfstate)."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rotate" {
        name = "Rotate database passwords"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu -o pipefail
                    # Rotates the SQL logins <app>_migrator and <app>_app of every app-environment of this tier (ADR-IR34 decision 8;
                    # CAP-AZ-011): new password into the app vault, ALTER LOGIN inside the database pod, a forced ESO refresh, then a
                    # restart of the app's Deployments so new connections use the new password. sa is not rotated here
                    # (docs/runbooks/credential-rotation.md). Runs as the tier's lifecycle identity (Key Vault Secrets Officer on
                    # rg-platform-<tier>-apps, AKS RBAC Cluster Admin on the cluster) through kubectl with Entra ID tokens.
                    # Names from the platform database component [VERIFY against gitops/platform/components/db/mssql-2022-express]:
                    # pod db-0 of StatefulSet db in <app>-<env>, variable MSSQL_SA_PASSWORD in its container, sqlcmd at
                    # /opt/mssql-tools18/bin/sqlcmd, ExternalSecrets db-migrator and db-app, namespace labels platform/app and environment.
                    app="#{App.Name}"
                    class="#{Environment.Class}"
                    printf '%s' "$app" | grep -Eq '^[a-z][a-z0-9]{2,11}$' || fail_step "App.Name '$app' is not an app slug."
                    case "$class" in
                        nonprod) environments="tdd uat" ;;
                        prod) environments="prod" ;;
                        *) fail_step "Environment.Class '$class' must be nonprod or prod." ;;
                    esac
                    cluster="aks-platform-$class"
                    rg="rg-platform-$class-aks"
                    subscription="$(az account show --query id --output tsv)"
                    work="$(mktemp -d)"
                    chmod 700 "$work"
                    trap 'rm -rf "$work"' EXIT
                    export KUBECONFIG="$work/kubeconfig"
                    az aks get-credentials --resource-group "$rg" --name "$cluster" --file "$KUBECONFIG" --overwrite-existing --only-show-errors
                    if ! command -v kubectl >/dev/null 2>&1 || ! command -v kubelogin >/dev/null 2>&1; then
                        # [VERIFY whether the worker-tools image ships kubelogin]
                        az aks install-cli --install-location "$work/bin/kubectl" --kubelogin-install-location "$work/bin/kubelogin" --only-show-errors >/dev/null
                        PATH="$work/bin:$PATH"
                    fi
                    # Entra ID tokens only: local accounts are off (ADR-IR34), and the Azure CLI login of this step is the identity.
                    kubelogin convert-kubeconfig --login azurecli --kubeconfig "$KUBECONFIG"
                    # 32 random base64 characters without symbols, plus a suffix that guarantees the SQL Server complexity classes.
                    new_password() { printf '%sAa9-' "$(head -c 48 /dev/urandom | base64 | tr -d '\n/+=' | cut -c1-32)"; }
                    kv_set() {
                        printf '%s' "$3" > "$work/secret.txt"
                        az keyvault secret set --vault-name "$1" --name "$2" --file "$work/secret.txt" --encoding utf-8 --output none || return 1
                        rm -f "$work/secret.txt"
                    }
                    # sql NAMESPACE runs the T-SQL on stdin in pod db-0 as sa; the statements, passwords included, travel on stdin.
                    sql() {
                        # shellcheck disable=SC2016  # expanded inside the pod
                        kubectl --namespace "$1" exec -i db-0 -- /bin/bash -c 'SQLCMDPASSWORD="$MSSQL_SA_PASSWORD" /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -C -b -i /dev/stdin'
                    }
                    rotated=""
                    for environment in $environments; do
                        namespace="$app-$environment"
                        if ! kubectl get namespace "$namespace" --output name >/dev/null 2>&1; then
                            write_warning "Namespace $namespace does not exist: $app has no database in $environment."
                            continue
                        fi
                        kubectl --namespace "$namespace" get pod db-0 --output name >/dev/null ||
                            fail_step "Pod $namespace/db-0 was not found: $app declares no database, or it is not running."
                        hash4="$(printf '%s' "$subscription/$app/$environment" | sha1sum | cut -c1-4)"
                        vault="kv-$app-$(printf '%s' "$environment" | cut -c1)-$hash4"
                        for role in migrator app; do
                            login="$app"_"$role"
                            secret_name="db-$role-password"
                            old="$(az keyvault secret show --vault-name "$vault" --name "$secret_name" --query value --output tsv)"
                            new="$(new_password)"
                            kv_set "$vault" "$secret_name" "$new" || fail_step "Writing $secret_name to $vault failed; $login is unchanged."
                            if ! printf "ALTER LOGIN [%s] WITH PASSWORD = N'%s';\n" "$login" "$new" | sql "$namespace"; then
                                kv_set "$vault" "$secret_name" "$old" || write_warning "Could not put the previous $secret_name back into $vault."
                                fail_step "ALTER LOGIN $login failed in $namespace; $vault holds the previous password again."
                            fi
                            if [ "$role" = "app" ]; then
                                # shellcheck disable=SC2016  # expanded inside the pod
                                printf '%s\n' "$new" | kubectl --namespace "$namespace" exec -i db-0 -- /bin/bash -c \
                                    'read -r password; SQLCMDPASSWORD="$password" /opt/mssql-tools18/bin/sqlcmd -S localhost -U '"$login"' -C -b -Q "SELECT 1" > /dev/null' ||
                                    fail_step "Login check failed for $login in $namespace after rotation; $vault holds the new password."
                            fi
                            echo "Rotated $login in $namespace; $secret_name updated in $vault."
                        done
                        # Refresh the synced Secrets and restart the app's Deployments in every namespace of this app-environment.
                        app_namespaces="$(kubectl get namespace --selector "platform/app=$app,environment=$environment" --output jsonpath='{.items[*].metadata.name}')"
                        [ -n "$app_namespaces" ] || app_namespaces="$namespace"
                        for app_namespace in $app_namespaces; do
                            for secret in db-migrator db-app; do
                                kubectl --namespace "$app_namespace" get externalsecret "$secret" --output name >/dev/null 2>&1 || continue
                                before="$(kubectl --namespace "$app_namespace" get secret "$secret" --output 'jsonpath={.metadata.resourceVersion}' 2>/dev/null || true)"
                                kubectl --namespace "$app_namespace" annotate externalsecret "$secret" "force-sync=$(date +%s)" --overwrite >/dev/null
                                refreshed="false"
                                for _ in $(seq 1 18); do
                                    after="$(kubectl --namespace "$app_namespace" get secret "$secret" --output 'jsonpath={.metadata.resourceVersion}' 2>/dev/null || true)"
                                    if [ -n "$after" ] && [ "$after" != "$before" ]; then
                                        refreshed="true"
                                        break
                                    fi
                                    sleep 10
                                done
                                [ "$refreshed" = "true" ] || write_warning "Secret $app_namespace/$secret did not change within 3 minutes of the forced sync."
                            done
                            deployments="$(kubectl --namespace "$app_namespace" get deployment --output name)"
                            [ -n "$deployments" ] || continue
                            kubectl --namespace "$app_namespace" rollout restart deployment >/dev/null
                            for deployment in $deployments; do
                                kubectl --namespace "$app_namespace" rollout status "$deployment" --timeout=600s ||
                                    fail_step "$app_namespace/$deployment did not roll out within 10 minutes after the rotation."
                            done
                        done
                        rotated="$rotated $environment"
                    done
                    [ -n "$rotated" ] || fail_step "$app has no database in tier $class; nothing was rotated."
                    write_highlight "Database passwords of $app rotated in:$rotated."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:<worker-tools-version>"
            }
        }
    }
}
