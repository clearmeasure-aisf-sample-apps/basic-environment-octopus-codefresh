variable "Azure.LifecycleAccount" {
    type = "AzureAccount"

    value "azure-platform-lifecycle-nonprod" {
        environment = ["infra-nonprod"]
    }
    value "azure-platform-lifecycle-prod" {
        environment = ["infra-prod"]
    }
}

variable "Sleep.Enabled" {
    value "true" {
        environment = ["infra-nonprod"]
    }
    value "true" {
        environment = ["infra-prod"]
    }
}

variable "Sleep.TimeZone" {
    value "America/Chicago" {
        environment = ["infra-nonprod"]
    }
    value "America/Chicago" {
        environment = ["infra-prod"]
    }
}

variable "Sleep.WorkDays" {
    value "Mon,Tue,Wed,Thu,Fri" {
        environment = ["infra-nonprod"]
    }
    value "Mon,Tue,Wed,Thu,Fri" {
        environment = ["infra-prod"]
    }
}

variable "Sleep.WorkdayStart" {
    value "07:00" {
        environment = ["infra-nonprod"]
    }
    value "07:00" {
        environment = ["infra-prod"]
    }
}

variable "Sleep.WorkdayEnd" {
    value "19:00" {
        environment = ["infra-nonprod"]
    }
    value "19:00" {
        environment = ["infra-prod"]
    }
}

variable "Sleep.IdleMinutes" {
    value "120" {
        environment = ["infra-nonprod"]
    }
    value "120" {
        environment = ["infra-prod"]
    }
}

variable "Wake.TimeoutMinutes" {
    value "20" {
        environment = ["infra-nonprod"]
    }
    value "20" {
        environment = ["infra-prod"]
    }
}

variable "Sleep.Force" {
    value "false" {
        prompt {
            label = "Force sleep"
            description = "true stops the cluster now, skipping the working-window and idle checks. A queued or executing deployment or runbook run still prevents the stop."
            required = false
        }
    }
}

variable "Sleep.DryRun" {
    value "false" {
        prompt {
            label = "Dry run"
            description = "true decides and logs the decision (Sleep.Decision) but never stops the cluster."
            required = false
        }
    }
}

variable "Sleep.NowOverride" {
    value "" {
        prompt {
            label = "Simulated time (dry run only)"
            description = "ISO 8601 date and time used as now by the working-window and idle rules, for example 2026-09-24T23:30:00-05:00. Ignored unless Dry run is true."
            required = false
        }
    }
}

variable "App.Name" {
    value "" {
        prompt {
            label = "App"
            description = "App slug as in apps/<app>.yaml, for example workorders or sandbox."
            required = false
        }
    }
}

variable "Octopus.Task.ConcurrencyTag" {
    value "#{Octopus.Environment.Id}/#{Octopus.Runbook.Name | Replace ^env-(wake|sleep)$ cluster-power}" {}
}
