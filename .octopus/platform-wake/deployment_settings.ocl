// Project `platform-wake` (platform-owned; ADR-IR33, ADR-IR34 decision 17). octopus/terraform creates the project
// (group Platform, lifecycle platform-wake: tdd, uat and prod in one phase, any order), includes library variable
// set Platform Automation and points it at this folder. It has no runbooks.
// Releases: 0.0.<n>, created from main after each change to this folder and before the first app release
// (docs/preview-octopus.md: POST /api/<space>/releases/create/v1). App releases pick the latest by creation time.
// Comments are authoring notes only; the Octopus serializer drops them on the next save from the UI.

// The only step runs on the dynamic pool hosted-ubuntu; no deployment targets.
connectivity_policy {
    allow_deployments_to_no_targets = true
}

// Release numbers 0.0.1, 0.0.2, ... (the Octopus default, written out).
versioning_strategy {
    template = "#{Octopus.Version.LastMajor}.#{Octopus.Version.LastMinor}.#{Octopus.Version.NextPatch}"
}
