// Project `workorders` (app #1; config as code at .octopus/apps/workorders/workorders, ADR-IR34 §7.0).
// Comments are authoring notes only; the Octopus serializer drops them on the next save from the UI.
//
// Release notes and the `app-commit:` contract (§7.7): Codefresh passes RELEASE_NOTES whose first line is
// `app-commit: <sha>`; this template serves releases created in the UI (channel Hotfix) and rebuilds the same
// line from the build information that Codefresh pushes (VcsCommitNumber = app commit).
release_notes_template = <<-EOT
    app-commit: #{Octopus.Release.Builds[0].VcsCommitNumber}
    
    Release #{Octopus.Release.Number} of #{Octopus.Project.Name}
    
    ## Builds
    #{each build in Octopus.Release.Builds}
    - [#{build.BuildNumber}](#{build.BuildUrl}) from #{build.Branch} at #{build.VcsCommitNumber}
    #{/each}
    
    ## Packages and commits
    #{each package in Octopus.Release.Package}
    - #{package.PackageId} #{package.Version}
    #{each commit in package.Commits}
      - [#{commit.CommitId}](#{commit.LinkUrl}) #{commit.Comment}
    #{/each}
    #{/each}
    EOT

// No deployment targets: every step runs on a worker pool or through the Argo CD gateway.
connectivity_policy {
    allow_deployments_to_no_targets = true
}

// Default release number = the ui-server package version (§7.5, §7.6).
versioning_strategy {
    donor_package {
        step = "update-argo-cd-image-tags"
        package = "ui-server"
    }
}
