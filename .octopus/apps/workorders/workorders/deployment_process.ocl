step "wake-environment" {
    name = "Wake environment"
    condition = "Variable"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Wake.Skip == \"true\"}False#{else}True#{/if}#{/unless}"
    }

    action {
        action_type = "Octopus.DeployRelease"
        is_required = true
        environments = ["tdd", "uat", "prod"]
        properties = {
            Octopus.Action.DeployRelease.DeploymentCondition = "Always"
            Octopus.Action.DeployRelease.ProjectId = "platform-wake"
        }
    }
}

step "hotfix-justification" {
    name = "Hotfix justification"
    condition = "Variable"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Octopus.Release.Channel.Name == \"Hotfix\"}#{if Platform.ApprovalsRequired == \"false\"}False#{else}True#{/if}#{/if}#{/unless}"
    }

    action {
        action_type = "Octopus.Manual"
        is_required = true
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = <<-EOT
                ## Hotfix justification (channel Hotfix, lifecycle platform-hotfix)
                This release skips TDD and its checks. Record in **Notes**:
                1. The incident or defect reference and the business impact.
                2. Why the Default channel (TDD, then UAT) is too slow for this fix.
                3. The rollback plan: redeploy the previous release of this environment.
                
                Confirm the release number reads `<package-version>-hotfix.<n>` and that the selected images are
                default-branch builds already verified in TDD or UAT.
                    EOT
            Octopus.Action.Manual.ResponsibleTeamIds = "release-managers"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

step "prod-go-no-go" {
    name = "Prod go/no-go"
    condition = "Variable"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Platform.ApprovalsRequired == \"false\"}False#{else}True#{/if}#{/unless}"
    }

    action {
        action_type = "Octopus.Manual"
        is_required = true
        environments = ["prod"]
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = <<-EOT
                ## Prod go/no-go for release #{Octopus.Release.Number}
                Proceed only when all of these hold:
                - UAT sign-off exists for this release (or the Hotfix justification is recorded).
                - The release notes and linked commits match the change announced to users.
                - No deployment freeze override is pending without a recorded reason.
                - Migrations in this release are backward compatible (rollback redeploys older images).
                
                Write the reason for your decision in **Notes**. The separation-of-duties guard applies Platform.SoDMode:
                single-operator lets the creator approve with a reason; enforce does not. The automation user may answer only
                in intervention test mode, with the reason conformance:<run-id> or e2e:<run-id>.
                The next steps back up the database, then commit the image tags.
                    EOT
            Octopus.Action.Manual.ResponsibleTeamIds = "prod-approvers"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

step "sod-guard" {
    name = "Separation-of-duties guard"
    condition = "Variable"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Platform.ApprovalsRequired == \"false\"}False#{else}True#{/if}#{/unless}"
    }

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["prod"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Step template platform-sod-guard, inlined (ADR-IR34): the lines between the markers are
                # octopus/step-templates/sod-guard.ps1 verbatim, checked by the offline drift test. The script block runs them with
                # these inputs:
                $sodGuardInputs = @{
                    ApprovalStep = 'Prod go/no-go'
                    OtherSteps   = 'Hotfix justification'
                    CheckCreator = 'true'
                }
                & {
                    # >>> octopus/step-templates/sod-guard.ps1
                    #!/usr/bin/env pwsh
                    #Requires -Version 7.4

                    <#
                    .SYNOPSIS
                        platform-sod-guard: separation of duties and the intervention test mode for one manual intervention
                        (ADR-IR34 decision 23, ADR-IR32; capabilities CAP-OCT-004 and CAP-OCT-005).
                
                    .DESCRIPTION
                        octopus/terraform creates step template platform-sod-guard from this file; the parameters default to the template
                        parameters SodGuard.*. App processes may also inline it: the lines between
                        "# >>> octopus/step-templates/sod-guard.ps1" and "# <<< octopus/step-templates/sod-guard.ps1" must equal this file
                        (offline drift test in tests/Platform.Conformance.Offline/Octopus/), inside a script block that the step calls with
                        its inputs. Octopus runs it with the PowerShell script functions ($OctopusParameters, Set-OctopusVariable,
                        Fail-Step, Write-Highlight). No dollar-brace or percent-brace sequences (OCL heredoc template syntax) and no
                        hash-brace sequences (Octopus variable substitution).
                
                        Octopus variables, from library variable set Platform Environment (a project may override them by scope, as the
                        sandbox channel Strict does for Platform.SoDMode):
                          Platform.SoDMode              single-operator (default): the deployment creator may approve, with a reason in
                                                        Notes; enforce: the creator may not approve
                          Platform.InterventionTestMode true: the automation user may answer, only with the reason
                                                        conformance:<run-id> or e2e:<run-id>; anything else: it may not answer
                          Platform.AutomationUsername   the automation user (AISF-Service-Account), compared case-insensitively
                        Manual intervention outputs are addressed by step name (Octopus.Action[<step name>].Output.Manual.*, ADR-IR22).
                
                    .PARAMETER ApprovalStep
                        Name of the manual intervention whose answer is checked, for example "Prod go/no-go" (SodGuard.ApprovalStep).
                
                    .PARAMETER OtherSteps
                        Comma-separated names of other interventions of the deployment; checked only for answers by the automation user;
                        interventions that did not run are skipped (SodGuard.OtherSteps).
                
                    .PARAMETER CheckCreator
                        "true": the Platform.SoDMode rule applies to the approval step (SodGuard.CheckCreator).
                
                    .OUTPUTS
                        Octopus output variables SodGuard.Result, SodGuard.Approver and SodGuard.Reason. A rule that does not hold fails
                        the step (Fail-Step).
                    #>
                    [CmdletBinding()]
                    param(
                        [string]$ApprovalStep = $OctopusParameters['SodGuard.ApprovalStep'],
                        [string]$OtherSteps = $OctopusParameters['SodGuard.OtherSteps'],
                        [string]$CheckCreator = $OctopusParameters['SodGuard.CheckCreator']
                    )
                
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                
                    # The first line of a text without surrounding blanks (space, tab, CR, LF, VT, FF).
                    function Get-SodFirstLine([string]$Text) {
                        return ($Text -split "`n", 2)[0].Trim([char[]]" `t`r`n`v`f")
                    }
                
                    function Get-SodManualOutput([string]$Step, [string]$Name) {
                        return [string]$OctopusParameters["Octopus.Action[$Step].Output.Manual.$Name"]
                    }
                
                    # The automation user answers only in intervention test mode, and only with a run reason in the first line of Notes.
                    function Assert-SodAutomationAnswer([string]$Step, [string]$Username, [string]$Notes) {
                        if ($Username.ToLowerInvariant() -cne $automation) {
                            return
                        }
                        if ($testMode -cne 'true') {
                            Fail-Step "Separation of duties: '$Step' was answered by the automation user $Username while Platform.InterventionTestMode is not true."
                        }
                        $automationReason = Get-SodFirstLine $Notes
                        if ($automationReason -cnotmatch '^(conformance|e2e):[A-Za-z0-9._-]+$') {
                            Fail-Step "Separation of duties: the automation user answered '$Step' without the reason conformance:<run-id> or e2e:<run-id> (Notes: '$automationReason')."
                        }
                        Write-Highlight "'$Step' was answered by the automation user in intervention test mode: $automationReason"
                    }
                
                    $creatorRule = $CheckCreator.ToLowerInvariant()
                    if (-not $ApprovalStep) {
                        Fail-Step 'SodGuard.ApprovalStep (-ApprovalStep) is empty; failing closed.'
                    }
                
                    $mode = ([string]$OctopusParameters['Platform.SoDMode']).ToLowerInvariant()
                    if (-not $mode) {
                        $mode = 'single-operator'
                    }
                    if ($mode -cnotin 'single-operator', 'enforce') {
                        Fail-Step "Platform.SoDMode must be single-operator or enforce, not '$mode'."
                    }
                    $testMode = ([string]$OctopusParameters['Platform.InterventionTestMode']).ToLowerInvariant()
                    $automation = ([string]$OctopusParameters['Platform.AutomationUsername']).ToLowerInvariant()
                    if (-not $automation) {
                        Fail-Step 'Platform.AutomationUsername is empty (library variable set Platform Environment); failing closed.'
                    }
                
                    $approverId = Get-SodManualOutput $ApprovalStep 'ResponsibleUser.Id'
                    $approver = Get-SodManualOutput $ApprovalStep 'ResponsibleUser.Username'
                    $notes = Get-SodManualOutput $ApprovalStep 'Notes'
                    if (-not $approverId) {
                        Fail-Step "No answer is recorded for '$ApprovalStep'; failing closed."
                    }
                    Assert-SodAutomationAnswer $ApprovalStep $approver $notes
                
                    foreach ($item in $OtherSteps -split '[,\n]') {
                        $other = Get-SodFirstLine $item
                        if (-not $other) {
                            continue
                        }
                        $otherUser = Get-SodManualOutput $other 'ResponsibleUser.Username'
                        if (-not $otherUser) {
                            continue
                        }
                        Assert-SodAutomationAnswer $other $otherUser (Get-SodManualOutput $other 'Notes')
                    }
                
                    $reason = Get-SodFirstLine $notes
                    if ($creatorRule -ceq 'true') {
                        $creatorId = [string]$OctopusParameters['Octopus.Deployment.CreatedBy.Id']
                        if (-not $creatorId) {
                            Fail-Step 'Cannot read the creator of this deployment; failing closed.'
                        }
                        if ($approverId -ceq $creatorId) {
                            if ($mode -ceq 'enforce') {
                                Fail-Step "Separation of duties (enforce): $approver created this deployment and answered '$ApprovalStep'. Another member of the responsible team must answer."
                            }
                            if (-not $reason) {
                                Fail-Step "Separation of duties (single-operator): $approver created this deployment and answered '$ApprovalStep' without a reason in Notes."
                            }
                            Write-Warning "Single-operator mode: $approver created this deployment and answered '$ApprovalStep'. Reason: $reason"
                        }
                    }
                
                    Set-OctopusVariable -name 'SodGuard.Result' -value 'passed'
                    Set-OctopusVariable -name 'SodGuard.Approver' -value $approver
                    Set-OctopusVariable -name 'SodGuard.Reason' -value $reason
                    Write-Host "Separation of duties holds for '$ApprovalStep' (Platform.SoDMode $mode): answered by $approver."
                    # <<< octopus/step-templates/sod-guard.ps1
                } @sodGuardInputs
                    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}

step "pre-release-backup" {
    name = "Back up database"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool_variable = "Platform.WorkerPool"
        environments = ["prod"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Step template platform-db-backup, inlined (ADR-IR34): the lines between the markers are
                # octopus/step-templates/db-backup.ps1 verbatim, checked by the offline drift test. The script block runs them with
                # these inputs:
                $dbBackupInputs = @{
                    App            = 'workorders'
                    Environment    = $OctopusParameters['Octopus.Environment.Name']
                    TimeoutSeconds = '1800'
                }
                & {
                    # >>> octopus/step-templates/db-backup.ps1
                    #!/usr/bin/env pwsh
                    #Requires -Version 7.4

                    <#
                    .SYNOPSIS
                        platform-db-backup: back up an app database before a release reaches it (ADR-IR34 decision 1; CAP-OCT-015).
                
                    .DESCRIPTION
                        octopus/terraform creates step template platform-db-backup from this file; the parameters default to the template
                        parameters DbBackup.*. App processes may also inline it between "# >>> octopus/step-templates/db-backup.ps1" and
                        "# <<< octopus/step-templates/db-backup.ps1", inside a script block that the step calls with its inputs (offline
                        drift test). No dollar-brace or percent-brace sequences (OCL heredoc template syntax) and no hash-brace sequences
                        (Octopus variable substitution).
                
                        Where it runs: the shared Kubernetes worker pool k8s-<env> (variable Platform.WorkerPool), whose script pods run in
                        namespace octopus-worker-<env> as service account octopus-worker-<env>-scripts (terraform/tier). It creates a Job
                        from the tenant chart's CronJob db-backup-<app>-<env> in namespace platform-backup (uat and prod only: tdd databases
                        are disposable), labels it platform/trigger=pre-release and waits for it. The Job writes the backup to container
                        <app>-<env> of <backup-storage-account-<tier>> as id-db-backup-<tier>.
                        Cross-package interface (gitops): that service account needs, in namespace platform-backup, create on jobs, get on
                        cronjobs, get and list on jobs and pods, and get on pods/log [VERIFY in the tenant chart or the bootstrap RBAC].
                
                    .PARAMETER App
                        App slug, ^[a-z][a-z0-9]{2,11}$ (DbBackup.App).
                
                    .PARAMETER Environment
                        uat or prod (DbBackup.Environment).
                
                    .PARAMETER TimeoutSeconds
                        Longest wait for the Job; empty means 1800 (DbBackup.TimeoutSeconds).
                
                    .OUTPUTS
                        Octopus output variables DbBackup.JobName and DbBackup.CompletedAt. A missing CronJob, a failed Job or the timeout
                        fails the step (Fail-Step); a failing kubectl call stops it.
                    #>
                    [CmdletBinding()]
                    param(
                        [string]$App = $OctopusParameters['DbBackup.App'],
                        [string]$Environment = $OctopusParameters['DbBackup.Environment'],
                        [string]$TimeoutSeconds = $OctopusParameters['DbBackup.TimeoutSeconds']
                    )
                
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                
                    if (-not $TimeoutSeconds) {
                        $TimeoutSeconds = '1800'
                    }
                    if ($App -cnotmatch '^[a-z][a-z0-9]{2,11}$') {
                        Fail-Step "DbBackup.App (-App) '$App' is not an app slug."
                    }
                    if ($Environment -ceq 'tdd') {
                        Fail-Step 'tdd has no backup CronJob: tdd databases are disposable (ADR-IR34).'
                    }
                    if ($Environment -cnotin 'uat', 'prod') {
                        Fail-Step "DbBackup.Environment (-Environment) must be uat or prod, not '$Environment'."
                    }
                    if ($TimeoutSeconds -cnotmatch '\A[0-9]+\z') {
                        Fail-Step "DbBackup.TimeoutSeconds (-TimeoutSeconds) must be a whole number of seconds, not '$TimeoutSeconds'."
                    }
                    if (-not (Get-Command kubectl -CommandType Application -ErrorAction SilentlyContinue)) {
                        Fail-Step 'kubectl is missing from the step container.'
                    }
                
                    $namespace = 'platform-backup'
                    $cronJob = "db-backup-$App-$Environment"
                
                    # Shows the last lines of the Job's log; a failing kubectl logs only loses the log.
                    function Show-BackupJobLog {
                        $PSNativeCommandUseErrorActionPreference = $false
                        kubectl --namespace $namespace logs "job/$job" --tail=100 | Out-Host
                    }
                
                    $PSNativeCommandUseErrorActionPreference = $false
                    $null = kubectl --namespace $namespace get cronjob $cronJob --output name
                    $found = $LASTEXITCODE -eq 0
                    $PSNativeCommandUseErrorActionPreference = $true
                    if (-not $found) {
                        Fail-Step "CronJob $namespace/$cronJob was not found. The tenant chart renders it for uat and prod when the descriptor declares a database."
                    }
                
                    $job = "$cronJob-pre-" + [DateTime]::UtcNow.ToString('yyMMddHHmmss', [Globalization.CultureInfo]::InvariantCulture)
                    $release = [regex]::Replace([string]$OctopusParameters['Octopus.Release.Number'], '[^A-Za-z0-9._-]', '-')
                    if ($release.Length -gt 63) {
                        $release = $release.Substring(0, 63)
                    }
                    if (-not $release) {
                        $release = 'none'
                    }
                    $null = kubectl --namespace $namespace create job $job "--from=cronjob/$cronJob"
                    $null = kubectl --namespace $namespace label job $job 'platform/trigger=pre-release' "platform/release=$release" --overwrite
                    Write-Host "Backup Job $namespace/$job started from CronJob $cronJob for release $release."
                
                    $deadline = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + [long]$TimeoutSeconds
                    while ($true) {
                        $succeeded = (kubectl --namespace $namespace get job $job --output 'jsonpath={.status.succeeded}') -join "`n"
                        $failed = (kubectl --namespace $namespace get job $job --output 'jsonpath={.status.conditions[?(@.type=="Failed")].status}') -join "`n"
                        if ($succeeded -ceq '1') {
                            break
                        }
                        if ($failed -ceq 'True') {
                            Show-BackupJobLog
                            Fail-Step "Backup Job $namespace/$job failed; the release does not proceed to the pin."
                        }
                        if ([DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -ge $deadline) {
                            Show-BackupJobLog
                            Fail-Step "Backup Job $namespace/$job did not complete within $TimeoutSeconds seconds."
                        }
                        Start-Sleep -Seconds 10
                    }
                
                    $completedAt = (kubectl --namespace $namespace get job $job --output 'jsonpath={.status.completionTime}') -join "`n"
                    Set-OctopusVariable -name 'DbBackup.JobName' -value $job
                    Set-OctopusVariable -name 'DbBackup.CompletedAt' -value $completedAt
                    Write-Highlight "Database of $App in $Environment backed up by Job $namespace/$job at $completedAt."
                    # <<< octopus/step-templates/db-backup.ps1
                } @dbBackupInputs
                    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}

step "update-argo-cd-image-tags" {
    name = "Update Argo CD image tags"

    action {
        action_type = "Octopus.ArgoCDUpdateImageTags"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["tdd", "uat", "prod"]
        properties = {
            Octopus.Action.ArgoCD.CommitMethod = "DirectCommit"
            Octopus.Action.ArgoCD.CommitMessageSummary = "Pin #{Octopus.Project.Name} #{Octopus.Release.Number} in #{Octopus.Environment.Name} (#{Octopus.Deployment.Id})"
            Octopus.Action.ArgoCD.StepVerification.Method = "ArgoCDApplicationHealthy"
            Octopus.Action.ArgoCD.StepVerification.Timeout = "#{Argo.VerificationTimeoutSeconds}"
            Octopus.Action.ArgoCD.Sync.Mode = "Disabled"
            Octopus.Action.AutoRetry.MaximumCount = "1"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
        }

        packages "ui-server" {
            acquisition_location = "NotAcquired"
            feed = "acr-apps"
            package_id = "apps/workorders/ui-server"
            properties = {
                Extract = "False"
                Purpose = "DockerImageReference"
                SelectionMode = "immediate"
            }
        }

        packages "worker" {
            acquisition_location = "NotAcquired"
            feed = "acr-apps"
            package_id = "apps/workorders/worker"
            properties = {
                Extract = "False"
                Purpose = "DockerImageReference"
                SelectionMode = "immediate"
            }
        }

        packages "db-migrator" {
            acquisition_location = "NotAcquired"
            feed = "acr-apps"
            package_id = "apps/workorders/db-migrator"
            properties = {
                Extract = "False"
                Purpose = "DockerImageReference"
                SelectionMode = "immediate"
            }
        }
    }
}

step "read-deployment-secrets" {
    name = "Read deployment secrets"
    start_trigger = "StartWithPrevious"

    action {
        action_type = "Octopus.AzurePowerShell"
        is_required = true
        worker_pool_variable = "Platform.WorkerPool"
        environments = ["tdd"]
        properties = {
            Octopus.Action.Azure.AccountId = "#{Azure.DeployAccount}"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Octopus runs its Azure context script around this step (it logs the Azure CLI in and out); the script block keeps
                # this step's StrictMode and error preferences out of that script.
                & {
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                    # ADR-IR34: the tdd acceptance suite logs in as workorders_app and needs the AI key. Both live in the app vault
                    # kv-workorders-t-<hash4> (hash4: the first four hex digits of sha1("<subscription>/workorders/tdd"), decision 8), read
                    # as azure-workorders-tdd (id-workorders-tdd-deploy: Key Vault Secrets User on that vault). Octopus logs the Azure CLI
                    # in with that account before the script runs; no Az PowerShell module is used.
                    # Runs in parallel with Update Argo CD image tags (start_trigger StartWithPrevious): only Acceptance tests reads its
                    # outputs, the pin reads nothing from it, and Verify version starts only when both succeeded.
                    if ($OctopusParameters['Octopus.Environment.Name'] -cne 'tdd') {
                        Fail-Step 'Read deployment secrets runs in tdd only.'
                    }
                    $subscription = (az account show --query id --output tsv) -join "`n"
                    $digest = [System.Security.Cryptography.SHA1]::HashData([System.Text.Encoding]::UTF8.GetBytes("$subscription/workorders/tdd"))
                    $vault = 'kv-workorders-t-' + [Convert]::ToHexString($digest).Substring(0, 4).ToLowerInvariant()
                    $appPassword = (az keyvault secret show --vault-name $vault --name db-app-password --query value --output tsv) -join "`n"
                    if (-not $appPassword) {
                        Fail-Step "Secret db-app-password is empty in $vault (terraform/apps/tier generates it)."
                    }
                    Set-OctopusVariable -name 'AcceptancePassword' -value $appPassword -sensitive
                    $PSNativeCommandUseErrorActionPreference = $false
                    $openAiKey = (az keyvault secret show --vault-name $vault --name ai-openai-apikey --query value --output tsv) -join "`n"
                    if ($LASTEXITCODE -ne 0) {
                        $openAiKey = ''
                        # Octopus ends a PowerShell step with the exit code of its last native command; this failure is expected.
                        $global:LASTEXITCODE = 0
                    }
                    $PSNativeCommandUseErrorActionPreference = $true
                    # Until an operator sets the key, the vault holds terraform/apps/tier's stand-in not-set-...; treated as no key, the
                    # suite skips its AI tests (SkipIfNoChatClient), as the app in the cluster reports chat off (ExternalSecret
                    # workorders-app maps the stand-in to an empty key).
                    if ($openAiKey.StartsWith('not-set-', [StringComparison]::Ordinal)) {
                        $openAiKey = ''
                    }
                    if (-not $openAiKey) {
                        Write-Warning "Secret ai-openai-apikey is not set in $vault; the AI acceptance tests are skipped."
                    }
                    Set-OctopusVariable -name 'OpenAIKey' -value $openAiKey -sensitive
                    Write-Host "Acceptance secrets read from $vault."
                }
                    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }

        container {
            feed = "acr-apps"
            image = "#{StepImage.CiDotnet}"
        }
    }
}

step "verify-version" {
    name = "Verify version"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["tdd", "uat", "prod"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                Set-StrictMode -Version Latest
                $ErrorActionPreference = 'Stop'
                $PSNativeCommandArgumentPassing = 'Standard'
                $PSNativeCommandUseErrorActionPreference = $true
                # Expected = the release's package version. Channel Default: the release number. Channel Hotfix: the release number
                # without "-hotfix.<n>".
                $expected = [string]$OctopusParameters['Octopus.Release.Number'] -creplace '-hotfix\.[0-9]+$', ''
                $url = [string]$OctopusParameters['App.BaseUrl'] + [string]$OctopusParameters['App.VersionPath']
                # Up to 12 retries 5 s apart (the same 60 s of waiting as 6 retries 10 s apart, answered sooner once the app is up);
                # --retry-max-time keeps the worst case with hanging requests at the 165 s of the old settings.
                $body = (curl --fail --silent --show-error --max-time 15 --retry 12 --retry-delay 5 --retry-max-time 165 --retry-all-errors $url) -join "`n"
                # The reported version: property "version" of a JSON object (the last one, as jq reads it); else the value of the last
                # "version": "..." on the first line that has one; else the first line without blanks (a plain-text endpoint).
                $actual = ''
                try {
                    $root = [System.Text.Json.JsonDocument]::Parse($body, [System.Text.Json.JsonDocumentOptions]::new()).RootElement
                    if ($root.ValueKind -eq 'Object') {
                        foreach ($property in $root.EnumerateObject()) {
                            if ($property.Name -cne 'version') {
                                continue
                            }
                            $actual = switch ($property.Value.ValueKind) {
                                'String' { $property.Value.GetString() }
                                'True' { 'true' }
                                { $_ -in 'Number', 'Object', 'Array' } { $property.Value.GetRawText() }
                                default { '' }
                            }
                        }
                    }
                }
                catch {
                    $actual = ''
                }
                if (-not $actual) {
                    foreach ($line in $body -split "`n") {
                        if ($line -cmatch '.*"version"[ \t\r\f\v]*:[ \t\r\f\v]*"([^"]*)".*') {
                            $actual = $Matches[1]
                            break
                        }
                    }
                }
                if (-not $actual) {
                    $actual = ($body -split "`n", 2)[0] -creplace '[ \t\r\n\f\v]', ''
                }
                # "Starts with" at a version boundary: exact, or followed by + (build metadata) or - (suffix).
                if ($actual -ceq $expected -or $actual.StartsWith("$expected+", [StringComparison]::Ordinal) -or $actual.StartsWith("$expected-", [StringComparison]::Ordinal)) {
                    Write-Host "Version OK: $url reports $actual (expected $expected)."
                }
                else {
                    Fail-Step "Version mismatch at $($url): got '$actual', expected '$expected'."
                }
                    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}

step "smoke-test" {
    name = "Smoke test"
    start_trigger = "StartWithPrevious"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["tdd", "uat", "prod"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                Set-StrictMode -Version Latest
                $ErrorActionPreference = 'Stop'
                $PSNativeCommandArgumentPassing = 'Standard'
                $PSNativeCommandUseErrorActionPreference = $true
                # Runs in parallel with Verify version (start_trigger StartWithPrevious): both only read the app after the Argo CD
                # healthy wait, neither reads the other's output, and Acceptance tests starts only when both succeeded.
                # /_healthcheck is the smoke target only, never a probe (ADR-D12). The default writer returns plain text.
                $url = [string]$OctopusParameters['App.BaseUrl'] + '/_healthcheck'
                $failOnDegraded = [string]$OctopusParameters['Smoke.FailOnDegraded']
                $deadline = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + 150
                $status = ''
                while ($true) {
                    $PSNativeCommandUseErrorActionPreference = $false
                    $status = (curl --silent --max-time 10 $url) -join "`n"
                    $PSNativeCommandUseErrorActionPreference = $true
                    if ($status -ceq 'Healthy') {
                        Write-Host "Smoke OK: $url is Healthy."
                        break
                    }
                    if ($status -ceq 'Degraded' -and $failOnDegraded -cne 'True') {
                        Write-Warning "$url is Degraded; accepted because Smoke.FailOnDegraded is $failOnDegraded (#9016)."
                        break
                    }
                    if ([DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -ge $deadline) {
                        Fail-Step "Smoke test failed: $url returned '$status' for 150 s (Smoke.FailOnDegraded=$failOnDegraded)."
                    }
                    Start-Sleep -Seconds 5
                }
                    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}

step "acceptance-tests" {
    name = "Acceptance tests (TDD only)"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool_variable = "Platform.WorkerPool"
        environments = ["tdd"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                $ErrorActionPreference = 'Stop'
                $PSNativeCommandArgumentPassing = 'Standard'
                $environmentName = $OctopusParameters['Octopus.Environment.Name']
                $allowReset = $OctopusParameters['Acceptance.AllowDestructiveReset']
                if ($environmentName -ne 'tdd' -or $allowReset -ne 'True') {
                    Fail-Step "Refusing the destructive acceptance suite: environment '$environmentName', Acceptance.AllowDestructiveReset '$allowReset'."
                }
                
                $packageDir = $OctopusParameters['Octopus.Action.Package[ChurchBulletin.AcceptanceTests].ExtractedPath']
                $testDll = Get-ChildItem -Path $packageDir -Filter 'ClearMeasure.Bootcamp.AcceptanceTests.dll' -Recurse | Select-Object -First 1
                if (-not $testDll) { Fail-Step "ClearMeasure.Bootcamp.AcceptanceTests.dll not found in $packageDir" }
                $runSettings = Join-Path $testDll.DirectoryName 'AcceptanceTests.runsettings'
                $playwrightDir = Join-Path $testDll.DirectoryName '.playwright'
                if (Test-Path $playwrightDir) { & chmod -R +x $playwrightDir }
                
                # ADR-IR34: the tdd database runs in the cluster (Service db of workorders-tdd); this worker reaches it because the
                # descriptor sets database.octopusWorkerAccess. Login workorders_app; the in-cluster certificate comes from
                # platform-internal-ca, and NetworkPolicy fences the traffic, so the connection trusts the server certificate.
                $builder = [System.Data.Common.DbConnectionStringBuilder]::new()
                $builder['Server'] = 'tcp:' + $OctopusParameters['Db.Server'] + ',1433'
                $builder['Database'] = $OctopusParameters['Db.Name']
                $builder['User ID'] = $OctopusParameters['Db.AppLogin']
                $builder['Password'] = $OctopusParameters['Octopus.Action[Read deployment secrets].Output.AcceptancePassword']
                $builder['Encrypt'] = 'True'
                $builder['TrustServerCertificate'] = 'True'
                
                # Inputs from ADR-C11; names mirror the legacy TDD run in app:.github/workflows/deploy.yml.
                $env:ConnectionStrings__SqlConnectionString = $builder.ConnectionString
                $env:ApplicationBaseUrl = $OctopusParameters['App.BaseUrl']
                $env:StartLocalServer = 'false'
                $env:AcceptanceTests__AllowDestructiveReset = 'true'
                $env:AI_OpenAI_ApiKey = $OctopusParameters['Octopus.Action[Read deployment secrets].Output.OpenAIKey']
                $env:AI_OpenAI_Url = $OctopusParameters['AI.OpenAIUrl']
                $env:AI_OpenAI_Model = $OctopusParameters['AI.OpenAIModel']
                $env:TEST_INPUT_DELAY_MS = '200'
                
                $results = Join-Path (Get-Location) 'acceptance-results'
                New-Item -ItemType Directory -Path $results -Force | Out-Null
                Write-Host "Acceptance tests against $env:ApplicationBaseUrl with $($testDll.FullName)"
                # 5 NUnit workers instead of the 4 of AcceptanceTests.runsettings: the tdd script pod requests 400m CPU and has no CPU
                # limit (terraform/tier nonprod.tfvars, octopus_worker_script_pod_resources), so it bursts into the idle cores of its
                # 4-vCPU apps node (Standard_D4as_v6, about 200m in use at rest). That node also runs the app under test, so the count
                # stays below the 2 Chromium workers per core that caused navigation timeouts in app #9019 (8 on 4 cores).
                # 30-minute ceiling with coreutils timeout; exit code 124 means the ceiling was hit.
                $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
                & timeout --kill-after=60 1800 dotnet test $testDll.FullName --nologo --logger trx --results-directory $results --settings $runSettings -- NUnit.NumberOfTestWorkers=5
                $exitCode = $LASTEXITCODE
                $stopwatch.Stop()
                
                $trxFiles = @(Get-ChildItem -Path $results -Filter '*.trx' -Recurse)
                $trxFiles | ForEach-Object {
                    New-OctopusArtifact -Path $_.FullName -Name ('acceptance-tdd-' + $_.Name)
                }
                
                # Counts on the task summary (Write-Highlight) and in output variable AcceptanceSummary for later steps. Reporting never
                # decides the outcome: the exit code of dotnet test does, below, as before. An [LlmTest] that did not pass is an NUnit
                # warning, which the NUnit adapter records as NotExecuted and dotnet test does not fail on: it counts as skipped, and as
                # an LLM warning. TRX counters leave notExecuted at 0, so skipped is total minus executed.
                $elapsed = $stopwatch.Elapsed
                $duration = '{0}m{1:00}s' -f [int][Math]::Floor($elapsed.TotalMinutes), $elapsed.Seconds
                $summary = "Acceptance (tdd): no TRX results after $duration (exit code $exitCode)"
                $failedNames = [System.Collections.Generic.List[string]]::new()
                try {
                    $total = 0; $executed = 0; $passed = 0; $failed = 0; $inconclusive = 0; $llmWarnings = 0
                    foreach ($trx in $trxFiles) {
                        $xml = [xml][IO.File]::ReadAllText($trx.FullName)
                        $counters = $xml.SelectSingleNode('//*[local-name()="ResultSummary"]/*[local-name()="Counters"]')
                        if (-not $counters) { continue }
                        $total += [int]$counters.GetAttribute('total')
                        $executed += [int]$counters.GetAttribute('executed')
                        $passed += [int]$counters.GetAttribute('passed')
                        foreach ($name in 'failed', 'error', 'timeout', 'aborted') { $failed += [int]$counters.GetAttribute($name) }
                        foreach ($name in 'inconclusive', 'warning') { $inconclusive += [int]$counters.GetAttribute($name) }
                        foreach ($result in $xml.SelectNodes('//*[local-name()="UnitTestResult"]')) {
                            $outcome = $result.GetAttribute('outcome')
                            if ($outcome -in 'Failed', 'Error', 'Timeout', 'Aborted') { $failedNames.Add($result.GetAttribute('testName')) }
                            elseif ($outcome -eq 'NotExecuted' -and $result.InnerText -match 'LLM-dependent test did not pass') { $llmWarnings++ }
                        }
                    }
                    if ($trxFiles.Count -gt 0) {
                        $skipped = [Math]::Max(0, $total - $executed)
                        $skippedText = "$skipped skipped"
                        if ($llmWarnings -gt 0) { $skippedText += " ($llmWarnings LLM warnings)" }
                        $summary = "Acceptance (tdd): $passed passed, $failed failed, $skippedText of $total in $duration"
                        if ($inconclusive -gt 0) { $summary += ", $inconclusive inconclusive" }
                        if ($exitCode -eq 124) { $summary += ' (timed out)' }
                    }
                }
                catch {
                    Write-Warning "Could not read the acceptance TRX counts: $($_.Exception.Message)"
                }
                Write-Highlight $summary
                if ($failedNames.Count -gt 0) {
                    $shown = @($failedNames | Select-Object -First 10)
                    Write-Highlight ("Failed acceptance tests ($($shown.Count) of $($failedNames.Count)): " + ($shown -join '; '))
                }
                Set-OctopusVariable -name 'AcceptanceSummary' -value $summary
                if ($exitCode -eq 124) { Fail-Step 'Acceptance tests exceeded the 30-minute timeout.' }
                if ($exitCode -ne 0) { Fail-Step "Acceptance tests failed (exit code $exitCode); TRX files are attached as artifacts." }
                    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }

        container {
            feed = "acr-apps"
            image = "#{StepImage.CiDotnet}"
        }

        packages "ChurchBulletin.AcceptanceTests" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "ChurchBulletin.AcceptanceTests"
            properties = {
                Extract = "True"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}

step "uat-signoff" {
    name = "UAT sign-off"
    condition = "Variable"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Platform.ApprovalsRequired == \"false\"}False#{else}True#{/if}#{/unless}"
    }

    action {
        action_type = "Octopus.Manual"
        is_required = true
        environments = ["uat"]
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = <<-EOT
                ## UAT sign-off for release #{Octopus.Release.Number}
                Version and smoke checks passed at #{App.BaseUrl}. Sign off when:
                - The UAT test plan for this release passed.
                - Known defects are recorded in Notes with their disposition.
                
                Proceeding makes this release eligible for Prod; aborting fails the UAT deployment.
                    EOT
            Octopus.Action.Manual.ResponsibleTeamIds = "uat-approvers"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

step "uat-signoff-guard" {
    name = "UAT sign-off guard"
    condition = "Variable"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Platform.ApprovalsRequired == \"false\"}False#{else}True#{/if}#{/unless}"
    }

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["uat"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Step template platform-sod-guard, inlined (ADR-IR34): the lines between the markers are
                # octopus/step-templates/sod-guard.ps1 verbatim, checked by the offline drift test. The script block runs them with
                # these inputs:
                $sodGuardInputs = @{
                    ApprovalStep = 'UAT sign-off'
                    OtherSteps   = 'Hotfix justification'
                    CheckCreator = 'false'
                }
                & {
                    # >>> octopus/step-templates/sod-guard.ps1
                    #!/usr/bin/env pwsh
                    #Requires -Version 7.4

                    <#
                    .SYNOPSIS
                        platform-sod-guard: separation of duties and the intervention test mode for one manual intervention
                        (ADR-IR34 decision 23, ADR-IR32; capabilities CAP-OCT-004 and CAP-OCT-005).
                
                    .DESCRIPTION
                        octopus/terraform creates step template platform-sod-guard from this file; the parameters default to the template
                        parameters SodGuard.*. App processes may also inline it: the lines between
                        "# >>> octopus/step-templates/sod-guard.ps1" and "# <<< octopus/step-templates/sod-guard.ps1" must equal this file
                        (offline drift test in tests/Platform.Conformance.Offline/Octopus/), inside a script block that the step calls with
                        its inputs. Octopus runs it with the PowerShell script functions ($OctopusParameters, Set-OctopusVariable,
                        Fail-Step, Write-Highlight). No dollar-brace or percent-brace sequences (OCL heredoc template syntax) and no
                        hash-brace sequences (Octopus variable substitution).
                
                        Octopus variables, from library variable set Platform Environment (a project may override them by scope, as the
                        sandbox channel Strict does for Platform.SoDMode):
                          Platform.SoDMode              single-operator (default): the deployment creator may approve, with a reason in
                                                        Notes; enforce: the creator may not approve
                          Platform.InterventionTestMode true: the automation user may answer, only with the reason
                                                        conformance:<run-id> or e2e:<run-id>; anything else: it may not answer
                          Platform.AutomationUsername   the automation user (AISF-Service-Account), compared case-insensitively
                        Manual intervention outputs are addressed by step name (Octopus.Action[<step name>].Output.Manual.*, ADR-IR22).
                
                    .PARAMETER ApprovalStep
                        Name of the manual intervention whose answer is checked, for example "Prod go/no-go" (SodGuard.ApprovalStep).
                
                    .PARAMETER OtherSteps
                        Comma-separated names of other interventions of the deployment; checked only for answers by the automation user;
                        interventions that did not run are skipped (SodGuard.OtherSteps).
                
                    .PARAMETER CheckCreator
                        "true": the Platform.SoDMode rule applies to the approval step (SodGuard.CheckCreator).
                
                    .OUTPUTS
                        Octopus output variables SodGuard.Result, SodGuard.Approver and SodGuard.Reason. A rule that does not hold fails
                        the step (Fail-Step).
                    #>
                    [CmdletBinding()]
                    param(
                        [string]$ApprovalStep = $OctopusParameters['SodGuard.ApprovalStep'],
                        [string]$OtherSteps = $OctopusParameters['SodGuard.OtherSteps'],
                        [string]$CheckCreator = $OctopusParameters['SodGuard.CheckCreator']
                    )
                
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                
                    # The first line of a text without surrounding blanks (space, tab, CR, LF, VT, FF).
                    function Get-SodFirstLine([string]$Text) {
                        return ($Text -split "`n", 2)[0].Trim([char[]]" `t`r`n`v`f")
                    }
                
                    function Get-SodManualOutput([string]$Step, [string]$Name) {
                        return [string]$OctopusParameters["Octopus.Action[$Step].Output.Manual.$Name"]
                    }
                
                    # The automation user answers only in intervention test mode, and only with a run reason in the first line of Notes.
                    function Assert-SodAutomationAnswer([string]$Step, [string]$Username, [string]$Notes) {
                        if ($Username.ToLowerInvariant() -cne $automation) {
                            return
                        }
                        if ($testMode -cne 'true') {
                            Fail-Step "Separation of duties: '$Step' was answered by the automation user $Username while Platform.InterventionTestMode is not true."
                        }
                        $automationReason = Get-SodFirstLine $Notes
                        if ($automationReason -cnotmatch '^(conformance|e2e):[A-Za-z0-9._-]+$') {
                            Fail-Step "Separation of duties: the automation user answered '$Step' without the reason conformance:<run-id> or e2e:<run-id> (Notes: '$automationReason')."
                        }
                        Write-Highlight "'$Step' was answered by the automation user in intervention test mode: $automationReason"
                    }
                
                    $creatorRule = $CheckCreator.ToLowerInvariant()
                    if (-not $ApprovalStep) {
                        Fail-Step 'SodGuard.ApprovalStep (-ApprovalStep) is empty; failing closed.'
                    }
                
                    $mode = ([string]$OctopusParameters['Platform.SoDMode']).ToLowerInvariant()
                    if (-not $mode) {
                        $mode = 'single-operator'
                    }
                    if ($mode -cnotin 'single-operator', 'enforce') {
                        Fail-Step "Platform.SoDMode must be single-operator or enforce, not '$mode'."
                    }
                    $testMode = ([string]$OctopusParameters['Platform.InterventionTestMode']).ToLowerInvariant()
                    $automation = ([string]$OctopusParameters['Platform.AutomationUsername']).ToLowerInvariant()
                    if (-not $automation) {
                        Fail-Step 'Platform.AutomationUsername is empty (library variable set Platform Environment); failing closed.'
                    }
                
                    $approverId = Get-SodManualOutput $ApprovalStep 'ResponsibleUser.Id'
                    $approver = Get-SodManualOutput $ApprovalStep 'ResponsibleUser.Username'
                    $notes = Get-SodManualOutput $ApprovalStep 'Notes'
                    if (-not $approverId) {
                        Fail-Step "No answer is recorded for '$ApprovalStep'; failing closed."
                    }
                    Assert-SodAutomationAnswer $ApprovalStep $approver $notes
                
                    foreach ($item in $OtherSteps -split '[,\n]') {
                        $other = Get-SodFirstLine $item
                        if (-not $other) {
                            continue
                        }
                        $otherUser = Get-SodManualOutput $other 'ResponsibleUser.Username'
                        if (-not $otherUser) {
                            continue
                        }
                        Assert-SodAutomationAnswer $other $otherUser (Get-SodManualOutput $other 'Notes')
                    }
                
                    $reason = Get-SodFirstLine $notes
                    if ($creatorRule -ceq 'true') {
                        $creatorId = [string]$OctopusParameters['Octopus.Deployment.CreatedBy.Id']
                        if (-not $creatorId) {
                            Fail-Step 'Cannot read the creator of this deployment; failing closed.'
                        }
                        if ($approverId -ceq $creatorId) {
                            if ($mode -ceq 'enforce') {
                                Fail-Step "Separation of duties (enforce): $approver created this deployment and answered '$ApprovalStep'. Another member of the responsible team must answer."
                            }
                            if (-not $reason) {
                                Fail-Step "Separation of duties (single-operator): $approver created this deployment and answered '$ApprovalStep' without a reason in Notes."
                            }
                            Write-Warning "Single-operator mode: $approver created this deployment and answered '$ApprovalStep'. Reason: $reason"
                        }
                    }
                
                    Set-OctopusVariable -name 'SodGuard.Result' -value 'passed'
                    Set-OctopusVariable -name 'SodGuard.Approver' -value $approver
                    Set-OctopusVariable -name 'SodGuard.Reason' -value $reason
                    Write-Host "Separation of duties holds for '$ApprovalStep' (Platform.SoDMode $mode): answered by $approver."
                    # <<< octopus/step-templates/sod-guard.ps1
                } @sodGuardInputs
                    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}

step "report-commit-status" {
    name = "Report platform/tdd status"
    condition = "Always"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["tdd"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                Set-StrictMode -Version Latest
                $ErrorActionPreference = 'Stop'
                $PSNativeCommandArgumentPassing = 'Standard'
                $PSNativeCommandUseErrorActionPreference = $true
                $ProgressPreference = 'SilentlyContinue'
                if ($OctopusParameters['GitHub.StatusEnabled'] -cne 'True') {
                    Write-Host 'Skipped: GitHub.StatusEnabled is not True (R16: the statuses-only GitHub App is not installed yet).'
                    return
                }
                $key = [string]$OctopusParameters['GitHub.StatusAppPrivateKey']
                if (-not $key) {
                    Fail-Step 'GitHub.StatusEnabled is True but the sensitive variable GitHub.StatusAppPrivateKey is empty.'
                }
                $appId = [string]$OctopusParameters['GitHub.StatusAppId']
                $installationId = [string]$OctopusParameters['GitHub.StatusAppInstallationId']
                $repository = [string]$OctopusParameters['GitHub.AppRepository']
                $context = [string]$OctopusParameters['GitHub.StatusContext']
                
                # >>> scripts/github/GitHubAppAuth.ps1
                # Marked region: the Octopus step report-commit-status (.octopus/apps/workorders/workorders/deployment_process.ocl) inlines
                # these functions verbatim (indentation removed); a conformance test fails when the copy and this region differ. Keep
                # the region free of dollar-brace, percent-brace and hash-brace sequences (OCL heredocs forbid them): write $($AppId).
                function ConvertTo-Base64Url([byte[]] $Bytes) {
                    return [Convert]::ToBase64String($Bytes).Replace('+', '-').Replace('/', '_').Replace('=', '')
                }
                
                function Get-GitHubApiBase {
                    $base = if ($env:GITHUB_API_URL) { $env:GITHUB_API_URL } else { 'https://api.github.com' }
                    return $base.TrimEnd('/')
                }
                
                # PEM text as a secret store may hand it over: a PEM kept on one line writes its line breaks as the two characters
                # backslash and n; those become real line breaks. Nothing else changes and nothing is echoed.
                function ConvertTo-GitHubAppPem([string] $Pem) {
                    if ($Pem -notmatch "\n" -and $Pem.Contains('\n')) {
                        return $Pem.Replace('\n', "`n")
                    }
                    return $Pem
                }
                
                # The PEM text of the App's private key: the file of AISF_BOARD_APP_PRIVATE_KEY_PATH, else AISF_BOARD_APP_PRIVATE_KEY.
                # $null when neither is set. Errors name the variable, never the content.
                function Get-GitHubAppPrivateKey {
                    if ($env:AISF_BOARD_APP_PRIVATE_KEY_PATH) {
                        if (-not (Test-Path -LiteralPath $env:AISF_BOARD_APP_PRIVATE_KEY_PATH -PathType Leaf)) {
                            throw 'GitHub App private key: the file named by AISF_BOARD_APP_PRIVATE_KEY_PATH does not exist.'
                        }
                        return [System.IO.File]::ReadAllText($env:AISF_BOARD_APP_PRIVATE_KEY_PATH)
                    }
                    if ($env:AISF_BOARD_APP_PRIVATE_KEY) {
                        return ConvertTo-GitHubAppPem $env:AISF_BOARD_APP_PRIVATE_KEY
                    }
                    return $null
                }
                
                function Test-GitHubAppPrivateKey {
                    return [bool]($env:AISF_BOARD_APP_PRIVATE_KEY_PATH -or $env:AISF_BOARD_APP_PRIVATE_KEY)
                }
                
                <#
                .SYNOPSIS
                    The RS256 JWT of the App: header {"alg":"RS256","typ":"JWT"}, claims iat = Now - 60, exp = Now + 540, iss = AppId.
                .PARAMETER Now
                    Unix seconds; the clock of the token (a parameter so tests are deterministic).
                .PARAMETER PrivateKey
                    The PEM text of the private key, held in memory only (the Octopus step gets it from a sensitive variable). When given
                    it replaces the file and environment sources: no environment variable and no file is involved. Never echoed.
                #>
                function New-GitHubAppJwt {
                    [CmdletBinding()]
                    [OutputType([string])]
                    param(
                        [Parameter(Mandatory)] [string] $AppId,
                        [long] $Now = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds(),
                        [string] $PrivateKey = ''
                    )
                    $pem = if ($PrivateKey) { ConvertTo-GitHubAppPem $PrivateKey } else { Get-GitHubAppPrivateKey }
                    if (-not $pem) {
                        throw "GitHub App $($AppId): no private key (set AISF_BOARD_APP_PRIVATE_KEY_PATH to a PEM file, or AISF_BOARD_APP_PRIVATE_KEY to the PEM text)."
                    }
                    $header = ConvertTo-Base64Url ([Text.Encoding]::UTF8.GetBytes('{"alg":"RS256","typ":"JWT"}'))
                    $claims = ConvertTo-Base64Url ([Text.Encoding]::UTF8.GetBytes('{"iat":' + ($Now - 60) + ',"exp":' + ($Now + 540) + ',"iss":"' + $AppId + '"}'))
                    $rsa = [System.Security.Cryptography.RSA]::Create()
                    try {
                        try {
                            $rsa.ImportFromPem($pem)
                        }
                        catch [System.ArgumentException], [System.Security.Cryptography.CryptographicException] {
                            throw "GitHub App $($AppId): the private key is not a valid RSA PEM key."
                        }
                        $signature = $rsa.SignData([Text.Encoding]::UTF8.GetBytes("$header.$claims"), [System.Security.Cryptography.HashAlgorithmName]::SHA256, [System.Security.Cryptography.RSASignaturePadding]::Pkcs1)
                    }
                    finally {
                        $rsa.Dispose()
                    }
                    return "$header.$claims.$(ConvertTo-Base64Url $signature)"
                }
                
                # One GitHub API call with the App JWT or a token; returns @{ Status; Json } and never throws on an HTTP status.
                function Invoke-GitHubAppApi([string] $Method, [string] $Path, [string] $Bearer, [string] $Body, [string] $AppId) {
                    $headers = @{ Authorization = "Bearer $Bearer"; Accept = 'application/vnd.github+json'; 'X-GitHub-Api-Version' = '2022-11-28' }
                    $arguments = @{ Uri = "$(Get-GitHubApiBase)$Path"; Method = $Method; Headers = $headers; SkipHttpErrorCheck = $true; TimeoutSec = 30 }
                    if ($Body) {
                        $arguments['Body'] = $Body
                        $arguments['ContentType'] = 'application/json'
                    }
                    try {
                        $answer = Invoke-WebRequest @arguments
                    }
                    catch [System.Net.Http.HttpRequestException], [System.Threading.Tasks.TaskCanceledException] {
                        throw "GitHub App $($AppId): $Method $Path -> no response."
                    }
                    $json = $null
                    if ($answer.Content) {
                        try {
                            $json = $answer.Content | ConvertFrom-Json -AsHashtable
                        }
                        catch [System.ArgumentException] {
                            $json = $null
                        }
                    }
                    return @{ Status = [int]$answer.StatusCode; Json = $json }
                }
                
                <#
                .SYNOPSIS
                    An installation access token of the App: valid one hour, limited to the given repositories and permissions.
                .PARAMETER Repository
                    owner/repo names; the token can reach only these. The first also finds the installation when its id is not given.
                .PARAMETER Permission
                    Hashtable such as @{ organization_projects = 'write'; issues = 'read' }; the token gets these and no more.
                .PARAMETER InstallationId
                    Installation id; default AISF_BOARD_APP_INSTALLATION_ID, else discovered with GET /repos/{owner}/{repo}/installation.
                .PARAMETER PrivateKey
                    The PEM text of the private key, in memory only; see New-GitHubAppJwt. Default: the file or environment sources.
                #>
                function Get-GitHubAppInstallationToken {
                    [CmdletBinding()]
                    [OutputType([string])]
                    param(
                        [Parameter(Mandatory)] [string] $AppId,
                        [Parameter(Mandatory)] [string[]] $Repository,
                        [Parameter(Mandatory)] [hashtable] $Permission,
                        [string] $InstallationId = '',
                        [long] $Now = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds(),
                        [string] $PrivateKey = ''
                    )
                    $jwt = New-GitHubAppJwt -AppId $AppId -Now $Now -PrivateKey $PrivateKey
                    if (-not $InstallationId) {
                        $InstallationId = [string]$env:AISF_BOARD_APP_INSTALLATION_ID
                    }
                    if (-not $InstallationId) {
                        $found = Invoke-GitHubAppApi 'Get' "/repos/$($Repository[0])/installation" $jwt '' $AppId
                        if ($found.Status -ne 200 -or -not $found.Json -or -not $found.Json.ContainsKey('id')) {
                            throw "GitHub App $($AppId): no installation found for $($Repository[0]) (HTTP $($found.Status))."
                        }
                        $InstallationId = [string]$found.Json['id']
                    }
                    $names = @($Repository | ForEach-Object { ($_ -split '/')[-1] })
                    $body = [ordered]@{ repositories = $names; permissions = $Permission } | ConvertTo-Json -Depth 5 -Compress
                    $minted = Invoke-GitHubAppApi 'Post' "/app/installations/$InstallationId/access_tokens" $jwt $body $AppId
                    if ($minted.Status -ne 201 -or -not $minted.Json -or -not $minted.Json.ContainsKey('token') -or -not $minted.Json['token']) {
                        throw "GitHub App $($AppId): no installation token (HTTP $($minted.Status))."
                    }
                    return [string]$minted.Json['token']
                }
                # <<< scripts/github/GitHubAppAuth.ps1
                
                try {
                    $token = Get-GitHubAppInstallationToken -AppId $appId -Repository @($repository) -Permission @{ statuses = 'write' } -InstallationId $installationId -PrivateKey $key
                }
                catch [System.Management.Automation.RuntimeException] {
                    # The message names the App id and the HTTP status only, never a key, JWT or token.
                    Write-Host $_.Exception.Message
                    Fail-Step "No installation token for GitHub App $appId."
                }
                $notes = [string]$OctopusParameters['Octopus.Release.Notes']
                $sha = ''
                foreach ($line in $notes -split "`n") {
                    if ($line -cmatch '^app-commit:[ \t\r\f\v]*([0-9a-f]{40})[ \t\r\f\v]*$') {
                        $sha = $Matches[1]
                        break
                    }
                }
                if (-not $sha) {
                    Fail-Step "No 'app-commit: <40-hex sha>' line in the release notes (§7.7)."
                }
                if ($OctopusParameters['Octopus.Deployment.Error']) {
                    $state = 'failure'
                    $description = 'TDD deployment or acceptance tests failed'
                }
                else {
                    $state = 'success'
                    $description = 'TDD deployment and acceptance tests passed'
                }
                # The counts of Acceptance tests, when it ran; a GitHub status description holds at most 140 characters.
                $acceptance = [string]$OctopusParameters['Octopus.Action[Acceptance tests (TDD only)].Output.AcceptanceSummary']
                if ($acceptance) {
                    $description = $description + ': ' + ($acceptance -creplace '^Acceptance \(tdd\): ', '')
                    if ($description.Length -gt 140) { $description = $description.Substring(0, 137) + '...' }
                }
                $targetUrl = [string]$OctopusParameters['Octopus.Web.ServerUri'] + [string]$OctopusParameters['Octopus.Web.DeploymentLink']
                $payload = [ordered]@{ state = $state; target_url = $targetUrl; description = $description; context = $context } | ConvertTo-Json -Depth 20
                "header = `"Authorization: Bearer $token`"" |
                    curl --config - --fail --silent --show-error --max-time 30 --request POST --header 'Accept: application/vnd.github+json' --header 'X-GitHub-Api-Version: 2022-11-28' --data $payload --output /dev/null "https://api.github.com/repos/$repository/statuses/$sha"
                Write-Host "Posted $context=$state to $repository@$sha."
                    EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }

        container {
            feed = "docker-hub"
            image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
        }
    }
}
