// Project `workorders` (app #1): deployment process (ADR-IR34 §7.0, §7.2, §11.7.2 item 1).
// Flows, each after step 0: TDD read-deployment-secrets, pin, verify, smoke, acceptance tests, status | UAT pin,
// verify, smoke, sign-off, guard | Prod go/no-go, guard, backup, pin, verify, smoke | channel Hotfix adds the
// justification first.
// ADR-IR34 changes: migrate-database and db-copy-pre-release left the process (Argo CD runs the migrator as a
// PreSync Job; Pre-release backup runs the platform backup CronJob); sod-guard is an inline copy of step
// template platform-sod-guard; images apps/workorders/{ui-server,worker,db-migrator} come from feed acr-apps.
//
// Conventions: output variables are addressed by step name (ADR-IR22); team slugs release-managers, prod-approvers,
// uat-approvers; Platform.WorkerPool (library variable set Platform Environment) resolves to k8s-<env>; scripts
// avoid dollar-brace and percent-brace sequences (OCL template syntax); every gate is required; no Kubernetes CLI,
// chart or deploy step writes to an app namespace: Argo CD alone applies desired state (ADR-D2).

// 0. Sleep/wake (ADR-IR33, ADR-IR34 §7.0 "Wake and pins"): before any step needs the cluster, deploy the
//    platform-owned project platform-wake to this environment and wait (Deploy a Release, condition Always, every
//    channel). Keyless: this app project holds no platform secret and no Azure right to start a cluster. A release
//    of this project picks the latest platform-wake release when it is created, like a package version. The step
//    passes no variables: platform-wake reads only PlatformWake.* and system variables (decision 17, CAP-OCT-014).
step "wake-environment" {
    name = "Wake environment"

    action {
        action_type = "Octopus.DeployRelease"
        is_required = true
        environments = ["tdd", "uat", "prod"]
        properties = {
            Octopus.Action.DeployRelease.DeploymentCondition = "Always"
            Octopus.Action.DeployRelease.ProjectId = "platform-wake"
        }

        packages "platform-wake" {
            acquisition_location = "NotAcquired"
            feed = "octopus-project-feed"
            package_id = "platform-wake"
        }
    }
}

// 1. Channel Hotfix only (ADR-D13), selected by channel name so that the process names no channel slug.
step "hotfix-justification" {
    name = "Hotfix justification"
    condition = "Variable"
    properties = {
        Octopus.Action.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Octopus.Release.Channel.Name == \"Hotfix\"}True#{/if}#{/unless}"
    }

    action {
        action_type = "Octopus.Manual"
        is_required = true
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = <<-EOT
                ## Hotfix justification (channel Hotfix, lifecycle platform-hotfix)
                This release skips TDD and its checks. Record in **Notes**:
                1. The incident or defect reference and the business impact.
                2. Why the Default channel (TDD, then UAT) is too slow for this fix.
                3. The rollback plan: redeploy the previous release of this environment.
                
                Confirm the release number reads `<package-version>-hotfix.<n>` and that the selected images are
                default-branch builds already verified in TDD or UAT.
                EOT
            Octopus.Action.Manual.ResponsibleTeamIds = "release-managers"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

// 2. Prod approval (ADR-D13).
step "prod-go-no-go" {
    name = "Prod go/no-go"

    action {
        action_type = "Octopus.Manual"
        is_required = true
        environments = ["prod"]
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = <<-EOT
                ## Prod go/no-go for release #{Octopus.Release.Number}
                Proceed only when all of these hold:
                - UAT sign-off exists for this release (or the Hotfix justification is recorded).
                - The release notes and linked commits match the change announced to users.
                - No deployment freeze override is pending without a recorded reason.
                - Migrations in this release are backward compatible (rollback redeploys older images).
                
                Write the reason for your decision in **Notes**. The separation-of-duties guard applies Platform.SoDMode:
                single-operator lets the creator approve with a reason; enforce does not. The automation user may answer only
                in intervention test mode, with the reason conformance:<run-id> or e2e:<run-id>.
                The next steps back up the database, then commit the image tags.
                EOT
            Octopus.Action.Manual.ResponsibleTeamIds = "prod-approvers"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

// 3. Separation of duties (ADR-IR34 decision 23): inline copy of step template platform-sod-guard.
step "sod-guard" {
    name = "Separation-of-duties guard"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["prod"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Step template platform-sod-guard, inlined (ADR-IR34): the lines between the markers are
                # octopus/step-templates/sod-guard.sh verbatim, checked by the offline drift test.
                SODGUARD_APPROVAL_STEP="Prod go/no-go"
                SODGUARD_OTHER_STEPS="Hotfix justification"
                SODGUARD_CHECK_CREATOR="true"
                # >>> octopus/step-templates/sod-guard.sh
                #!/usr/bin/env bash
                # platform-sod-guard: separation of duties and the intervention test mode for one manual intervention
                # (ADR-IR34 decision 23, ADR-IR32; capabilities CAP-OCT-004 and CAP-OCT-005).
                #
                # octopus/terraform creates step template platform-sod-guard from this file. App processes may also inline it: the
                # lines between "# >>> octopus/step-templates/sod-guard.sh" and "# <<< octopus/step-templates/sod-guard.sh" must
                # equal this file (offline drift test in tests/Platform.Conformance.Offline/Octopus/). Bash only; no dollar-brace
                # sequences, because OCL heredocs treat them as template syntax.
                #
                # Inputs, shell variables set by the step header (inline copy) or from the template parameters:
                #   SODGUARD_APPROVAL_STEP  name of the manual intervention whose answer is checked, for example "Prod go/no-go"
                #   SODGUARD_OTHER_STEPS    comma-separated names of other interventions of the deployment; checked only for answers
                #                           by the automation user; interventions that did not run are skipped
                #   SODGUARD_CHECK_CREATOR  "true": the Platform.SoDMode rule applies to the approval step
                # Octopus variables, from library variable set Platform Environment (a project may override them by scope, as the
                # sandbox channel Strict does for Platform.SoDMode):
                #   Platform.SoDMode              single-operator (default): the deployment creator may approve, with a reason in
                #                                 Notes; enforce: the creator may not approve
                #   Platform.InterventionTestMode true: the automation user may answer, only with the reason
                #                                 conformance:<run-id> or e2e:<run-id>; anything else: it may not answer
                #   Platform.AutomationUsername   the automation user (AISF-Service-Account), compared case-insensitively
                # Output variables: SodGuard.Result, SodGuard.Approver, SodGuard.Reason.
                # Manual intervention outputs are addressed by step name (Octopus.Action[<step name>].Output.Manual.*, ADR-IR22).
                # shellcheck disable=SC2154  # the inputs come from the step header
                set -eu -o pipefail
                
                lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
                trim_first_line() { printf '%s\n' "$1" | sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}'; }
                manual_output() { get_octopusvariable "Octopus.Action[$1].Output.Manual.$2"; }
                
                approval_step="$SODGUARD_APPROVAL_STEP"
                other_steps="$SODGUARD_OTHER_STEPS"
                check_creator="$(lower "$SODGUARD_CHECK_CREATOR")"
                [ -n "$approval_step" ] || fail_step "SODGUARD_APPROVAL_STEP is empty; failing closed."
                
                mode="$(lower "$(get_octopusvariable "Platform.SoDMode")")"
                [ -n "$mode" ] || mode="single-operator"
                case "$mode" in
                    single-operator|enforce) ;;
                    *) fail_step "Platform.SoDMode must be single-operator or enforce, not '$mode'." ;;
                esac
                test_mode="$(lower "$(get_octopusvariable "Platform.InterventionTestMode")")"
                automation="$(lower "$(get_octopusvariable "Platform.AutomationUsername")")"
                [ -n "$automation" ] || fail_step "Platform.AutomationUsername is empty (library variable set Platform Environment); failing closed."
                
                # check_automation STEP USERNAME NOTES: the automation user answers only in intervention test mode, and only with a
                # run reason in the first line of Notes.
                check_automation() {
                    if [ "$(lower "$2")" != "$automation" ]; then
                        return 0
                    fi
                    if [ "$test_mode" != "true" ]; then
                        fail_step "Separation of duties: '$1' was answered by the automation user $2 while Platform.InterventionTestMode is not true."
                    fi
                    automation_reason="$(trim_first_line "$3")"
                    if ! printf '%s' "$automation_reason" | grep -Eq '^(conformance|e2e):[A-Za-z0-9._-]+$'; then
                        fail_step "Separation of duties: the automation user answered '$1' without the reason conformance:<run-id> or e2e:<run-id> (Notes: '$automation_reason')."
                    fi
                    write_highlight "'$1' was answered by the automation user in intervention test mode: $automation_reason"
                }
                
                approver_id="$(manual_output "$approval_step" ResponsibleUser.Id)"
                approver="$(manual_output "$approval_step" ResponsibleUser.Username)"
                notes="$(manual_output "$approval_step" Notes)"
                [ -n "$approver_id" ] || fail_step "No answer is recorded for '$approval_step'; failing closed."
                check_automation "$approval_step" "$approver" "$notes"
                
                other_list="$(printf '%s' "$other_steps" | tr ',' '\n')"
                while IFS= read -r other; do
                    other="$(trim_first_line "$other")"
                    [ -n "$other" ] || continue
                    other_user="$(manual_output "$other" ResponsibleUser.Username)"
                    [ -n "$other_user" ] || continue
                    check_automation "$other" "$other_user" "$(manual_output "$other" Notes)"
                done <<< "$other_list"
                
                reason="$(trim_first_line "$notes")"
                if [ "$check_creator" = "true" ]; then
                    creator_id="$(get_octopusvariable "Octopus.Deployment.CreatedBy.Id")"
                    [ -n "$creator_id" ] || fail_step "Cannot read the creator of this deployment; failing closed."
                    if [ "$approver_id" = "$creator_id" ]; then
                        if [ "$mode" = "enforce" ]; then
                            fail_step "Separation of duties (enforce): $approver created this deployment and answered '$approval_step'. Another member of the responsible team must answer."
                        fi
                        [ -n "$reason" ] || fail_step "Separation of duties (single-operator): $approver created this deployment and answered '$approval_step' without a reason in Notes."
                        write_warning "Single-operator mode: $approver created this deployment and answered '$approval_step'. Reason: $reason"
                    fi
                fi
                
                set_octopusvariable "SodGuard.Result" "passed"
                set_octopusvariable "SodGuard.Approver" "$approver"
                set_octopusvariable "SodGuard.Reason" "$reason"
                echo "Separation of duties holds for '$approval_step' (Platform.SoDMode $mode): answered by $approver."
                # <<< octopus/step-templates/sod-guard.sh
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

// 4. TDD only (ADR-IR34 §11.7.2): the acceptance secrets, through azure-workorders-tdd.
//    Runs on k8s-tdd, whose egress the app vault admits like ESO's.
step "read-deployment-secrets" {
    name = "Read deployment secrets"

    action {
        action_type = "Octopus.AzurePowerShell"
        is_required = true
        worker_pool_variable = "Platform.WorkerPool"
        environments = ["tdd"]
        properties = {
            Octopus.Action.Azure.AccountId = "#{Azure.DeployAccount}"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -eu -o pipefail
                # ADR-IR34: the tdd acceptance suite logs in as workorders_app and needs the AI key. Both live in the app vault
                # kv-workorders-t-<hash4> (hash4: the first four hex digits of sha1("<subscription>/workorders/tdd"), decision 8), read
                # as azure-workorders-tdd (id-workorders-tdd-deploy: Key Vault Secrets User on that vault).
                [ "#{Octopus.Environment.Name}" = "tdd" ] || fail_step "Read deployment secrets runs in tdd only."
                subscription="$(az account show --query id --output tsv)"
                hash4="$(printf '%s' "$subscription/workorders/tdd" | sha1sum | cut -c1-4)"
                vault="kv-workorders-t-$hash4"
                read_secret() {
                    az keyvault secret show --vault-name "$vault" --name "$1" --query value --output tsv
                }
                app_password="$(read_secret db-app-password)"
                [ -n "$app_password" ] || fail_step "Secret db-app-password is empty in $vault (terraform/apps/tier generates it)."
                set_octopusvariable "AcceptancePassword" "$app_password" -sensitive
                openai_key="$(read_secret ai-openai-apikey)" || openai_key=""
                # Until an operator sets the key, the vault holds terraform/apps/tier's stand-in not-set-...; treated as no key, the
                # suite skips its AI tests (SkipIfNoChatClient), as the app in the cluster reports chat off (ExternalSecret
                # workorders-app maps the stand-in to an empty key).
                case "$openai_key" in
                    not-set-*) openai_key="" ;;
                esac
                [ -n "$openai_key" ] || write_warning "Secret ai-openai-apikey is not set in $vault; the AI acceptance tests are skipped."
                set_octopusvariable "OpenAIKey" "$openai_key" -sensitive
                echo "Acceptance secrets read from $vault."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }

        container {
            feed = "acr-apps"
            image = "#{StepImage.CiDotnet}"
        }
    }
}

// Prod only, before the pin (ADR-IR34 decision 1; CAP-OCT-015): inline copy of step template
// platform-db-backup. It runs the tenant chart's backup CronJob now and waits for it.
step "pre-release-backup" {
    name = "Back up database"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool_variable = "Platform.WorkerPool"
        environments = ["prod"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Step template platform-db-backup, inlined (ADR-IR34): the lines between the markers are
                # octopus/step-templates/db-backup.sh verbatim, checked by the offline drift test.
                DBBACKUP_APP="workorders"
                DBBACKUP_ENVIRONMENT="#{Octopus.Environment.Name}"
                DBBACKUP_TIMEOUT_SECONDS="1800"
                # >>> octopus/step-templates/db-backup.sh
                #!/usr/bin/env bash
                # platform-db-backup: back up an app database before a release reaches it (ADR-IR34 decision 1; CAP-OCT-015).
                #
                # octopus/terraform creates step template platform-db-backup from this file. App processes may also inline it between
                # "# >>> octopus/step-templates/db-backup.sh" and "# <<< octopus/step-templates/db-backup.sh" (offline drift test).
                # Bash only; no dollar-brace sequences (OCL heredoc template syntax).
                #
                # Where it runs: the shared Kubernetes worker pool k8s-<env> (variable Platform.WorkerPool), whose script pods run in
                # namespace octopus-worker-<env> as service account octopus-worker-<env>-scripts (terraform/tier). It creates a Job
                # from the tenant chart's CronJob db-backup-<app>-<env> in namespace platform-backup (uat and prod only: tdd databases
                # are disposable), labels it platform/trigger=pre-release and waits for it. The Job writes the backup to container
                # <app>-<env> of <backup-storage-account-<tier>> as id-db-backup-<tier>.
                # Cross-package interface (gitops): that service account needs, in namespace platform-backup, create on jobs, get on
                # cronjobs, get and list on jobs and pods, and get on pods/log [VERIFY in the tenant chart or the bootstrap RBAC].
                #
                # Inputs, shell variables set by the step header (inline copy) or from the template parameters:
                #   DBBACKUP_APP              app slug, ^[a-z][a-z0-9]{2,11}$
                #   DBBACKUP_ENVIRONMENT      uat or prod
                #   DBBACKUP_TIMEOUT_SECONDS  longest wait for the Job; empty means 1800
                # Output variables: DbBackup.JobName, DbBackup.CompletedAt.
                # shellcheck disable=SC2154  # the inputs come from the step header
                set -eu -o pipefail
                
                app="$DBBACKUP_APP"
                environment="$DBBACKUP_ENVIRONMENT"
                timeout_seconds="$DBBACKUP_TIMEOUT_SECONDS"
                [ -n "$timeout_seconds" ] || timeout_seconds=1800
                printf '%s' "$app" | grep -Eq '^[a-z][a-z0-9]{2,11}$' || fail_step "DBBACKUP_APP '$app' is not an app slug."
                case "$environment" in
                    uat|prod) ;;
                    tdd) fail_step "tdd has no backup CronJob: tdd databases are disposable (ADR-IR34)." ;;
                    *) fail_step "DBBACKUP_ENVIRONMENT must be uat or prod, not '$environment'." ;;
                esac
                case "$timeout_seconds" in
                    ''|*[!0-9]*) fail_step "DBBACKUP_TIMEOUT_SECONDS must be a whole number of seconds, not '$timeout_seconds'." ;;
                esac
                command -v kubectl >/dev/null 2>&1 || fail_step "kubectl is missing from the step container."
                
                namespace="platform-backup"
                cronjob="db-backup-$app-$environment"
                kubectl --namespace "$namespace" get cronjob "$cronjob" --output name >/dev/null ||
                    fail_step "CronJob $namespace/$cronjob was not found. The tenant chart renders it for uat and prod when the descriptor declares a database."
                
                job="$cronjob-pre-$(date -u +%y%m%d%H%M%S)"
                release="$(printf '%s' "$(get_octopusvariable "Octopus.Release.Number")" | tr -c 'A-Za-z0-9._-' '-' | cut -c1-63)"
                [ -n "$release" ] || release="none"
                kubectl --namespace "$namespace" create job "$job" --from="cronjob/$cronjob" >/dev/null
                kubectl --namespace "$namespace" label job "$job" "platform/trigger=pre-release" "platform/release=$release" --overwrite >/dev/null
                echo "Backup Job $namespace/$job started from CronJob $cronjob for release $release."
                
                deadline=$(( $(date +%s) + timeout_seconds ))
                while :; do
                    succeeded="$(kubectl --namespace "$namespace" get job "$job" --output 'jsonpath={.status.succeeded}')"
                    failed="$(kubectl --namespace "$namespace" get job "$job" --output 'jsonpath={.status.conditions[?(@.type=="Failed")].status}')"
                    if [ "$succeeded" = "1" ]; then
                        break
                    fi
                    if [ "$failed" = "True" ]; then
                        kubectl --namespace "$namespace" logs "job/$job" --tail=100 || true
                        fail_step "Backup Job $namespace/$job failed; the release does not proceed to the pin."
                    fi
                    if [ "$(date +%s)" -ge "$deadline" ]; then
                        kubectl --namespace "$namespace" logs "job/$job" --tail=100 || true
                        fail_step "Backup Job $namespace/$job did not complete within $timeout_seconds seconds."
                    fi
                    sleep 10
                done
                
                completed_at="$(kubectl --namespace "$namespace" get job "$job" --output 'jsonpath={.status.completionTime}')"
                set_octopusvariable "DbBackup.JobName" "$job"
                set_octopusvariable "DbBackup.CompletedAt" "$completed_at"
                write_highlight "Database of $app in $environment backed up by Job $namespace/$job at $completed_at."
                # <<< octopus/step-templates/db-backup.sh
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

// The only writer of environment pins (ADR-D4, ADR-IR34 decision 20): tags only, direct commit, sync trigger off,
// healthy verification. Action type Octopus.ArgoCDUpdateImageTags (Preview, Q1); it runs on a worker, so the pool
// is hosted-ubuntu (the default pool is Windows, issue #10247). Applications are selected by the annotations
// argo.octopus.com/project=workorders and argo.octopus.com/environment=<env>, which only the tenant chart renders.
// The migrator image is pinned with the app images: Argo CD runs it as the PreSync Job db-migrate before the new
// pods start (decision 1). Fallback writer: step template platform-pin-writer (octopus/step-templates/pin-writer.sh).
step "update-argo-cd-image-tags" {
    name = "Update Argo CD image tags"

    action {
        action_type = "Octopus.ArgoCDUpdateImageTags"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["tdd", "uat", "prod"]
        properties = {
            Octopus.Action.ArgoCD.CommitMethod = "DirectCommit"
            Octopus.Action.ArgoCD.StepVerification.Method = "ArgoCDApplicationHealthy"
            Octopus.Action.ArgoCD.StepVerification.Timeout = "#{Argo.VerificationTimeoutSeconds}"
            Octopus.Action.ArgoCD.Sync.Mode = "Disabled"
            Octopus.Action.AutoRetry.MaximumCount = "1"
            Octopus.Action.AutoRetry.MinimumBackoff = "15"
        }

        packages "ui-server" {
            acquisition_location = "NotAcquired"
            feed = "acr-apps"
            package_id = "apps/workorders/ui-server"
            properties = {
                Extract = "False"
                Purpose = "DockerImageReference"
                SelectionMode = "immediate"
            }
        }

        packages "worker" {
            acquisition_location = "NotAcquired"
            feed = "acr-apps"
            package_id = "apps/workorders/worker"
            properties = {
                Extract = "False"
                Purpose = "DockerImageReference"
                SelectionMode = "immediate"
            }
        }

        packages "db-migrator" {
            acquisition_location = "NotAcquired"
            feed = "acr-apps"
            package_id = "apps/workorders/db-migrator"
            properties = {
                Extract = "False"
                Purpose = "DockerImageReference"
                SelectionMode = "immediate"
            }
        }
    }
}

// The app reports the deployed version at App.BaseUrl + App.VersionPath.
step "verify-version" {
    name = "Verify version"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["tdd", "uat", "prod"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -eu
                # Expected = the release's package version. Channel Default: the release number. Channel Hotfix: the release number
                # without "-hotfix.<n>".
                expected="$(printf '%s' "#{Octopus.Release.Number}" | sed -E 's/-hotfix\.[0-9]+$//')"
                url="#{App.BaseUrl}#{App.VersionPath}"
                body="$(curl --fail --silent --show-error --max-time 15 --retry 6 --retry-delay 10 --retry-all-errors "$url")"
                actual=""
                if command -v jq >/dev/null 2>&1; then
                    actual="$(printf '%s' "$body" | jq -r '.version // empty' 2>/dev/null)" || actual=""
                fi
                if [ -z "$actual" ]; then
                    actual="$(printf '%s' "$body" | sed -n -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -n 1)"
                fi
                [ -n "$actual" ] || actual="$(printf '%s' "$body" | head -n 1 | tr -d '[:space:]')"
                # "Starts with" at a version boundary: exact, or followed by + (build metadata) or - (suffix).
                case "$actual" in
                    "$expected"|"$expected"+*|"$expected"-*) echo "Version OK: $url reports $actual (expected $expected)." ;;
                    *) fail_step "Version mismatch at $url: got '$actual', expected '$expected'." ;;
                esac
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "smoke-test" {
    name = "Smoke test"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["tdd", "uat", "prod"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -eu
                # /_healthcheck is the smoke target only, never a probe (ADR-D12). The default writer returns plain text.
                url="#{App.BaseUrl}/_healthcheck"
                fail_on_degraded="#{Smoke.FailOnDegraded}"
                deadline=$(( $(date +%s) + 150 ))
                status=""
                while :; do
                    status="$(curl --silent --max-time 10 "$url" || true)"
                    case "$status" in
                        Healthy)
                            echo "Smoke OK: $url is Healthy."
                            exit 0 ;;
                        Degraded)
                            if [ "$fail_on_degraded" != "True" ]; then
                                write_warning "$url is Degraded; accepted because Smoke.FailOnDegraded is $fail_on_degraded (#9016)."
                                exit 0
                            fi ;;
                    esac
                    if [ "$(date +%s)" -ge "$deadline" ]; then
                        fail_step "Smoke test failed: $url returned '$status' for 150 s (Smoke.FailOnDegraded=$fail_on_degraded)."
                    fi
                    sleep 10
                done
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

// TDD only; destructive: the suite empties every [dbo] table before seeding. ADR-C11 interlocks: tdd
// only here and in run-acceptance-tests; the script refuses unless Acceptance.AllowDestructiveReset is
// True (defined for tdd only); tdd data is disposable. It runs on k8s-tdd next to the database.
step "acceptance-tests" {
    name = "Acceptance tests (TDD only)"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool_variable = "Platform.WorkerPool"
        environments = ["tdd"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                $ErrorActionPreference = 'Stop'
                $environmentName = $OctopusParameters['Octopus.Environment.Name']
                $allowReset = $OctopusParameters['Acceptance.AllowDestructiveReset']
                if ($environmentName -ne 'tdd' -or $allowReset -ne 'True') {
                    Fail-Step "Refusing the destructive acceptance suite: environment '$environmentName', Acceptance.AllowDestructiveReset '$allowReset'."
                }
                
                $packageDir = $OctopusParameters['Octopus.Action.Package[ChurchBulletin.AcceptanceTests].ExtractedPath']
                $testDll = Get-ChildItem -Path $packageDir -Filter 'ClearMeasure.Bootcamp.AcceptanceTests.dll' -Recurse | Select-Object -First 1
                if (-not $testDll) { Fail-Step "ClearMeasure.Bootcamp.AcceptanceTests.dll not found in $packageDir" }
                $runSettings = Join-Path $testDll.DirectoryName 'AcceptanceTests.runsettings'
                $playwrightDir = Join-Path $testDll.DirectoryName '.playwright'
                if (Test-Path $playwrightDir) { & chmod -R +x $playwrightDir }
                
                # ADR-IR34: the tdd database runs in the cluster (Service db of workorders-tdd); this worker reaches it because the
                # descriptor sets database.octopusWorkerAccess. Login workorders_app; the in-cluster certificate comes from
                # platform-internal-ca, and NetworkPolicy fences the traffic, so the connection trusts the server certificate.
                $builder = [System.Data.Common.DbConnectionStringBuilder]::new()
                $builder['Server'] = 'tcp:' + $OctopusParameters['Db.Server'] + ',1433'
                $builder['Database'] = $OctopusParameters['Db.Name']
                $builder['User ID'] = $OctopusParameters['Db.AppLogin']
                $builder['Password'] = $OctopusParameters['Octopus.Action[Read deployment secrets].Output.AcceptancePassword']
                $builder['Encrypt'] = 'True'
                $builder['TrustServerCertificate'] = 'True'
                
                # Inputs from ADR-C11; names mirror the legacy TDD run in app:.github/workflows/deploy.yml.
                $env:ConnectionStrings__SqlConnectionString = $builder.ConnectionString
                $env:ApplicationBaseUrl = $OctopusParameters['App.BaseUrl']
                $env:StartLocalServer = 'false'
                $env:AcceptanceTests__AllowDestructiveReset = 'true'
                $env:AI_OpenAI_ApiKey = $OctopusParameters['Octopus.Action[Read deployment secrets].Output.OpenAIKey']
                $env:AI_OpenAI_Url = $OctopusParameters['AI.OpenAIUrl']
                $env:AI_OpenAI_Model = $OctopusParameters['AI.OpenAIModel']
                $env:TEST_INPUT_DELAY_MS = '200'
                
                $results = Join-Path (Get-Location) 'acceptance-results'
                New-Item -ItemType Directory -Path $results -Force | Out-Null
                Write-Host "Acceptance tests against $env:ApplicationBaseUrl with $($testDll.FullName)"
                # 30-minute ceiling with coreutils timeout; exit code 124 means the ceiling was hit.
                & timeout --kill-after=60 1800 dotnet test $testDll.FullName --nologo --logger trx --results-directory $results --settings $runSettings
                $exitCode = $LASTEXITCODE
                
                Get-ChildItem -Path $results -Filter '*.trx' -Recurse | ForEach-Object {
                    New-OctopusArtifact -Path $_.FullName -Name ('acceptance-tdd-' + $_.Name)
                }
                if ($exitCode -eq 124) { Fail-Step 'Acceptance tests exceeded the 30-minute timeout.' }
                if ($exitCode -ne 0) { Fail-Step "Acceptance tests failed (exit code $exitCode); TRX files are attached as artifacts." }
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }

        container {
            feed = "acr-apps"
            image = "#{StepImage.CiDotnet}"
        }

        packages "ChurchBulletin.AcceptanceTests" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "ChurchBulletin.AcceptanceTests"
            properties = {
                Extract = "True"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}

// UAT sign-off after the UAT deployment is verified (ADR-D13).
step "uat-signoff" {
    name = "UAT sign-off"

    action {
        action_type = "Octopus.Manual"
        is_required = true
        environments = ["uat"]
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = <<-EOT
                ## UAT sign-off for release #{Octopus.Release.Number}
                Version and smoke checks passed at #{App.BaseUrl}. Sign off when:
                - The UAT test plan for this release passed.
                - Known defects are recorded in Notes with their disposition.
                
                Proceeding makes this release eligible for Prod; aborting fails the UAT deployment.
                EOT
            Octopus.Action.Manual.ResponsibleTeamIds = "uat-approvers"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

// The automation user answers UAT sign-off only in intervention test mode, with a run reason
// (ADR-IR34 decision 23; CAP-OCT-005). Inline copy of platform-sod-guard without the creator rule.
step "uat-signoff-guard" {
    name = "UAT sign-off guard"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["uat"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Step template platform-sod-guard, inlined (ADR-IR34): the lines between the markers are
                # octopus/step-templates/sod-guard.sh verbatim, checked by the offline drift test.
                SODGUARD_APPROVAL_STEP="UAT sign-off"
                SODGUARD_OTHER_STEPS="Hotfix justification"
                SODGUARD_CHECK_CREATOR="false"
                # >>> octopus/step-templates/sod-guard.sh
                #!/usr/bin/env bash
                # platform-sod-guard: separation of duties and the intervention test mode for one manual intervention
                # (ADR-IR34 decision 23, ADR-IR32; capabilities CAP-OCT-004 and CAP-OCT-005).
                #
                # octopus/terraform creates step template platform-sod-guard from this file. App processes may also inline it: the
                # lines between "# >>> octopus/step-templates/sod-guard.sh" and "# <<< octopus/step-templates/sod-guard.sh" must
                # equal this file (offline drift test in tests/Platform.Conformance.Offline/Octopus/). Bash only; no dollar-brace
                # sequences, because OCL heredocs treat them as template syntax.
                #
                # Inputs, shell variables set by the step header (inline copy) or from the template parameters:
                #   SODGUARD_APPROVAL_STEP  name of the manual intervention whose answer is checked, for example "Prod go/no-go"
                #   SODGUARD_OTHER_STEPS    comma-separated names of other interventions of the deployment; checked only for answers
                #                           by the automation user; interventions that did not run are skipped
                #   SODGUARD_CHECK_CREATOR  "true": the Platform.SoDMode rule applies to the approval step
                # Octopus variables, from library variable set Platform Environment (a project may override them by scope, as the
                # sandbox channel Strict does for Platform.SoDMode):
                #   Platform.SoDMode              single-operator (default): the deployment creator may approve, with a reason in
                #                                 Notes; enforce: the creator may not approve
                #   Platform.InterventionTestMode true: the automation user may answer, only with the reason
                #                                 conformance:<run-id> or e2e:<run-id>; anything else: it may not answer
                #   Platform.AutomationUsername   the automation user (AISF-Service-Account), compared case-insensitively
                # Output variables: SodGuard.Result, SodGuard.Approver, SodGuard.Reason.
                # Manual intervention outputs are addressed by step name (Octopus.Action[<step name>].Output.Manual.*, ADR-IR22).
                # shellcheck disable=SC2154  # the inputs come from the step header
                set -eu -o pipefail
                
                lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
                trim_first_line() { printf '%s\n' "$1" | sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}'; }
                manual_output() { get_octopusvariable "Octopus.Action[$1].Output.Manual.$2"; }
                
                approval_step="$SODGUARD_APPROVAL_STEP"
                other_steps="$SODGUARD_OTHER_STEPS"
                check_creator="$(lower "$SODGUARD_CHECK_CREATOR")"
                [ -n "$approval_step" ] || fail_step "SODGUARD_APPROVAL_STEP is empty; failing closed."
                
                mode="$(lower "$(get_octopusvariable "Platform.SoDMode")")"
                [ -n "$mode" ] || mode="single-operator"
                case "$mode" in
                    single-operator|enforce) ;;
                    *) fail_step "Platform.SoDMode must be single-operator or enforce, not '$mode'." ;;
                esac
                test_mode="$(lower "$(get_octopusvariable "Platform.InterventionTestMode")")"
                automation="$(lower "$(get_octopusvariable "Platform.AutomationUsername")")"
                [ -n "$automation" ] || fail_step "Platform.AutomationUsername is empty (library variable set Platform Environment); failing closed."
                
                # check_automation STEP USERNAME NOTES: the automation user answers only in intervention test mode, and only with a
                # run reason in the first line of Notes.
                check_automation() {
                    if [ "$(lower "$2")" != "$automation" ]; then
                        return 0
                    fi
                    if [ "$test_mode" != "true" ]; then
                        fail_step "Separation of duties: '$1' was answered by the automation user $2 while Platform.InterventionTestMode is not true."
                    fi
                    automation_reason="$(trim_first_line "$3")"
                    if ! printf '%s' "$automation_reason" | grep -Eq '^(conformance|e2e):[A-Za-z0-9._-]+$'; then
                        fail_step "Separation of duties: the automation user answered '$1' without the reason conformance:<run-id> or e2e:<run-id> (Notes: '$automation_reason')."
                    fi
                    write_highlight "'$1' was answered by the automation user in intervention test mode: $automation_reason"
                }
                
                approver_id="$(manual_output "$approval_step" ResponsibleUser.Id)"
                approver="$(manual_output "$approval_step" ResponsibleUser.Username)"
                notes="$(manual_output "$approval_step" Notes)"
                [ -n "$approver_id" ] || fail_step "No answer is recorded for '$approval_step'; failing closed."
                check_automation "$approval_step" "$approver" "$notes"
                
                other_list="$(printf '%s' "$other_steps" | tr ',' '\n')"
                while IFS= read -r other; do
                    other="$(trim_first_line "$other")"
                    [ -n "$other" ] || continue
                    other_user="$(manual_output "$other" ResponsibleUser.Username)"
                    [ -n "$other_user" ] || continue
                    check_automation "$other" "$other_user" "$(manual_output "$other" Notes)"
                done <<< "$other_list"
                
                reason="$(trim_first_line "$notes")"
                if [ "$check_creator" = "true" ]; then
                    creator_id="$(get_octopusvariable "Octopus.Deployment.CreatedBy.Id")"
                    [ -n "$creator_id" ] || fail_step "Cannot read the creator of this deployment; failing closed."
                    if [ "$approver_id" = "$creator_id" ]; then
                        if [ "$mode" = "enforce" ]; then
                            fail_step "Separation of duties (enforce): $approver created this deployment and answered '$approval_step'. Another member of the responsible team must answer."
                        fi
                        [ -n "$reason" ] || fail_step "Separation of duties (single-operator): $approver created this deployment and answered '$approval_step' without a reason in Notes."
                        write_warning "Single-operator mode: $approver created this deployment and answered '$approval_step'. Reason: $reason"
                    fi
                fi
                
                set_octopusvariable "SodGuard.Result" "passed"
                set_octopusvariable "SodGuard.Approver" "$approver"
                set_octopusvariable "SodGuard.Reason" "$reason"
                echo "Separation of duties holds for '$approval_step' (Platform.SoDMode $mode): answered by $approver."
                # <<< octopus/step-templates/sod-guard.sh
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

// TDD only; runs after failures too. Skips itself unless GitHub.StatusEnabled is True (R16, ADR-IR27).
// Credential: the statuses-only GitHub App installed on the application repository only.
step "report-commit-status" {
    name = "Report platform/tdd status"
    condition = "Always"

    action {
        action_type = "Octopus.Script"
        is_required = true
        worker_pool = "hosted-ubuntu"
        environments = ["tdd"]
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -eu
                if [ "#{GitHub.StatusEnabled}" != "True" ]; then
                    echo "Skipped: GitHub.StatusEnabled is not True (R16: the statuses-only GitHub App is not installed yet)."
                    exit 0
                fi
                key="$(get_octopusvariable "GitHub.StatusAppPrivateKey")"
                [ -n "$key" ] || fail_step "GitHub.StatusEnabled is True but the sensitive variable GitHub.StatusAppPrivateKey is empty."
                b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
                now="$(date +%s)"
                header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
                claims="$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "#{GitHub.StatusAppId}" | b64url)"
                key_file="$(mktemp)"
                trap 'rm -f "$key_file"' EXIT
                printf '%s\n' "$key" > "$key_file"
                signature="$(printf '%s.%s' "$header" "$claims" | openssl dgst -sha256 -sign "$key_file" | b64url)"
                jwt="$header.$claims.$signature"
                repo_name="$(printf '%s' "#{GitHub.AppRepository}" | cut -d/ -f2)"
                scope="$(jq -n --arg repo "$repo_name" '{repositories: [$repo], permissions: {statuses: "write"}}')"
                # Tokens go through curl's config on stdin, not the process arguments.
                token="$(printf 'header = "Authorization: Bearer %s"\n' "$jwt" | curl --config - \
                    --fail --silent --show-error --max-time 30 --request POST \
                    --header "Accept: application/vnd.github+json" \
                    --header "X-GitHub-Api-Version: 2022-11-28" \
                    --data "$scope" \
                    "https://api.github.com/app/installations/#{GitHub.StatusAppInstallationId}/access_tokens" | jq -r '.token')"
                [ -n "$token" ] && [ "$token" != "null" ] || fail_step "No installation token for GitHub App #{GitHub.StatusAppId}."
                notes="$(get_octopusvariable "Octopus.Release.Notes")"
                sha="$(printf '%s\n' "$notes" | sed -n -E 's/^app-commit:[[:space:]]*([0-9a-f]{40})[[:space:]]*$/\1/p' | head -n 1)"
                [ -n "$sha" ] || fail_step "No 'app-commit: <40-hex sha>' line in the release notes (§7.7)."
                if [ -n "$(get_octopusvariable "Octopus.Deployment.Error")" ]; then
                    state="failure"; description="TDD deployment or acceptance tests failed"
                else
                    state="success"; description="TDD deployment and acceptance tests passed"
                fi
                target_url="#{Octopus.Web.ServerUri}#{Octopus.Web.DeploymentLink}"
                payload="$(jq -n --arg state "$state" --arg url "$target_url" --arg desc "$description" \
                    --arg ctx "#{GitHub.StatusContext}" '{state: $state, target_url: $url, description: $desc, context: $ctx}')"
                printf 'header = "Authorization: Bearer %s"\n' "$token" | curl --config - \
                    --fail --silent --show-error --max-time 30 --request POST \
                    --header "Accept: application/vnd.github+json" \
                    --header "X-GitHub-Api-Version: 2022-11-28" \
                    --data "$payload" --output /dev/null \
                    "https://api.github.com/repos/#{GitHub.AppRepository}/statuses/$sha"
                echo "Posted #{GitHub.StatusContext}=$state to #{GitHub.AppRepository}@$sha."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }

        container {
            feed = "docker-hub"
            image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
        }
    }
}
