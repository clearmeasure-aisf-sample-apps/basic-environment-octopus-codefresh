variable "App.BaseUrl" {
    value "https://sandbox-#{Octopus.Environment.Name}.#{Platform.AppsDomain}" {}
}

variable "App.VersionPath" {
    value "/version" {}
}

variable "App.HealthPath" {
    value "/healthz" {}
}

variable "Argo.VerificationTimeoutSeconds" {
    value "900" {}
}

variable "Platform.SoDMode" {
    value "enforce" {
        channel = ["strict"]
    }
}

variable "Wake.WaitMinutes" {
    value "30" {
        process = ["db-restore"]

        prompt {
            label = "Wait for the cluster (minutes)"
            description = "How long the first step waits for a sleeping cluster before it fails with guidance."
            required = false
        }
    }
}

variable "Restore.BackupName" {
    value "" {
        process = ["db-restore"]

        prompt {
            label = "Backup name"
            description = "Blob name in container <app>-<env> of the tier's backup account; empty restores the latest backup."
            required = false
        }
    }
}
