// Runbook `env-sleep` of project `workorders-infrastructure` (ADR-IR33, sleep/wake contract).
// Environments: infra-nonprod and infra-prod. Hourly scheduled triggers env-sleep-hourly-nonprod and
// env-sleep-hourly-prod (octopus/terraform/projects.tf). By hand, with the prompted variable Sleep.Force
// (force-sleep, docs/runbooks/sleep-and-wake.md).
// A cluster serves several environments: aks-workorders-nonprod serves tdd and uat, aks-workorders-prod serves prod,
// plus this infrastructure environment. Tasks count for every project there, so idle is measured across all apps.
// 1. Decide sleep (Octopus REST, Platform.OctopusApiKey), first match wins:
//    - Sleep.Enabled is not true: stay; nothing is stopped.
//    - A deployment or runbook run in those environments is Queued or Executing, this run excluded: stay.
//      Sleep.Force never overrides this.
//    - Sleep.Force is true: sleep; the log names who forced it.
//    - Outside Sleep.WorkDays from Sleep.WorkdayStart to Sleep.WorkdayEnd in Sleep.TimeZone: sleep.
//    - The newest completed task there (env-wake included; env-sleep and provisioner-credential-check excluded)
//      is older than Sleep.IdleMinutes: sleep. Otherwise stay.
//    Outputs Sleep.Decision (sleep or stay) and Sleep.Reason; the decision is logged as a highlight.
// 2. Stop cluster (Azure.LifecycleAccount), only after "sleep" (ADR-IR33 rule 5): enables the alert processing rule
//    apr-sleep-<cluster> in rg-workorders-aks-<cluster> so that a stopped cluster never pages anyone, reads the task
//    list again, then stops the cluster without waiting. Busy, an error or a rejected stop disables the rule again;
//    a rejected stop fails the run. The next env-wake starts the cluster again.
// Concurrency: env-sleep and env-wake share Octopus.Task.ConcurrencyTag cluster-power/#{Octopus.Environment.Id}.
// Both steps run on the dynamic pool hosted-ubuntu. Guided failure is off: an hourly run never waits for a person.
// REST endpoints and az flags marked [VERIFY] are unconfirmed against the platform space.

name = "env-sleep"
description = "Hourly: stops the cluster of this environment when idle or outside the working window, unless a task is queued or executing."
default_guided_failure_mode = "Off"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Count"
    quantity_to_keep = 72
}

process {
    step "decide-sleep" {
        name = "Decide sleep"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu -o pipefail
                    infra_environment="#{Octopus.Environment.Name}"
                    decide() {
                        set_octopusvariable "Sleep.Decision" "$1"
                        set_octopusvariable "Sleep.Reason" "$2"
                        write_highlight "env-sleep in $infra_environment: $1 ($2)"
                        exit 0
                    }
                    enabled="$(printf '%s' "#{Sleep.Enabled}" | tr '[:upper:]' '[:lower:]')"
                    force="$(printf '%s' "#{Sleep.Force}" | tr '[:upper:]' '[:lower:]')"
                    if [ "$enabled" != "true" ]; then
                        [ "$force" != "true" ] || write_warning "Sleep.Force is ignored: Sleep.Enabled is '$enabled' in $infra_environment."
                        decide stay "Sleep.Enabled is '$enabled'"
                    fi
                    octopus_url="$(printf '%s' "#{Octopus.Web.ServerUri}" | sed 's#/*$##')"
                    space_id="#{Octopus.Space.Id}"
                    api_key="$(get_octopusvariable "Platform.OctopusApiKey")"
                    [ -n "$api_key" ] || fail_step "Platform.OctopusApiKey is empty in this step: octopus/terraform scopes it to the REST-calling steps of workorders-infrastructure (S5)."
                    command -v jq >/dev/null 2>&1 || fail_step "jq is missing from the step container."
                    # Octopus REST call; prints the response body. The key reaches curl through its configuration on stdin, never
                    # through the process arguments. Usage: octopus_api METHOD PATH [JSON-BODY]
                    octopus_api() {
                        if [ "$#" -ge 3 ]; then
                            printf 'header = "X-Octopus-ApiKey: %s"\n' "$api_key" |
                                curl --config - --fail --silent --show-error --max-time 60 --request "$1" \
                                    --header "Accept: application/json" --header "Content-Type: application/json" --data "$3" "$octopus_url$2"
                        else
                            printf 'header = "X-Octopus-ApiKey: %s"\n' "$api_key" |
                                curl --config - --fail --silent --show-error --max-time 60 --request "$1" \
                                    --header "Accept: application/json" "$octopus_url$2"
                        fi
                    }
                    # lookup COLLECTION NAME sets found_id to the id of the only item of that name in this space, or fails the step.
                    lookup() {
                        listing="$(octopus_api GET "/api/$space_id/$1?partialName=$2&take=100")" ||
                            fail_step "Octopus REST call for $1 '$2' failed; check Platform.OctopusApiKey (octopus/terraform, step-scoped)."
                        found_id="$(printf '%s' "$listing" | jq -r --arg name "$2" '[.Items[] | select(.Name == $name)] | if length == 1 then .[0].Id else "" end')" || found_id=""
                        [ -n "$found_id" ] || fail_step "No single item named '$2' in $1 of space $space_id."
                    }
                    class="#{Environment.Class}"
                    case "$class" in
                        nonprod|prod) ;;
                        *) fail_step "Environment.Class '$class' must be nonprod or prod." ;;
                    esac
                    case "$class" in
                        nonprod) app_environments="tdd uat" ;;
                        *) app_environments="prod" ;;
                    esac
                    self_task="#{Octopus.Task.Id}"
                    environment_ids=""
                    for environment in $app_environments "#{Octopus.Environment.Name}"; do
                        lookup environments "$environment"
                        environment_ids="$environment_ids $found_id"
                    done
                    list_file="$(mktemp)"
                    # list_tasks ENVIRONMENT STATES TAKE writes one line per task, newest first, to list_file: id, state, queue time,
                    # completed time and description, tab-separated, "-" when empty [VERIFY task list filters environment and states].
                    list_tasks() {
                        tasks_json="$(octopus_api GET "/api/$space_id/tasks?environment=$1&states=$2&take=$3")" || return 1
                        printf '%s' "$tasks_json" |
                            jq -r 'def v: if . == null or . == "" then "-" else tostring end;
                                .Items[] | [(.Id | v), (.State | v), (.QueueTime | v), (.CompletedTime | v), (.Description | v)] | @tsv' > "$list_file"
                    }
                    # busy_task sets busy to the first queued or executing deployment or runbook run other than this run, or to
                    # nothing. A task queued to start more than 15 minutes from now (a scheduled deployment) does not count.
                    busy_task() {
                        busy=""
                        now_busy="$(date +%s)"
                        for environment_id in $environment_ids; do
                            list_tasks "$environment_id" "Queued,Executing,Cancelling" 100 ||
                                fail_step "Cannot read the Octopus task list; nothing is stopped."
                            while IFS=$'\t' read -r id state queued _ description; do
                                [ "$id" != "$self_task" ] || continue
                                if [ "$state" = "Queued" ] && [ "$queued" != "-" ]; then
                                    queued_at="$(date -u -d "$queued" +%s 2>/dev/null)" || queued_at="$now_busy"
                                    [ "$queued_at" -le $(( now_busy + 900 )) ] || continue
                                fi
                                busy="$id ($state: $description)"
                                return 0
                            done < "$list_file"
                        done
                    }
                    # 1. Never while a deployment or runbook run is queued or executing (this run excluded).
                    busy_task
                    [ -z "$busy" ] || decide stay "busy: $busy"
                    # 2. Sleep.Force, prompted when run by hand (default false), skips the working-window and idle checks.
                    if [ "$force" = "true" ]; then
                        # [VERIFY that runbook runs populate Octopus.Deployment.CreatedBy.*]
                        forced_by="$(get_octopusvariable "Octopus.Deployment.CreatedBy.Username")"
                        [ -n "$forced_by" ] || forced_by="$(get_octopusvariable "Octopus.Deployment.CreatedBy.DisplayName")"
                        [ -n "$forced_by" ] || forced_by="an unidentified user"
                        write_warning "Sleep.Force set by $forced_by: working-window and idle checks skipped."
                        decide sleep "forced by $forced_by"
                    fi
                    # 3. Outside the working window: Sleep.WorkDays, Sleep.WorkdayStart to Sleep.WorkdayEnd, in Sleep.TimeZone.
                    timezone="#{Sleep.TimeZone}"
                    workdays=",$(printf '%s' "#{Sleep.WorkDays}" | tr -d ' '),"
                    start="$(printf '%s' "#{Sleep.WorkdayStart}" | tr -d ':')"
                    end="$(printf '%s' "#{Sleep.WorkdayEnd}" | tr -d ':')"
                    case "$start$end" in
                        [0-2][0-9][0-5][0-9][0-2][0-9][0-5][0-9]) ;;
                        *) fail_step "Sleep.WorkdayStart and Sleep.WorkdayEnd must look like 07:00 and 19:00." ;;
                    esac
                    if [ -e "/usr/share/zoneinfo/$timezone" ]; then
                        day="$(TZ="$timezone" LC_ALL=C date +%a)"
                        clock="$(TZ="$timezone" date +%H%M)"
                        in_window="false"
                        case "$workdays" in
                            *",$day,"*)
                                if [ "$clock" -ge "$start" ] && [ "$clock" -lt "$end" ]; then
                                    in_window="true"
                                fi ;;
                        esac
                        [ "$in_window" = "true" ] || decide sleep "outside the working window: $day $clock $timezone"
                    else
                        # [VERIFY tzdata in the worker-tools image]
                        write_warning "Time zone $timezone is not installed in the step container; only the idle rule applies."
                    fi
                    # 4. Idle: the newest completed deployment or runbook run of any project in these environments, env-wake included.
                    #    The hourly env-sleep and the daily provisioner-credential-check do not count
                    #    [VERIFY that task descriptions name the runbook].
                    idle_minutes="#{Sleep.IdleMinutes}"
                    case "$idle_minutes" in
                        ''|*[!0-9]*) fail_step "Sleep.IdleMinutes must be a whole number of minutes; got '$idle_minutes'." ;;
                    esac
                    now="$(date +%s)"
                    last=0
                    last_what="none"
                    for environment_id in $environment_ids; do
                        list_tasks "$environment_id" "Success,Failed,Canceled,TimedOut" 50 ||
                            fail_step "Cannot read the Octopus task list; nothing is stopped."
                        while IFS=$'\t' read -r id state _ completed description; do
                            case "$(printf '%s' "$description" | tr '[:upper:]' '[:lower:]')" in
                                *env-sleep*|*provisioner-credential-check*) continue ;;
                            esac
                            [ "$completed" != "-" ] || continue
                            completed_at="$(date -u -d "$completed" +%s 2>/dev/null)" || continue
                            if [ "$completed_at" -gt "$last" ]; then
                                last="$completed_at"
                                last_what="$id ($state: $description)"
                            fi
                        done < "$list_file"
                    done
                    [ "$last" -gt 0 ] || decide sleep "idle: no completed task among the last 50 of each environment"
                    idle=$(( (now - last) / 60 ))
                    [ "$idle" -lt "$idle_minutes" ] || decide sleep "idle for $idle minutes, limit $idle_minutes; last: $last_what"
                    decide stay "active $idle minutes ago, limit $idle_minutes; last: $last_what"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:<worker-tools-version>"
            }
        }
    }

    // Runs only after the decision "sleep"; the script checks the decision again.
    step "stop-cluster" {
        name = "Stop cluster"
        condition = "Variable"
        properties = {
            Octopus.Action.ConditionVariableExpression = "#{unless Octopus.Deployment.Error}#{if Octopus.Action[Decide sleep].Output.Sleep.Decision == \"sleep\"}true#{/if}#{/unless}"
        }

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu -o pipefail
                    decision="$(get_octopusvariable "Octopus.Action[Decide sleep].Output.Sleep.Decision")"
                    reason="$(get_octopusvariable "Octopus.Action[Decide sleep].Output.Sleep.Reason")"
                    if [ "$decision" != "sleep" ]; then
                        echo "Staying awake: $reason"
                        exit 0
                    fi
                    class="#{Environment.Class}"
                    case "$class" in
                        nonprod|prod) ;;
                        *) fail_step "Environment.Class '$class' must be nonprod or prod." ;;
                    esac
                    cluster="aks-workorders-$class"
                    rg="rg-workorders-aks-$class"
                    rule="apr-sleep-$class"
                    # Power state and provisioning state on one line, for example "Running Succeeded".
                    aks_state() {
                        az aks show --resource-group "$rg" --name "$cluster" --query "[powerState.code, provisioningState]" --output tsv | tr '\t\n' '  '
                    }
                    # Alert processing rule apr-sleep-<cluster>: terraform/environment (monitoring.tf) creates it disabled in the
                    # cluster's resource group, and only env-sleep and env-wake toggle it. Absent before that layer adds it.
                    rule_exists() {
                        az monitor alert-processing-rule show --resource-group "$rg" --name "$rule" --output none 2>/dev/null
                    }
                    if ! state="$(aks_state)"; then
                        write_warning "Cluster $cluster was not found in $rg; nothing to stop."
                        exit 0
                    fi
                    read -r power provisioning <<< "$state"
                    case "$power:$provisioning" in
                        Stopped:*)
                            echo "$cluster is already stopped."
                            exit 0 ;;
                        Running:Succeeded|Running:Failed) ;;
                        *)
                            write_warning "$cluster is $power/$provisioning; the next hourly run decides again."
                            exit 0 ;;
                    esac
                    octopus_url="$(printf '%s' "#{Octopus.Web.ServerUri}" | sed 's#/*$##')"
                    space_id="#{Octopus.Space.Id}"
                    api_key="$(get_octopusvariable "Platform.OctopusApiKey")"
                    [ -n "$api_key" ] || fail_step "Platform.OctopusApiKey is empty in this step: octopus/terraform scopes it to the REST-calling steps of workorders-infrastructure (S5)."
                    command -v jq >/dev/null 2>&1 || fail_step "jq is missing from the step container."
                    # Octopus REST call; prints the response body. The key reaches curl through its configuration on stdin, never
                    # through the process arguments. Usage: octopus_api METHOD PATH [JSON-BODY]
                    octopus_api() {
                        if [ "$#" -ge 3 ]; then
                            printf 'header = "X-Octopus-ApiKey: %s"\n' "$api_key" |
                                curl --config - --fail --silent --show-error --max-time 60 --request "$1" \
                                    --header "Accept: application/json" --header "Content-Type: application/json" --data "$3" "$octopus_url$2"
                        else
                            printf 'header = "X-Octopus-ApiKey: %s"\n' "$api_key" |
                                curl --config - --fail --silent --show-error --max-time 60 --request "$1" \
                                    --header "Accept: application/json" "$octopus_url$2"
                        fi
                    }
                    # lookup COLLECTION NAME sets found_id to the id of the only item of that name in this space, or fails the step.
                    lookup() {
                        listing="$(octopus_api GET "/api/$space_id/$1?partialName=$2&take=100")" ||
                            fail_step "Octopus REST call for $1 '$2' failed; check Platform.OctopusApiKey (octopus/terraform, step-scoped)."
                        found_id="$(printf '%s' "$listing" | jq -r --arg name "$2" '[.Items[] | select(.Name == $name)] | if length == 1 then .[0].Id else "" end')" || found_id=""
                        [ -n "$found_id" ] || fail_step "No single item named '$2' in $1 of space $space_id."
                    }
                    case "$class" in
                        nonprod) app_environments="tdd uat" ;;
                        *) app_environments="prod" ;;
                    esac
                    self_task="#{Octopus.Task.Id}"
                    environment_ids=""
                    for environment in $app_environments "#{Octopus.Environment.Name}"; do
                        lookup environments "$environment"
                        environment_ids="$environment_ids $found_id"
                    done
                    list_file="$(mktemp)"
                    # list_tasks ENVIRONMENT STATES TAKE writes one line per task, newest first, to list_file: id, state, queue time,
                    # completed time and description, tab-separated, "-" when empty [VERIFY task list filters environment and states].
                    list_tasks() {
                        tasks_json="$(octopus_api GET "/api/$space_id/tasks?environment=$1&states=$2&take=$3")" || return 1
                        printf '%s' "$tasks_json" |
                            jq -r 'def v: if . == null or . == "" then "-" else tostring end;
                                .Items[] | [(.Id | v), (.State | v), (.QueueTime | v), (.CompletedTime | v), (.Description | v)] | @tsv' > "$list_file"
                    }
                    # busy_task sets busy to the first queued or executing deployment or runbook run other than this run, or to
                    # nothing. A task queued to start more than 15 minutes from now (a scheduled deployment) does not count.
                    busy_task() {
                        busy=""
                        now_busy="$(date +%s)"
                        for environment_id in $environment_ids; do
                            list_tasks "$environment_id" "Queued,Executing,Cancelling" 100 ||
                                fail_step "Cannot read the Octopus task list; nothing is stopped."
                            while IFS=$'\t' read -r id state queued _ description; do
                                [ "$id" != "$self_task" ] || continue
                                if [ "$state" = "Queued" ] && [ "$queued" != "-" ]; then
                                    queued_at="$(date -u -d "$queued" +%s 2>/dev/null)" || queued_at="$now_busy"
                                    [ "$queued_at" -le $(( now_busy + 900 )) ] || continue
                                fi
                                busy="$id ($state: $description)"
                                return 0
                            done < "$list_file"
                        done
                    }
                    # ADR-IR33 rule 5: suppress alerts, read the task list again, then stop. Alerts never stay muted on a running
                    # cluster: on any exit before the stop is accepted (busy, error, rejected stop) the rule is disabled again.
                    rule_on="false"
                    stopped="false"
                    restore_alerts() {
                        if [ "$rule_on" = "true" ] && [ "$stopped" != "true" ]; then
                            if az monitor alert-processing-rule update --resource-group "$rg" --name "$rule" --enabled false --output none; then
                                echo "Alert processing rule $rule disabled again: $cluster keeps running."
                            else
                                write_warning "Could not disable $rule again; disable it by hand (docs/runbooks/sleep-and-wake.md)."
                            fi
                        fi
                    }
                    trap restore_alerts EXIT
                    if rule_exists; then
                        # [VERIFY az monitor alert-processing-rule update --enabled]
                        az monitor alert-processing-rule update --resource-group "$rg" --name "$rule" --enabled true --output none
                        rule_on="true"
                        echo "Alert processing rule $rule enabled."
                    else
                        write_warning "Alert processing rule $rule was not found in $rg; stopping without muting alerts."
                    fi
                    # A deployment or an env-wake may have been queued since the decision.
                    busy_task
                    if [ -n "$busy" ]; then
                        write_highlight "Not stopping $cluster: busy: $busy"
                        exit 0
                    fi
                    az aks stop --resource-group "$rg" --name "$cluster" --no-wait || fail_step "Stopping $cluster was rejected (see above)."
                    stopped="true"
                    write_highlight "Stopping $cluster: $reason"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:<worker-tools-version>"
            }
        }
    }
}
