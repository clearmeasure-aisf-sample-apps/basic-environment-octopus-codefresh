// Runbook `env-plan` of project `workorders-infrastructure` (platform-design §7.2, ADR-D10).
// Environments: infra-nonprod, infra-prod. Read-only: plans terraform/environment and saves the plan as an artifact.
//
// File layout confirmed (https://octopus.com/docs/runbooks/config-as-code-runbooks). Runbook-level environment
// scope has no documented OCL attribute [VERIFY in an export]; action-level environments enforce it.
//
// Terraform step settings shared by env-plan, env-apply and env-destroy (keys from the OCL catalog:
// https://github.com/OctopusDeploy/github-agent-plugin/blob/main/skills/writing-ocl/references/action-types.md):
// - Template source: the project Git repository (Octopus.Action.GitRepository.Source = "Project"), directory
//   terraform/environment, at the commit of the run (E29; https://octopus.com/docs/deployments/terraform/working-with-built-in-steps).
// - Account: Azure.LifecycleAccount (ADR-C10: the stored principal in infra-nonprod for phases 1-2, OIDC otherwise).
//   Environment variables the account integration sets for the azurerm backend and providers (ARM_* for a
//   client secret; OIDC token variables for OIDC accounts) are [VERIFY] for OIDC.
// - Backend: partial azurerm backend completed from library variable set `WorkOrders Infrastructure` through
//   -backend-config; use_azuread_auth because the state account disables shared keys (§7.10).
//   Assumes terraform/environment declares `backend "azurerm" {}` (sre-security package).
// - Variable substitution in *.tf files is off (E29): the template is used as committed.
// - Inputs of terraform/environment (§7.2, ADR-IR1, ADR-IR14, ADR-IR15):
//   * VarFiles reads terraform/environment/<class>.tfvars, committed to the private environment repo from
//     <class>.tfvars.example at bootstrap. It holds identifiers and sizing, never a secret.
//   * Secrets arrive as environment variables from Octopus sensitive variables, never from files:
//     TF_VAR_octopus_worker_registration_token <- Octopus.WorkerRegistrationToken (ADR-D14) and
//     TF_VAR_argocd_repo_read_credential <- ArgoCD.RepoReadCredential (JSON, escaped with the JsonEscape
//     filter [VERIFY]). Both are ephemeral in the layer, so they never enter plan or state.
// - Container octopusdeploy/worker-tools:<worker-tools-version> on the dynamic pool Hosted Ubuntu (§7.2), pulled
//   through the Docker Hub feed `docker-hub` that octopus/terraform/feeds.tf creates (ADR-IR6).
// - Plans cannot be saved and applied later ("The plan steps do not support saving the plan to a file",
//   https://octopus.com/docs/deployments/terraform/plan-terraform); the plan text is kept as an artifact.

name = "env-plan"
description = "Plans terraform/environment for the class of the selected environment and attaches the plan as an artifact."
default_guided_failure_mode = "EnvironmentDefault"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    // Sleep/wake (ADR-IR33): first, run env-wake in this environment through the Octopus REST API and wait for it:
    // Terraform reads in-cluster resources. Skips when the cluster does not exist yet (the first env-apply creates it).
    step "wake-environment" {
        name = "Wake environment"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu -o pipefail
                    # Sleep/wake (ADR-IR33): wake the cluster of this infrastructure environment first. Before the first env-apply
                    # the cluster does not exist: then there is nothing to wake.
                    caller_environment="#{Octopus.Environment.Name}"
                    target="$caller_environment"
                    class="#{Environment.Class}"
                    if ! err="$(az aks show --resource-group "rg-workorders-aks-$class" --name "aks-workorders-$class" --output none 2>&1)"; then
                        case "$err" in
                            *ResourceNotFound*|*ResourceGroupNotFound*|*"was not found"*)
                                write_highlight "Cluster aks-workorders-$class does not exist yet: nothing to wake."
                                exit 0 ;;
                            *) fail_step "Cannot read cluster aks-workorders-$class: $err" ;;
                        esac
                    fi
                    octopus_url="$(printf '%s' "#{Octopus.Web.ServerUri}" | sed 's#/*$##')"
                    space_id="#{Octopus.Space.Id}"
                    api_key="$(get_octopusvariable "Platform.OctopusApiKey")"
                    [ -n "$api_key" ] || fail_step "Platform.OctopusApiKey is empty in this step: octopus/terraform scopes it to the REST-calling steps of workorders-infrastructure (S5)."
                    command -v jq >/dev/null 2>&1 || fail_step "jq is missing from the step container."
                    # Octopus REST call; prints the response body. The key reaches curl through its configuration on stdin, never
                    # through the process arguments. Usage: octopus_api METHOD PATH [JSON-BODY]
                    octopus_api() {
                        if [ "$#" -ge 3 ]; then
                            printf 'header = "X-Octopus-ApiKey: %s"\n' "$api_key" |
                                curl --config - --fail --silent --show-error --max-time 60 --request "$1" \
                                    --header "Accept: application/json" --header "Content-Type: application/json" --data "$3" "$octopus_url$2"
                        else
                            printf 'header = "X-Octopus-ApiKey: %s"\n' "$api_key" |
                                curl --config - --fail --silent --show-error --max-time 60 --request "$1" \
                                    --header "Accept: application/json" "$octopus_url$2"
                        fi
                    }
                    # lookup COLLECTION NAME sets found_id to the id of the only item of that name in this space, or fails the step.
                    lookup() {
                        listing="$(octopus_api GET "/api/$space_id/$1?partialName=$2&take=100")" ||
                            fail_step "Octopus REST call for $1 '$2' failed; check Platform.OctopusApiKey (octopus/terraform, step-scoped)."
                        found_id="$(printf '%s' "$listing" | jq -r --arg name "$2" '[.Items[] | select(.Name == $name)] | if length == 1 then .[0].Id else "" end')" || found_id=""
                        [ -n "$found_id" ] || fail_step "No single item named '$2' in $1 of space $space_id."
                    }
                    lookup projects workorders-infrastructure
                    project_id="$found_id"
                    lookup environments "$target"
                    environment_id="$found_id"
                    payload="$(jq -n --arg env "$environment_id" '{SelectedPackages: [], SelectedGitResources: [], Runs: [{EnvironmentId: $env, TenantId: null, SkipActions: [], SpecificMachineIds: [], ExcludedMachineIds: []}]}')"
                    # Config-as-code runbook run from the default branch [VERIFY endpoint and response shape: OctopusDeploy-Api sample
                    # REST/PowerShell/Runbooks/RunConfigAsCodeRunbook.ps1; the response is expected to carry a ServerTaskId].
                    response="$(octopus_api POST "/api/spaces/$space_id/projects/$project_id/refs%2Fheads%2Fmain/runbooks/env-wake/run/v1" "$payload")" ||
                        fail_step "Octopus refused to run env-wake in $target."
                    task_id="$(printf '%s' "$response" | jq -r '[.. | objects | (.ServerTaskId? // .TaskId? // empty) | strings] | first // ""')"
                    [ -n "$task_id" ] || fail_step "Octopus returned no task for env-wake in $target: $response"
                    echo "env-wake is running in $target: $octopus_url/app#/$space_id/tasks/$task_id"
                    # Ceiling: Wake.TimeoutMinutes for the cluster, again for the workers, plus queueing.
                    deadline=$(( $(date +%s) + 3600 ))
                    while :; do
                        task="$(octopus_api GET "/api/$space_id/tasks/$task_id")" || task=""
                        if [ -n "$task" ] && [ "$(printf '%s' "$task" | jq -r '.IsCompleted')" = "true" ]; then
                            if [ "$(printf '%s' "$task" | jq -r '.FinishedSuccessfully')" = "true" ]; then
                                write_highlight "The cluster of $caller_environment is awake (env-wake in $target, $task_id)."
                                exit 0
                            fi
                            fail_step "env-wake in $target ended $(printf '%s' "$task" | jq -r '.State'): $(printf '%s' "$task" | jq -r '.ErrorMessage // ""')"
                        fi
                        [ "$(date +%s)" -lt "$deadline" ] || fail_step "env-wake in $target ($task_id) did not finish within 60 minutes."
                        sleep 15
                    done
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:<worker-tools-version>"
            }
        }
    }

    step "plan-environment" {
        name = "Plan environment"

        action {
            action_type = "Octopus.TerraformPlan"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.AzureAccount.Variable = "Azure.LifecycleAccount"
                Octopus.Action.GitRepository.Source = "Project"
                Octopus.Action.Script.ScriptSource = "GitRepository"
                Octopus.Action.Terraform.AdditionalActionParams = "-lock-timeout=300s"
                Octopus.Action.Terraform.AdditionalInitParams = "-backend-config=resource_group_name=#{Terraform.StateResourceGroup} -backend-config=storage_account_name=#{Terraform.StateStorageAccount} -backend-config=container_name=#{Terraform.StateContainer} -backend-config=key=#{Terraform.StateKey} -backend-config=use_azuread_auth=true"
                Octopus.Action.Terraform.AllowPluginDownloads = "True"
                Octopus.Action.Terraform.AzureAccount = "True"
                Octopus.Action.Terraform.EnvVariables = "{\"TF_VAR_octopus_worker_registration_token\":\"#{if Octopus.WorkerRegistrationToken}#{Octopus.WorkerRegistrationToken}#{/if}\",\"TF_VAR_argocd_repo_read_credential\":\"#{if ArgoCD.RepoReadCredential}#{ArgoCD.RepoReadCredential | JsonEscape}#{/if}\"}"
                Octopus.Action.Terraform.ManagedAccount = "None"
                Octopus.Action.Terraform.PlanJsonOutput = "False"
                Octopus.Action.Terraform.RunAutomaticFileSubstitution = "False"
                Octopus.Action.Terraform.TemplateDirectory = "terraform/environment"
                Octopus.Action.Terraform.VarFiles = "#{Environment.Class}.tfvars"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:<worker-tools-version>"
            }
        }
    }

    // Keeps the plan text as an artifact and enforces the layer boundary: the environment layer creates no
    // role assignments, locks or resource groups (ADR-D10, §5.4).
    step "save-and-check-plan" {
        name = "Save and check plan"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod", "infra-prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu
                    plan_file="terraform-plan-#{Environment.Class}.txt"
                    get_octopusvariable "Octopus.Action[Plan environment].Output.TerraformPlanOutput" > "$plan_file"
                    [ -s "$plan_file" ] || fail_step "Plan environment produced no plan output."
                    new_octopusartifact "$(pwd)/$plan_file" "$plan_file"
                    # Resource change headers look like "  # azurerm_x.name will be created"; data sources are excluded.
                    if grep -E -q '^[[:space:]]*# (module\.[^[:space:]]+\.)?azurerm_(role_assignment|management_lock|resource_group)\.' "$plan_file"; then
                        fail_step "The plan touches role assignments, locks or resource groups; those belong to terraform/foundation (ADR-D10)."
                    fi
                    echo "Plan saved as artifact $plan_file; layer boundary holds."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }
}
