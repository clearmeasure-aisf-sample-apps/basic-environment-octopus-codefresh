// Project `workorders-infrastructure`: non-sensitive project variables (platform-design §7.2).
//
// Not in Git (config-as-code keeps sensitive variables in the Octopus database, E26):
// - Octopus.WorkerRegistrationToken (Sensitive): short-lived; entered before each env-apply that installs
//   Kubernetes workers (ADR-D14). Passed as TF_VAR_octopus_worker_registration_token; write-only in the layer,
//   so it stays out of plan and state (it does live in the in-cluster Helm release Secret).
// - ArgoCD.RepoReadCredential (Sensitive): the read-only environment-repo credential as the JSON object that
//   argocd/clusters/<cluster>/platform-secrets.yaml describes (ADR-IR15). Passed as
//   TF_VAR_argocd_repo_read_credential; it seeds Secret argocd-repo-creds once per cluster build.
// Supplied by library variable set `WorkOrders Infrastructure` (octopus/terraform):
//   Environment.Class, Terraform.StateResourceGroup, Terraform.StateStorageAccount, Terraform.StateContainer,
//   Terraform.StateKey.
// Supplied by octopus/terraform as a sensitive project variable scoped to the steps that call the Octopus REST API
// (ADR-IR33, S5): Platform.OctopusApiKey, the automation user's key (ADR-IR32), in steps wake-environment (env-plan,
//   env-apply, env-destroy, rotate-sql-passwords), wait-for-workers-and-gateway (env-wake), decide-sleep and
//   stop-cluster (env-sleep). They use it to run env-wake and to read tasks. The Terraform steps and the in-cluster
//   steps never receive it. Only platform-owned projects hold the key (multi-app directive §10); platform-wake
//   includes library variable set `WorkOrders Platform Automation` instead, because it has one step.
// Library variable set `Azure Runtime Provisioning` is included in no project (ADR-C10, §5.3): the built-in
// Terraform and Azure script steps use the account directly.

// ADR-C10 / R4. infra-nonprod uses the stored client-secret principal in phases 1-2 only. At the phase-2 exit,
// a reviewed pull request changes that value to "azure-oidc-env-lifecycle-nonprod" and the secret is retired.
// infra-prod uses OIDC from its first apply; the stored account is never valid there.
variable "Azure.LifecycleAccount" {
    type = "AzureAccount"

    value "azure-runtime-provisioner" {
        environment = ["infra-nonprod"]
    }
    value "azure-oidc-env-lifecycle-prod" {
        environment = ["infra-prod"]
    }
}

// Expiry date of the stored principal's client secret, entered by a person (YYYY-MM-DD) through a pull request.
// provisioner-credential-check warns 14 days ahead and fails once it has passed; the placeholder fails the check.
variable "Provisioner.SecretExpiresOn" {
    value "<provisioner-secret-expires-on>" {
        environment = ["infra-nonprod"]
    }
}

// Same name and value as in project `workorders` (§7.2, ADR-IR11): configure-db-principals-<env> and
// rotate-sql-passwords need az CLI and go-sqlcmd inside the cluster network. Pinned by digest (ADR-IR19);
// consistency.sh C14 fails when the references differ.
variable "StepImage.CiDotnet" {
    value "<acr-name>.azurecr.io/platform/ci-dotnet:<ci-image-version>@sha256:<ci-image-digest>" {}
}

// --- Sleep by default, wake on the first job (ADR-IR33) ----------------------------------------------------------
// Read by runbooks env-sleep and env-wake. One value for each infrastructure environment, so that each cluster can
// be tuned on its own. docs/runbooks/sleep-and-wake.md describes force-wake, force-sleep and pausing sleep.

// "false" pauses sleeping: env-sleep then stops nothing. Both are "true" on this sample platform with no real
// users (user cost directive); a real production sets infra-prod to "false" (ADR-IR33, R29).
variable "Sleep.Enabled" {
    value "true" {
        environment = ["infra-nonprod"]
    }
    value "true" {
        environment = ["infra-prod"]
    }
}

// IANA time zone of the working window.
variable "Sleep.TimeZone" {
    value "America/Chicago" {
        environment = ["infra-nonprod"]
    }
    value "America/Chicago" {
        environment = ["infra-prod"]
    }
}

// Working days, as `date +%a` prints them in the C locale.
variable "Sleep.WorkDays" {
    value "Mon,Tue,Wed,Thu,Fri" {
        environment = ["infra-nonprod"]
    }
    value "Mon,Tue,Wed,Thu,Fri" {
        environment = ["infra-prod"]
    }
}

// Working window, HH:MM in Sleep.TimeZone. Outside it, env-sleep stops a cluster that runs no task.
variable "Sleep.WorkdayStart" {
    value "07:00" {
        environment = ["infra-nonprod"]
    }
    value "07:00" {
        environment = ["infra-prod"]
    }
}

variable "Sleep.WorkdayEnd" {
    value "19:00" {
        environment = ["infra-nonprod"]
    }
    value "19:00" {
        environment = ["infra-prod"]
    }
}

// Inside the working window, env-sleep stops the cluster once the newest completed task in its environments
// (env-wake included) is older than this.
variable "Sleep.IdleMinutes" {
    value "120" {
        environment = ["infra-nonprod"]
    }
    value "120" {
        environment = ["infra-prod"]
    }
}

// env-wake: the longest wait for Running, and again for the Kubernetes workers to report healthy.
variable "Wake.TimeoutMinutes" {
    value "20" {
        environment = ["infra-nonprod"]
    }
    value "20" {
        environment = ["infra-prod"]
    }
}

// Prompted when env-sleep is run by hand (ADR-IR33 rule 4). "true" skips the working-window and idle checks;
// env-sleep still never stops a cluster while a deployment or runbook run is queued or executing, and the log
// names who forced it. Scheduled runs use the default "false".
variable "Sleep.Force" {
    value "false" {
        process = ["env-sleep"]

        prompt {
            label = "Force sleep"
            description = "true stops the cluster now, skipping the working-window and idle checks. A queued or executing deployment or runbook run still prevents the stop."
            required = false
        }
    }
}

// ADR-IR33 risk 1: env-wake and env-sleep share one tag per environment, so they exclude each other, and env-wake
// never queues behind env-plan, env-apply, env-destroy or rotate-sql-passwords, which run it and wait for it under
// the default project-and-environment tag [VERIFY the tag applies to config-as-code runbook runs].
// System variable: https://octopus.com/docs/projects/variables/system-variables (Octopus.Task.ConcurrencyTag).
variable "Octopus.Task.ConcurrencyTag" {
    value "cluster-power/#{Octopus.Environment.Id}" {
        process = ["env-wake", "env-sleep"]
    }
}
