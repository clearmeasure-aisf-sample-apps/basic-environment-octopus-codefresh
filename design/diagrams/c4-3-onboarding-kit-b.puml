@startuml c4-3-onboarding-kit-b
!include include/c4-dynamic.puml
LAYOUT_LEFT_RIGHT()

title Level 3: Onboarding apply, from the merged pull request to a live app (ADR-IR34 decisions 11 and 12, docs/onboarding.md)

Person(operator, "Platform operator", "Applies in order after the merge; no second pull request")

Boundary(repo, "Environment repo, branch main") {
  ComponentDb(descriptor, "apps/<app>.yaml", "Descriptor", "The only input every consumer reads", $tags="github")
  ComponentDb(tenantChart, "gitops/platform/tenant/", "Helm chart, platform-owned", "Values values-<tier>.yaml plus the descriptor", $tags="argocd")
  ComponentDb(gitApp, "gitops/apps/<app>/", "App-owned", "envs/<env>/<deployable>/, envs/<env>/db/", $tags="argocd")
  ComponentDb(octApp, ".octopus/apps/<app>/<project>/", "App-owned OCL", "Process, variables, runbooks", $tags="octopus")
  ComponentDb(cfApp, "codefresh/apps/<app>/", "App-owned", "specs/*.yml, integrations.yaml", $tags="codefresh")
}

Component(appset, "ApplicationSet apps", "Argo CD argocd-<tier>, each cluster", "Git files generator over apps/*.yaml; create-update only", $tags="argocd")
Component(appsApply, "Runbook apps-apply", "Octopus platform-infrastructure, infra-<tier>", "terraform/apps/tier as id-platform-lifecycle-<tier>; state apps-<app>.tfstate", $tags="octopus")
Component(octoTf, "octopus/terraform", "Terraform, octopus/apply.sh, Space Manager", "One state octopus-space.tfstate for every app", $tags="octopus")
Component(register, "codefresh/register.sh --app <app>", "Bash, Codefresh API", "Creates or replaces by name; runtime <cf-runtime>", $tags="codefresh")
Component(grants, "terraform/apps/grants", "Terraform, the provisioner, operator session", "Only with Azure access; state app-grants-<app>.tfstate", $tags="azure")

Boundary(clusters, "App clusters aks-platform-nonprod and aks-platform-prod") {
  Component(tenant, "Application tenant-<app>", "Project platform-tenants", "AppProject app-<app>, namespaces <app>-<env>, quota, NetworkPolicies, stores, static PVs, signer policy, backups; Applications <app>-<deployable>-<env> and <app>-db-<env>", $tags="k8s")
}

Boundary(azure, "Azure, each tier") {
  ComponentDb(azureTier, "Per-app resources", "terraform/apps/tier", "Vaults kv-<app>-<e>-<hash4> with generated passwords, read by the tenant's stores; disks disk-<app>-<env>-db for its static PVs; backup containers; appi-<app>-<env>", $tags="azure")
  ComponentDb(azureGrants, "Azure access of the app", "terraform/apps/grants", "id-<app>-<env>-deploy and -app in rg-platform-<tier>-apps, their role assignments, rg-app-<app>-<tier>", $tags="azure")
}

Component(octoShells, "Octopus objects", "<octopus-space>", "Group app-<app>, project shells, channels, freeze scope, accounts azure-<app>-<env>", $tags="octopus")
Component(cfObjects, "Codefresh objects", "Codefresh account", "Project <app>, its pipelines from the specs, triggers with fork events off", $tags="codefresh")

Rel(operator, descriptor, "Merges the onboarding pull request")
Rel_Back(descriptor, appset, "Generates from", $tags="sync")
Rel_Back(tenantChart, appset, "Renders", $tags="sync")
Rel(appset, tenant, "Creates on each cluster", $tags="sync")
Rel_Back(gitApp, tenant, "Its Applications sync", $tags="sync")
Rel(operator, appsApply, "Runs per tier, App.Name=<app>")
Rel_Back(descriptor, appsApply, "Reads", $tags="release")
Rel(appsApply, azureTier, "Creates", $tags="release")
Rel(operator, octoTf, "Applies")
Rel_Back(descriptor, octoTf, "for_each over apps/*.yaml", $tags="release")
Rel(octoTf, octoShells, "Creates", $tags="release")
Rel_Back(octApp, octoShells, "Load the OCL", $tags="release")
Rel(operator, register, "Runs once the app repository exists")
Rel_Back(cfApp, register, "Reads", $tags="build")
Rel(register, cfObjects, "Creates or replaces", $tags="build")
Rel(operator, grants, "Azure access only; then 6 and 9 again")
Rel_Back(descriptor, grants, "Reads", $tags="identity")
Rel(grants, azureGrants, "Creates", $tags="identity")
Rel(operator, azureTier, "Replaces stand-in app secrets", $tags="identity")

SHOW_LEGEND()
@enduml
