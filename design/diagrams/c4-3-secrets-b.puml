@startuml c4-3-secrets-b
!include include/c4.puml
LAYOUT_TOP_DOWN()

title Level 3: platform secrets and pipeline secrets, names only (ADR-IR32, ADR-IR34 decisions 6 and 15, §7.0, §7.8)

Person(operator, "platform-operators", "Seeds and rotates the platform vault after env-apply")

Boundary(cf, "Codefresh account") {
  Component(cfContexts, "Secret contexts", "Names only", "platform-octopus: OCTOPUS_API_KEY; platform-registry: ACR_TOKEN_PASSWORD; platform-registry-retention; platform-conformance: AZURE_CLIENT_SECRET, GITHUB_TOKEN; app-<app>-ci", $tags="codefresh")
  Component(cfRegistry, "Registry integrations", "ACR tokens cf-*, 90 days", "acr-apps-release, acr-apps-preview, acr-platform-ci push; acr-platform-pull", $tags="codefresh")
}

Boundary(octo, "Octopus space <octopus-space>") {
  Component(octoVars, "Sensitive variables", "Names only", "Platform.OctopusApiKey (step-scoped), PlatformWake.OctopusApiKey, Octopus.WorkerRegistrationToken, GitHub.StatusAppPrivateKey", $tags="octopus")
  Component(octoGit, "Git credential", "Stored, restricted to the environment repo", "Config as code and pin commits; PinWriter.GitToken only for the fallback writer", $tags="octopus")
  Component(envApply, "env-apply: terraform/tier", "Runbook as id-platform-lifecycle-<tier>", "Creates the vault, writes no secret in it", $tags="octopus")
}

ComponentDb(kvPlatform, "<kv-platform-<tier>>", "Platform vault, rg-platform-<tier>-aks", "argocd-octopus-gateway-token, octopus-gateway-registration-token", $tags="azure")
Component(esoId, "id-eso-platform-<tier>", "Managed identity", "Key Vault Secrets User; workload identity federation", $tags="azure")

Boundary(cluster, "aks-platform-<tier>") {
  Component(store, "ClusterSecretStore platform-keyvault", "argocd/clusters/<tier>/platform-secrets.yaml", "Conditions admit argocd and octopus-argocd-gateway only", $tags="k8s")
  Component(eso, "ESO controller", "Namespace external-secrets", "Refresh 1 h", $tags="k8s")
  Boundary(argoNs, "Namespace argocd") {
    Component(argocd, "Argo CD argocd-<tier>", "Repo server", "Reads the public environment repo anonymously", $tags="argocd")
  }
  Boundary(gwNs, "Namespace octopus-argocd-gateway") {
    Component(gwSecrets, "Secrets argocd-octopus-token, octopus-gateway-registration", "ExternalSecrets", "Key token in each", $tags="k8s")
    Component(gateway, "Octopus Argo CD gateway", "Chart 2.1.0", "Registers with the Space Manager key; reads Argo CD as account octopus", $tags="octopus")
  }
}

System_Ext(repo, "Environment repo", "GitHub, public", $tags="github")
System_Ext(octopusApi, "Octopus Cloud API", "Space Manager key of AISF-Service-Account", $tags="octopus")
System_Ext(acr, "<acr-name>", "Registry; tokens from scope maps", $tags="azure")

Rel_D(operator, kvPlatform, "Seeds, rotates")
Rel_D(envApply, kvPlatform, "Creates", $tags="release")
Rel_R(eso, store, "Uses", $tags="identity")
Rel_U(store, esoId, "Authenticates as", $tags="identity")
Rel_L(esoId, kvPlatform, "Reads", $tags="identity")
Rel(eso, gwSecrets, "Syncs", $tags="identity")
Rel(argocd, repo, "Polls main, anonymous", $tags="sync")
Rel(gwSecrets, gateway, "Tokens")
Rel(gateway, octopusApi, "Outbound gRPC", $tags="release")
Rel(cfContexts, octopusApi, "Creates releases", $tags="build")
Rel(cfRegistry, acr, "Push and pull", $tags="build")
Rel(octoGit, repo, "Pin commits", $tags="release")

skinparam NoteTextAlignment left
note left of octopusApi
  **One key, four places** (ADR-IR32):
  context platform-octopus (Codefresh);
  octopus-gateway-registration-token (vault);
  Platform.OctopusApiKey and
  PlatformWake.OctopusApiKey (Octopus).
  Residual risk: ADR-IR34 decision 15.
end note

SHOW_LEGEND()
@enduml
