@startuml c4-3-secrets-a
!include include/c4.puml
LAYOUT_TOP_DOWN()

title Level 3: app secrets from generated passwords to pods (ADR-IR34 decisions 6 and 8, §7.0 Identities, §7.8)

Person(operator, "platform-operators", "Key Vault Secrets Officer: replaces stand-ins, rotates by hand")

Boundary(octo, "Octopus runbooks of platform-infrastructure, environment infra-<tier>") {
  Component(appsApply, "apps-apply: terraform/apps/tier", "Runbook as id-platform-lifecycle-<tier>", "Ephemeral random_password written as value_wo: never in plan or state", $tags="octopus")
  Component(rotate, "rotate-db-passwords", "Runbook, prompted App.Name", "Rotates <app>_migrator and <app>_app, then sa last", $tags="octopus")
}

Component(deployRead, "Step Read deployment secrets", "Project <app>, optional; app #1 in tdd", "Account azure-<app>-<env> (id-<app>-<env>-deploy); sensitive output variables", $tags="octopus")
ComponentDb(vault, "kv-<app>-<e>-<hash4>", "Key Vault per app-environment, rg-platform-<tier>-apps", "db-sa-password, db-migrator-password, db-app-password; descriptor secrets[]; appinsights-connection-string", $tags="azure")
Component(esoId, "id-eso-platform-<tier>", "Managed identity", "Key Vault Secrets User on -aks and -apps; subject system:serviceaccount:external-secrets:external-secrets", $tags="azure")

Boundary(cluster, "aks-platform-<tier>") {
  Component(eso, "ESO controller", "Namespace external-secrets", "Syncs every app vault of the tier; no identity in app namespaces", $tags="k8s")
  Component(store, "ClusterSecretStore <app>-<env>", "Tenant chart", "Conditions admit <app>-<env>, <app>-<part>-<env> and platform-backup", $tags="k8s")
  Component(appProject, "AppProject app-<app>", "Tenant chart", "Denies SecretStore and ClusterSecretStore kinds", $tags="argocd")
  Component(foreign, "Another app's namespace", "For example sandbox-tdd", "ExternalSecret naming store <app>-<env>", $tags="app")

  Boundary(ns, "Namespace <app>-<env>") {
    Component(dbEs, "ExternalSecrets db-sa, db-migrator, db-app", "Wave -1, refresh 1 h", "Secrets with host, port, database, username, password", $tags="k8s")
    Component(appEs, "ExternalSecret <app>-app", "App manifests, wave -1", "App keys; stand-in not-set-* maps to empty", $tags="k8s")
    Component(db, "StatefulSet db", "SQL Server 2022 Express", "sa password from db-sa", $tags="app")
    Component(dbInit, "Job db-init", "PostSync", "Sets the two login passwords as sa", $tags="app")
    Component(migrate, "Job db-migrate", "PreSync", "Login <app>_migrator", $tags="app")
    Component(pods, "Deployments", "ui-server, worker", "Login <app>_app; app keys", $tags="app")
  }
  Boundary(backupNs, "Namespace platform-backup") {
    Component(backupEs, "ExternalSecret db-sa-<app>-<env>", "Tenant chart, uat and prod", "sa password for the Jobs", $tags="k8s")
    Component(backupJobs, "CronJobs db-backup-, db-restore-<app>-<env>", "Tenant chart", "SA db-backup", $tags="k8s")
  }
}

Rel_D(appsApply, vault, "Writes generated passwords once", $tags="release")
Rel_D(operator, vault, "Replaces stand-ins")
Rel(deployRead, vault, "Reads db-app-password, AI key", $tags="identity")
Rel_D(rotate, vault, "New passwords", $tags="release")
Rel(rotate, db, "ALTER LOGIN in db-0, then forced ESO sync and restart", $tags="release")
Rel_R(eso, store, "Uses", $tags="identity")
Rel_U(store, esoId, "Authenticates as, workload identity federation", $tags="identity")
Rel_L(esoId, vault, "Reads", $tags="identity")
Rel_D(eso, dbEs, "Reconciles into Secrets", $tags="identity")
Rel_D(dbEs, db, "db-sa")
Rel_D(dbEs, dbInit, "All three")
Rel_D(dbEs, migrate, "db-migrator")
Rel_D(dbEs, pods, "db-app")
Rel_D(appEs, pods, "App keys")
Rel(backupEs, store, "secretStoreRef", $tags="identity")
Rel_D(backupEs, backupJobs, "sa password")
Rel(foreign, store, "Refused by the conditions", $tags="forbidden")
Rel(appProject, store, "No app creates or changes a store", $tags="forbidden")

Lay_R(vault, esoId)

SHOW_LEGEND()
@enduml
