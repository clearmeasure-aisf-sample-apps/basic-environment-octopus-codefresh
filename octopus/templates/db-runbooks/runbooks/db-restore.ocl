name = "db-restore"
description = "Restores the environment's database from a backup (the latest unless Restore.BackupName is set), after approval."
default_guided_failure_mode = "EnvironmentDefault"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "wake-environment" {
        name = "Wait for the cluster to wake"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["uat", "prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                    # Sleep/wake (ADR-IR33, ADR-IR34): this app project holds no platform key and no Azure right, and runbooks cannot run
                    # the Deploy a Release step [VERIFY, Q32], so this step cannot wake the cluster. It waits until the app answers (any
                    # HTTP status means the cluster runs), then names both ways to wake it. Task cap: this run holds one slot while it
                    # waits; a wake takes two more (platform-wake and env-wake).
                    $environment = [string]$OctopusParameters['Octopus.Environment.Name']
                    $baseUrl = [string]$OctopusParameters['App.BaseUrl']
                    $waitMinutes = [string]$OctopusParameters['Wake.WaitMinutes']
                    if ($waitMinutes -cnotmatch '\A[0-9]+\z') {
                        Fail-Step "Wake.WaitMinutes must be a whole number of minutes, not '$waitMinutes'."
                    }
                    $infra = switch -CaseSensitive ($environment) {
                        'tdd' { 'infra-nonprod' }
                        'uat' { 'infra-nonprod' }
                        'prod' { 'infra-prod' }
                        default { '' }
                    }
                    if (-not $infra) {
                        Fail-Step "No cluster mapping for environment $environment."
                    }
                    $guidance = "Wake it: deploy the latest platform-wake release to $environment, or run runbook env-wake of platform-infrastructure in $infra (SRE On-call), then run this runbook again."
                    $deadline = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + [long]$waitMinutes * 60
                    $warned = $false
                    while ($true) {
                        $PSNativeCommandUseErrorActionPreference = $false
                        curl --silent --output /dev/null --max-time 10 "$baseUrl/"
                        $answered = $LASTEXITCODE -eq 0
                        $PSNativeCommandUseErrorActionPreference = $true
                        if ($answered) {
                            break
                        }
                        if (-not $warned) {
                            Write-Warning "The cluster of $environment does not answer at $baseUrl (asleep?). Waiting up to $waitMinutes minutes. $guidance"
                            $warned = $true
                        }
                        $now = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
                        if ($now -ge $deadline) {
                            Fail-Step "The cluster of $environment did not answer at $baseUrl within $waitMinutes minutes. $guidance"
                        }
                        Start-Sleep -Seconds ([Math]::Min($deadline - $now, 30))
                    }
                    Write-Host "The cluster of $environment answers at $baseUrl."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
            }
        }
    }

    step "approve-restore" {
        name = "Approve database restore"

        action {
            action_type = "Octopus.Manual"
            is_required = true
            environments = ["uat", "prod"]
            properties = {
                Octopus.Action.Manual.BlockConcurrentDeployments = "True"
                Octopus.Action.Manual.Instructions = <<-EOT
                    ## Approve the database restore in #{Octopus.Environment.Name}
                    Backup: `#{if Restore.BackupName}#{Restore.BackupName}#{/if}#{unless Restore.BackupName}the latest backup#{/unless}`.
                    The restore replaces the whole database: rows written after that backup are lost. The restore Job closes other
                    sessions first, so the app sees errors for a moment and reconnects.
                    Hold deployments of this project to #{Octopus.Environment.Name} until the runbook finishes.
                    Abort leaves the database untouched.
                    EOT
                Octopus.Action.Manual.ResponsibleTeamIds = "release-managers,platform-engineers"
                Octopus.Action.RunOnServer = "false"
            }
        }
    }

    step "restore-database" {
        name = "Restore database"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool_variable = "Platform.WorkerPool"
            environments = ["uat", "prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                    # Restores the app database from a backup (ADR-IR34; CAP-AZ-010): a Job from the tenant chart's suspended CronJob
                    # db-restore-<app>-<env> in namespace platform-backup, with RESTORE_BLOB set to the prompted Restore.BackupName (empty:
                    # the newest backup; contract of gitops/platform/components/backup/mssql, restore.sh). Runs on k8s-<env> as
                    # service account octopus-worker-<env>-scripts, which needs create on jobs in platform-backup (see
                    # octopus/step-templates/db-backup.ps1).
                    $app = '__APP__'
                    $environment = [string]$OctopusParameters['Octopus.Environment.Name']
                    $backup = [string]$OctopusParameters['Restore.BackupName']
                    if ($environment -cnotin 'uat', 'prod') {
                        Fail-Step 'db-restore runs in uat and prod only; tdd databases are disposable.'
                    }
                    $gitRef = [string]$OctopusParameters['Octopus.RunbookRun.Git.Ref']
                    if ($environment -ceq 'prod' -and $gitRef -cne 'refs/heads/main') {
                        Fail-Step "Prod restores run only from refs/heads/main (this run: '$gitRef')."
                    }
                    if ($backup -and $backup -cnotmatch '^[A-Za-z0-9._/-]{1,200}$') {
                        Fail-Step "Restore.BackupName '$backup' is not a blob name."
                    }
                    if (-not (Get-Command kubectl -CommandType Application -ErrorAction SilentlyContinue)) {
                        Fail-Step 'kubectl is missing from the step container.'
                    }
                    $namespace = 'platform-backup'
                    $cronJob = "db-restore-$app-$environment"
                    $PSNativeCommandUseErrorActionPreference = $false
                    $null = kubectl --namespace $namespace get cronjob $cronJob --output name
                    $found = $LASTEXITCODE -eq 0
                    $PSNativeCommandUseErrorActionPreference = $true
                    if (-not $found) {
                        Fail-Step "CronJob $namespace/$cronJob was not found (the tenant chart renders it for uat and prod)."
                    }
                    $job = "$cronJob-" + [DateTime]::UtcNow.ToString('yyMMddHHmmss', [Globalization.CultureInfo]::InvariantCulture)
                    $null = kubectl --namespace $namespace create job $job "--from=cronjob/$cronJob" --dry-run=client --output yaml |
                        kubectl set env --local --filename - --output yaml "RESTORE_BLOB=$backup" |
                        kubectl --namespace $namespace create --filename -
                    $null = kubectl --namespace $namespace label job $job 'platform/trigger=db-restore' --overwrite
                    Write-Host "Restore Job $namespace/$job started (backup: $(if ($backup) { $backup } else { 'latest' }))."
                    $deadline = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + 3600
                    while ($true) {
                        $succeeded = (kubectl --namespace $namespace get job $job --output 'jsonpath={.status.succeeded}') -join "`n"
                        $failed = (kubectl --namespace $namespace get job $job --output 'jsonpath={.status.conditions[?(@.type=="Failed")].status}') -join "`n"
                        if ($succeeded -ceq '1') {
                            break
                        }
                        if ($failed -ceq 'True' -or [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -ge $deadline) {
                            $PSNativeCommandUseErrorActionPreference = $false
                            kubectl --namespace $namespace logs "job/$job" --tail=100 | Out-Host
                            $PSNativeCommandUseErrorActionPreference = $true
                            Fail-Step "Restore Job $namespace/$job failed or did not finish within 60 minutes."
                        }
                        Start-Sleep -Seconds 15
                    }
                    Set-OctopusVariable -name 'Restore.JobName' -value $job
                    Write-Highlight "Database of $app in $environment restored by Job $namespace/$job."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
            }
        }
    }

    step "verify-app" {
        name = "Verify app"

        action {
            action_type = "Octopus.Script"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["uat", "prod"]
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    Set-StrictMode -Version Latest
                    $ErrorActionPreference = 'Stop'
                    $PSNativeCommandArgumentPassing = 'Standard'
                    $PSNativeCommandUseErrorActionPreference = $true
                    $url = [string]$OctopusParameters['App.BaseUrl'] + [string]$OctopusParameters['App.HealthPath']
                    $deadline = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + 150
                    $code = ''
                    while ($true) {
                        # Status code: the second blank-separated field of the first header line.
                        $PSNativeCommandUseErrorActionPreference = $false
                        $headers = @(curl --silent --max-time 10 --output /dev/null --dump-header - $url)
                        $PSNativeCommandUseErrorActionPreference = $true
                        $fields = @(if ($headers.Count -gt 0) { ([string]$headers[0]).Trim([char[]]" `t") -split '[ \t]+' })
                        $code = if ($fields.Count -ge 2) { $fields[1] } else { '' }
                        if ($code -ceq '200') {
                            Write-Host "Smoke OK: $url returned 200."
                            break
                        }
                        if ([DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -ge $deadline) {
                            Fail-Step "Smoke test failed: $url returned '$code' for 150 s."
                        }
                        Start-Sleep -Seconds 10
                    }
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
            }
        }
    }
}
