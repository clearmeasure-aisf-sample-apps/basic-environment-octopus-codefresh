# Copy to terraform.tfvars (untracked) and replace every <placeholder>. No secret belongs in this file: the Space
# Manager key goes to the shell only, as TF_VAR_octopus_api_key (or OCTOPUS_APIKEY) for the provider and as
# TF_VAR_platform_octopus_api_key for PlatformWake.OctopusApiKey and the step-scoped Platform.OctopusApiKey. The
# GitHub token of runbook e2e-pass goes there too, as TF_VAR_e2e_github_token, on every run (octopus/apply.ps1), once it is
# managed here.
# Azure is read only (azure.tf): identity client IDs and the ingress IPs are looked up, never typed here.
# Where each value comes from: docs/preview-octopus.md ("P1-06 apply").

octopus_url        = "<OCTOPUS_URL>"
octopus_space_id   = "<octopus-space-id>"
octopus_space_slug = "<octopus-space-slug>"

azure_tenant_id       = "<AZURE_TENANT_ID>"
azure_subscription_id = "<AZURE_SUBSCRIPTION_ID>"

# terraform/foundation outputs: registry.login_server and tfstate.<tier>.storage_account_name.
acr_login_server = "<acr-name>.azurecr.io"
tier_state_storage_accounts = {
  nonprod = "<tfstate-storage-account-nonprod>"
  prod    = "<tfstate-storage-account-prod>"
}

# Custom app domains only (R35). Without an entry, a tier uses <ingress-ip-dashed-<tier>>.sslip.io once its ingress IP
# exists (ADR-IR34 decision 21).
# apps_domains = {}

# Defaults match §7.0; override only if the stored objects were renamed.
# env_repo_url                      = "https://github.com/clearmeasure-aisf-sample-apps/basic-environment-octopus-codefresh.git"
# stored_git_credential_name        = "GitHub clearmeasure-aisf-sample-apps"   # pin commits (Argo CD image-tag step)
# octopus_github_app_connection_id  = "GitHubAppConnections-41"                # project Git settings (R3, #42); "" = roll back to the stored credential
# stored_azure_account_name         = "Azure Runtime Provisioner"
# stored_library_variable_set_names = ["Azure Runtime Provisioning", "GitHub AISF Sample Apps"]

# CAP-OCT-001: releases deploy to tdd automatically.
# tdd_auto_deploy = true

# Platform Environment (ADR-IR34 decision 23). One operator: the creator may approve with a reason, and the automation
# user may answer interventions with a conformance:<run-id> or e2e:<run-id> reason.
# platform_sod_mode               = "single-operator"
# platform_intervention_test_mode = true

# Fallbacks, both [VERIFY] at P1-06 (docs/preview-octopus.md, checks V05 and V06):
# infrastructure_key_scope   = "steps"   # "unscoped" if Octopus rejects runbook and step slugs as scope values (Q26)
# env_sleep_triggers_managed = true      # false if the provider cannot create triggers for runbooks in Git (Q27)

# Membership through the identity provider (external groups) or Octopus user IDs. The automation user
# (aisf-service-account) is added to automation_user_teams by name.
team_external_groups = {}
team_member_user_ids = {}
# automation_user_teams = ["CI Release Publishers", "UAT Approvers", "Prod Approvers", "Platform Engineers"]

# First weekend window (UTC); repeats weekly on Saturday for every app project that deploys to prod.
prod_freeze_first_window = {
  start = "2026-10-03T00:00:00Z"
  end   = "2026-10-05T00:00:00Z"
}
