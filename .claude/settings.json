{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "mcp__github__get_file_contents",
      "Bash(git *)",
      "Bash(terraform *)",
      "Bash(pwsh *)",
      "Bash(python3 *)",
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(az *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(dotnet *)",
      "Bash(zcat *)"
    ]
  }
}
