# terraform/apps/tier, tier prod (environments prod).
#
# prod.tfvars next to this file is the committed copy that the Octopus runbooks apps-plan and apps-apply of
# platform-infrastructure pass in infra-prod (ADR-IR14): -var-file=prod.tfvars -var=app=#{App.Name}. Identifiers
# only, never a secret. The main loop replaces the <placeholders> at P1-09.
#
# Account azure-platform-lifecycle-prod (id-platform-lifecycle-prod, OIDC); backend key apps-<app>.tfstate in
# <tfstate-storage-account-prod>. No TF_VAR_* secret: generated passwords never leave Terraform's ephemeral values.
# The tier objects (log-platform-prod, ag-platform-oncall, aks-platform-prod) and the app identities are found by their
# §7.0 names.

tier            = "prod"
tenant_id       = "<AZURE_TENANT_ID>"
subscription_id = "<AZURE_SUBSCRIPTION_ID>"
location        = "<azure-region>"

# Created by the foundation in rg-platform-prod-shared; one container <app>-<env> per app-environment with a database.
backup_storage_account_name = "<backup-storage-account-prod>"

# §7.0 sizes of disk-<app>-<env>-db.
db_disk_size_gb = {
  tdd  = 8
  uat  = 8
  prod = 32
}

# Empty: the vault firewalls stay open and Entra RBAC decides.
key_vault_allowed_ip_ranges          = []
key_vault_soft_delete_retention_days = 90

# The SLO alerts go live in phase 3 (§9) for nonprod; prod alerts from the start.
slo_alerts_enabled = true

tags = {}
