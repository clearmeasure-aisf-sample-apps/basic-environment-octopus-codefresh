# Live, non-secret inputs of terraform/foundation (checked 2026-09-24). Copy to foundation.auto.tfvars
# (untracked) and replace the three <placeholders>; everything else is the real value. No secret belongs
# here: the provisioner's credentials come from ARM_CLIENT_ID, ARM_CLIENT_SECRET, ARM_TENANT_ID and
# ARM_SUBSCRIPTION_ID. Bootstrap and migration: versions.tf.

tenant_id       = "<AZURE_TENANT_ID>"
subscription_id = "<AZURE_SUBSCRIPTION_ID>"
location        = "southcentralus"

# Fixed for the life of the platform (variables.tf). Gives acrplatformi3aldz, sttfglobali3aldz,
# sttfnonprodi3aldz, sttfprodi3aldz, stbkpnonprodi3aldz and stbkpprodi3aldz. Change it only before the
# first apply, and only if Azure reports one of those names as taken.
name_suffix = "i3aldz"

# Octopus Cloud: the OIDC issuer (no trailing slash) and space Spaces-335 "AI Software Factory - Prototype".
octopus_url        = "https://clearmeasure.octopus.app"
octopus_space_slug = "ai-software-factory-prototype"

# Group platform-operators, created by the provisioner before the first apply (entra.tf):
#   az ad group create --display-name platform-operators --mail-nickname platform-operators --query id -o tsv
#   az ad group member add --group <that-id> --member-id <object-id-of-platform-operator>
# The user's object ID is createdBy of the RBAC Administrator grant the Owner script made:
#   az role assignment list --scope /subscriptions/<AZURE_SUBSCRIPTION_ID> --fill-principal-name false \
#     --role "Role Based Access Control Administrator" --query "[0].createdBy" --output tsv
platform_operators_group_object_id = "<object-id-of-platform-operators-group>"

# Null: the principal that runs Terraform, which is the provisioner sp-automation-mvp-sub.
provisioner_object_id = null

# true since P1-03 (2026-09-25): the changed Owner script ran and all three clusters exist.
conformance_least_privilege = true
# true once the three clusters exist (after P1-08): Reader on their node groups for sp-platform-conformance.
conformance_node_group_reader = true

# Null: created unless the subscription offer is unsupported by Cost Management (budgets.tf).
budgets_enabled = null
budget_amounts = {
  build   = 100
  nonprod = 110
  prod    = 60
}
budget_contact_emails = []

backup_retention_days = 30

tags = {}
